# What the FREE artifact does not carry.
#
# Applied by bin/build.sh to a staged copy of this tree, never to the tree
# itself. Two forms, the same two WSMS's build understands:
#
#   /anchored/path   removed from the root of the stage, and only from there
#   bare-name        removed wherever it appears, at any depth
#
# ============================================================================
# WHAT IS *NOT* HERE IS THE POINT: /resources.
# ============================================================================
# WSMS strips its /resources and its readme still says sources ship there.
# That is the trap ADR 0028 deletes rather than inherits: free's un-minified
# sources ship INSIDE the free ZIP, which is what makes the readme's source
# claim true by construction and what makes wp.org Guideline 4 compatible with
# Guideline 9. `resources/` is also runtime data — the rule manifest, the
# template library, the Playbooks — read by path constants in src/. Stripping
# it would break the plugin and break the claim in the same move.
#
# bin/verify-artifact-contract.sh asserts it is still there, so this file
# cannot quietly acquire the line later.

# Version control & CI
/.git
/.github
/.gitignore
/.distignore
# Node's version pin for contributors. Plugin Check rejects hidden files in a
# wp.org ZIP outright; readme.txt's build steps name the Node version instead.
/.nvmrc
# The wp.org listing assets (icon, banners, screenshots). They go to SVN's
# /assets directory, never into the plugin's own trunk.
/.wordpress-org

# The other plugin. Free contains no path under Pro's plugin directory
# (ADR 0029, check c); this is the line that makes that true, and
# verify-artifact-contract.sh is what proves it did.
/pro

# Build tooling and its output
/bin
/dist
/node_modules
# The design-system generator. It reads `resources/admin/src` and drives a
# throwaway WordPress; nothing in it is loaded by the plugin, and its own
# output directory is gitignored rather than staged.
/tools

# ============================================================================
# NO SOURCES AND NO BUILD FILES. THE REPOSITORY IS WHERE THEY LIVE.
# ============================================================================
# The ZIP carries the built bundles in public/ and the PHP, and readme.txt's
# "Source code" section points at the public repository, where
# `npm ci && npm run build` rebuilds them. The JavaScript sources, the Node and
# Composer manifests and every Vite config therefore stay out of the download.
#
# `resources/` is NOT stripped whole: playbooks, templates, rules, collections,
# the phone country list and the block's block.json are runtime data that
# src/ reads by path. Only the source directories under it go, one by one.
/resources/admin
/resources/loader
/resources/protection
/resources/renderer
/resources/phone/src
/resources/blocks/inline-optin/src
/composer.json
/composer.lock
/package.json
/package-lock.json
/tsconfig.json
/eslint.config.js
/vite.admin-config.mjs
/vite.loader-config.mjs
/vite.config.admin.mjs
/vite.config.block.mjs
/vite.config.loader.mjs
/vite.config.inspector.mjs
/vite.config.phone.mjs
/vite.config.protection.mjs
# Pro's build configs, named one by one rather than globbed, because
# .distignore's two forms are an anchored path and a bare name, and a bare
# `vite.*` would take anything under resources/ with it.
/vite.config.admin-pro.mjs
/vite.config.block-pro.mjs
/vite.config.analytics.mjs
/vite.config.commerce.mjs
/vite.config.revenue.mjs
/vite.config.loader-pro-basic.mjs
/vite.config.loader-pro-pro.mjs
/vite.config.loader-pro-elite.mjs
/vite.config.inspector-pro-basic.mjs
/vite.config.inspector-pro-pro.mjs
/vite.config.inspector-pro-elite.mjs
/vite.config.pro-tier.mjs
# shadcn's CLI configuration — read when a component is ADDED, never by the
# build. tiers.json stays: WConvert\Support\TierManifest reads it at runtime.
/components.json
# Another package manager's lockfiles.
/pnpm-lock.yaml
/pnpm-workspace.yaml

# Composer's own files. The runtime autoloader is packages/autoload.php
# (wp-scoper's, or bin/autoload-template.php's), so only Action Scheduler stays
# under vendor/ — it is a WordPress plugin library loaded by path, never
# prefixed, and version-negotiates with other copies on the site.
/vendor/autoload.php
/vendor/composer
/vendor/bin

# Action Scheduler's repository documentation. Composer installs the package
# whole; these are its contributor and agent notes, not code or licence.
# Its readme.txt, changelog.txt and license.txt stay.
/vendor/woocommerce/action-scheduler/AGENTS.md
/vendor/woocommerce/action-scheduler/CLAUDE.md
/vendor/woocommerce/action-scheduler/README.md
/vendor/woocommerce/action-scheduler/lib/cron-expression/README.md

# Tests and analysis
/tests
/phpunit.xml.dist
/.phpunit.cache
/.phpunit.result.cache
/phpstan.neon.dist
/phpstan-bootstrap.php
/phpstan-stubs
/vitest.config.ts

# Documentation and agent instructions. readme.txt is the plugin's
# documentation and stays.
/README.md
/CLAUDE.md
/CONTEXT.md
/docs
/.claude
# Contributor notes that sit beside shipped runtime data. Anchored, one by one:
# a bare `README.md` would reach every vendor package's too.
/resources/playbooks/README.md

# Editor and OS litter, at any depth
.DS_Store

/.superdesign
