parameters:
    level: 7
    phpVersion: 80100
    paths:
        - src
        - pro/src
        - bin
        - tests
    excludePaths:
        # Deliberately broken trees. Their whole job is to contain the leaks
        # bin/verify-source-contract.sh must catch, so analysing them would
        # report the fixtures' faults as the project's.
        - tests/fixtures/*
    scanFiles:
        # Action Scheduler is a bundled WordPress plugin rather than a PSR-4
        # library, so its `as_*()` functions are declared in a file nothing
        # autoloads (#4). Scanned rather than stubbed: the real signatures are
        # right there.
        - vendor/woocommerce/action-scheduler/functions.php
        # WooCommerce and WSMS, which WpSitePresence asks about and never
        # calls. See the header of the file itself.
        - phpstan-stubs/site-dependencies.php
    bootstrapFiles:
        - phpstan-bootstrap.php
        - pro/phpstan-bootstrap.php
    treatPhpDocTypesAsCertain: false
