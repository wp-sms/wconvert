{
  "id": "slide-in-photo",
  "name": "Corner card with a picture",
  "display_type": "slide_in",
  "tier": "pro",
  "tokens": {
    "bg": "#fffbf5",
    "fg": "#1c1917",
    "muted": "#78716c",
    "accent": "#b45309",
    "accent-fg": "#ffffff",
    "border": "#e7e5e4",
    "heading-size": "1.1875rem",
    "heading-weight": "700",
    "tracking": "-0.02em",
    "text-size": "0.9375rem",
    "leading": "1.5",
    "radius": "0.75rem",
    "pad": "1rem",
    "gap": "0.875rem",
    "width": "25rem",
    "align": "start",
    "shadow": "0 12px 32px rgba(28, 25, 23, 0.18)",
    "motion": "300ms"
  },
  "tree": {
    "steps": [
      {
        "type": "split",
        "ratio": 0.35,
        "start": [
          {
            "type": "image",
            "id": "n1",
            "src": "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%203%204'%3E%3Crect%20width='3'%20height='4'%20fill='%23e7e5e4'/%3E%3Ccircle%20cx='1.5'%20cy='1.5'%20r='.7'%20fill='%23fed7aa'/%3E%3Cpath%20d='M0%204l1.1-1.3.8.7L3.4%201.6%203%204z'%20fill='%23d6d3d1'/%3E%3C/svg%3E",
            "alt": "This week's bake, on a cooling rack",
            "fit": "cover"
          }
        ],
        "end": [
          {
            "type": "stack",
            "children": [
              { "type": "badge", "id": "n2", "role": "badge", "text": "Saturdays" },
              { "type": "heading", "id": "n3", "role": "headline", "text": "What we are baking this week" },
              { "type": "text", "id": "n4", "role": "body", "text": "One short note, every Friday morning." },
              {
                "type": "field",
                "id": "n5",
                "name": "email",
                "label": "Email address",
                "placeholder": "you@example.com",
                "required": true
              },
              { "type": "button", "id": "n6", "role": "cta_label", "label": "Send it to me", "action": "submit" },
              {
                "type": "consent",
                "id": "n7",
                "role": "consent_text",
                "hidden": true,
                "text": "Email me offers and news. See our %s.",
                "link": { "label": "Privacy Policy" }
              }
            ]
          }
        ]
      },
      {
        "type": "stack",
        "children": [
          { "type": "heading", "id": "n8", "role": "success_headline", "text": "Lovely — you are in" },
          { "type": "text", "id": "n9", "role": "success_body", "text": "The next note goes out on Friday." }
        ]
      }
    ]
  }
}
