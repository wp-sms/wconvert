{
  "id": "inline-code-strip",
  "name": "Strip that hands over a code",
  "display_type": "inline",
  "tier": "basic",
  "tokens": {
    "bg": "#eef2ff",
    "fg": "#1e1b4b",
    "muted": "#4f46e5",
    "accent": "#4338ca",
    "accent-fg": "#ffffff",
    "border": "#c7d2fe",
    "heading-size": "1.5rem",
    "heading-weight": "700",
    "radius": "0.75rem",
    "pad": "1.5rem",
    "gap": "0.75rem",
    "width": "100%",
    "align": "center",
    "shadow": "none",
    "tracking": "-0.02em",
    "text-size": "1rem",
    "input-bg": "#ffffff"
  },
  "tree": {
    "steps": [
      {
        "id": "s1",
        "name": "Details",
        "kind": "input",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "heading",
              "id": "n1",
              "role": "headline",
              "text": "A little welcome. 10% off."
            },
            {
              "type": "row",
              "children": [
                {
                  "type": "field",
                  "id": "n2",
                  "name": "email",
                  "label": "Email address",
                  "placeholder": "you@example.com",
                  "required": true,
                  "tokens": {
                    "border": "#5e7efc"
                  }
                },
                {
                  "type": "button",
                  "id": "n3",
                  "role": "cta_label",
                  "label": "Reveal the code",
                  "action": "submit",
                  "submission": "primary"
                }
              ]
            },
            {
              "type": "consent",
              "id": "n4",
              "role": "consent_text",
              "hidden": true,
              "text": "Email me offers and news. %s",
              "link": {
                "label": "Privacy Policy"
              },
              "tokens": {
                "text-size": "1.125rem"
              }
            },
            {
              "type": "text",
              "id": "n5",
              "role": "fine_print",
              "text": "First order only. One use per customer.",
              "size": "s",
              "tokens": {
                "text-size": "1.167rem"
              }
            }
          ]
        }
      },
      {
        "id": "s2",
        "name": "Received",
        "kind": "acknowledgement",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "heading",
              "id": "n6",
              "role": "success_headline",
              "text": "Here it is"
            },
            {
              "type": "code",
              "id": "n7",
              "role": "code_value",
              "text": "PAGE10",
              "copy": true
            },
            {
              "type": "text",
              "id": "n8",
              "role": "success_body",
              "text": "Enter it at the checkout."
            }
          ]
        }
      }
    ],
    "v": 2,
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n2"
        ],
        "consents": [
          "n4"
        ]
      }
    ]
  }
}
