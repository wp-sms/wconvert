{
  "id": "inline-code-strip",
  "name": "Strip that hands over a code",
  "display_type": "inline",
  "tier": "basic",
  "tokens": {
    "bg": "#eef2ff",
    "fg": "#1e1b4b",
    "muted": "#4f46e5",
    "accent": "#4338ca",
    "accent-fg": "#ffffff",
    "border": "#c7d2fe",
    "heading-size": "1.5rem",
    "heading-weight": "700",
    "radius": "0.75rem",
    "pad": "1.5rem",
    "gap": "0.75rem",
    "width": "100%",
    "align": "center",
    "shadow": "none",
    "tracking": "-0.02em"
  },
  "tree": {
    "steps": [
      {
        "type": "stack",
        "children": [
          {
            "type": "heading",
            "id": "n1",
            "role": "headline",
            "text": "Ten percent off, on this page only"
          },
          {
            "type": "row",
            "children": [
              {
                "type": "field",
                "id": "n2",
                "name": "email",
                "label": "Email address",
                "placeholder": "you@example.com",
                "required": true
              },
              {
                "type": "button",
                "id": "n3",
                "role": "cta_label",
                "label": "Reveal the code",
                "action": "submit"
              }
            ]
          },
          {
            "type": "consent",
            "id": "n4",
            "role": "consent_text",
            "hidden": true,
            "text": "Email me offers and news. See our %s.",
            "link": {
              "label": "Privacy Policy"
            }
          },
          {
            "type": "text",
            "id": "n5",
            "role": "fine_print",
            "text": "One use per customer."
          }
        ]
      },
      {
        "type": "stack",
        "children": [
          {
            "type": "heading",
            "id": "n6",
            "role": "success_headline",
            "text": "Here it is"
          },
          {
            "type": "code",
            "id": "n7",
            "role": "code_value",
            "text": "PAGE10"
          },
          {
            "type": "text",
            "id": "n8",
            "role": "success_body",
            "text": "Enter it at the checkout."
          }
        ]
      }
    ]
  }
}
