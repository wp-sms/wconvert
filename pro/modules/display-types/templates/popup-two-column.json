              "children": [
                {
                  "type": "image",
                  "id": "n1",
                  "src": "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20320%20190%22%3E%3Cellipse%20cx%3D%22160%22%20cy%3D%22166%22%20rx%3D%22105%22%20ry%3D%2210%22%20fill%3D%22%23d3dbcc%22%2F%3E%3Cpath%20d%3D%22M81%2061h111l13%20100H69z%22%20fill%3D%22%23d7b68e%22%2F%3E%3Cpath%20d%3D%22M107%2064V44a29%2029%200%200%201%2058%200v20%22%20fill%3D%22none%22%20stroke%3D%22%2399764f%22%20stroke-width%3D%229%22%2F%3E%3Cpath%20d%3D%22M81%2080h111M83%2091h109%22%20stroke%3D%22%23bea07b%22%20stroke-width%3D%222%22%2F%3E%3Crect%20x%3D%22211%22%20y%3D%2271%22%20width%3D%2237%22%20height%3D%2289%22%20rx%3D%2211%22%20fill%3D%22%23527760%22%2F%3E%3Crect%20x%3D%22219%22%20y%3D%2256%22%20width%3D%2221%22%20height%3D%2221%22%20rx%3D%224%22%20fill%3D%22%23294b36%22%2F%3E%3Cpath%20d%3D%22M219%2091h21v46h-21z%22%20fill%3D%22%23dfe7d8%22%2F%3E%3C%2Fsvg%3E",
                  "alt": "Illustration of a reusable tote and bottle",
                  "fit": "contain"
                },
                {
                  "type": "text",
                  "id": "n2",
                  "role": "body",
                  "text": "Everyday pieces, thoughtfully chosen."
                }
              ]
            }
          ],
          "end": [
            {
              "type": "panel",
              "tokens": {
                "pad": "1.75rem",
                "gap": "1rem",
                "radius": "0"
              },
              "narrow": {
                "pad": "1.25rem"
              },
              "children": [
                {
                  "type": "eyebrow",
                  "id": "n3",
                  "role": "eyebrow",
                  "text": "New here",
                  "tokens": {
                    "text-size": "1.0834rem"
                  }
                },
                {
                  "type": "heading",
                  "id": "n4",
                  "role": "headline",
                  "text": "A little welcome.\n10% off your first order.",
                  "narrow": {
                    "heading-size": "1.625rem"
                  }
                },
                {
                  "type": "text",
                  "id": "n5",
                  "role": "body",
                  "text": "Request the welcome offer by email."
                },
                {
                  "type": "field",
                  "id": "n6",
                  "name": "name",
                  "label": "First name (optional)",
                  "placeholder": "Your name",
                  "required": false,
                  "tokens": {
                    "radius": "0.375rem"
                  }
                },
                {
                  "type": "field",
                  "id": "n7",
                  "name": "email",
                  "label": "Email address",
                  "placeholder": "you@example.com",
                  "required": true,
                  "tokens": {
                    "radius": "0.375rem"
                  }
                },
                {
                  "type": "button",
                  "id": "n8",
                  "role": "cta_label",
                  "label": "Request my offer",
                  "action": "submit",
                  "submission": "primary",
                  "tokens": {
                    "radius": "0.375rem"
                  }
                },
                {
                  "type": "consent",
                  "id": "n9",
                  "role": "consent_text",
                  "hidden": true,
                  "text": "We use your details for this offer request. %s",
                  "link": {
                    "label": "Privacy Policy"
                  },
                  "tokens": {
                    "text-size": "1.125rem"
                  }
                },
                {
                  "type": "text",
                  "id": "n10",
                  "role": "fine_print",
                  "text": "For your first order. Offer terms apply.",
                  "size": "s",
                  "tokens": {
                    "text-size": "1.167rem"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "id": "s2",
        "name": "Received",
        "kind": "acknowledgement",
        "content": {
          "type": "panel",
          "children": [
            {
              "type": "icon",
              "id": "n13",
              "name": "check"
            },
            {
              "type": "heading",
              "id": "n11",
              "role": "success_headline",
              "text": "Request received"
            },
            {
              "type": "text",
              "id": "n12",
              "role": "success_body",
              "text": "Thank you for requesting the welcome offer."
            }
          ],
          "tokens": {
            "pad": "2rem",
            "gap": "1rem",
            "bg": "#e9eee3",
            "radius": "0"
          },
          "narrow": {
            "pad": "1.5rem"
          }
        }
      }
    ],
    "v": 2,
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n6",
          "n7"
        ],
        "consents": [
          "n9"
        ]
      }
    ]
  }
}
