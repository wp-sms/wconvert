  "tree": {
    "steps": [
      {
        "id": "s1",
        "name": "Details",
        "kind": "input",
        "content": {
          "type": "split",
          "basis": "16rem",
          "ratio": 0.5,
          "start": [
            {
              "type": "media",
              "tokens": {
                "bg": "#e9eee3",
                "pad": "1.5rem",
                "gap": "1rem",
                "radius": "0"
              },
              "narrow": {
                "pad": "1rem 1.25rem"
