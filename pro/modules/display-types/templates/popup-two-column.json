{
  "id": "popup-two-column",
  "name": "Two-column offer",
  "display_type": "popup",
  "tier": "basic",
  "tokens": {
    "bg": "#ffffff",
    "fg": "#173b2b",
    "muted": "#53655a",
    "accent": "#246443",
    "accent-fg": "#ffffff",
    "border": "#778d7e",
    "heading-size": "1.875rem",
    "heading-weight": "700",
    "tracking": "-0.025em",
    "text-size": "1rem",
    "leading": "1.5",
    "radius": "0.75rem",
    "pad": "0",
    "gap": "0",
    "width": "48rem",
    "align": "start",
    "shadow": "0 18px 50px -12px rgba(23, 59, 43, 0.25)",
    "motion": "200ms",
    "backdrop": "rgba(5, 46, 22, 0.6)"
