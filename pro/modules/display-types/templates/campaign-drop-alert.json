{
  "id": "campaign-drop-alert",
  "name": "Drop Alert",
  "display_type": "slide_in",
  "tier": "pro",
  "tokens": {
    "bg": "#101211",
    "fg": "#f4f4eb",
    "muted": "#f4f4eb",
    "accent": "#d9f86b",
    "accent-fg": "#181a12",
    "border": "#f4f4eb",
    "input-bg": "#101211",
    "placeholder": "fg",
    "font": "\"DM Sans\", Arial, sans-serif",
    "heading-font": "\"Bebas Neue\", Impact, sans-serif",
    "heading-size": "2.7rem",
    "heading-weight": "400",
    "heading-leading": ".95",
    "text-size": "1rem",
    "leading": "1.5",
    "tracking": "0",
    "pad": "2.75rem 0 0",
    "gap": "0",
    "radius": ".25rem",
    "width": "24rem",
    "motion": "0ms",
    "close-bg": "#171a1d",
    "close-fg": "#ffffff",
    "close-border": "#ffffff",
    "close-inset": ".5rem",
    "error-fg": "#ffffff",
    "error-bg": "#8f2020"
  },
  "tree": {
    "v": 2,
    "steps": [
      {
        "id": "offer",
        "name": "Offer",
        "kind": "input",
        "content": {
          "type": "panel",
          "children": [
            {
              "type": "eyebrow",
              "id": "n1",
              "role": "eyebrow",
              "text": "BLACK FRIDAY / SALE LAUNCH NOTIFICATION",
              "tokens": {
                "text-size": ".625rem",
                "tracking": ".12em"
              }
            },
            {
              "type": "text",
              "id": "n2",
              "role": "body",
              "text": "%b",
              "tokens": {
                "text-size": "7rem",
                "leading": ".95",
                "font": "\"Bebas Neue\", Impact, sans-serif"
              },
              "emphasis": "40%",
              "narrow": {
                "text-size": "4.5rem"
              }
            },
            {
              "type": "eyebrow",
              "id": "n3",
              "role": "eyebrow",
              "text": "UP TO / OFF SELECTED ITEMS",
              "tokens": {
                "text-size": ".625rem",
                "tracking": ".12em"
              }
            },
            {
              "type": "heading",
              "id": "n4",
              "role": "headline",
              "text": "GET THE\nDROP ALERT.",
              "narrow": {
                "heading-size": "2.65rem"
              }
            },
            {
              "type": "text",
              "id": "n5",
              "role": "body",
              "text": "Request access before the public sale opens."
            },
            {
              "type": "stack",
              "children": [
                {
                  "type": "field",
                  "id": "n6",
                  "name": "email",
                  "label": "Email address",
                  "placeholder": "you@example.com",
                  "required": true
                },
                {
                  "type": "consent",
                  "id": "n7",
                  "role": "consent_text",
                  "text": "Email me Black Friday offers. I can unsubscribe anytime.",
                  "hidden": true
                },
                {
                  "type": "button",
                  "id": "n8",
                  "role": "cta_label",
                  "label": "Get the drop alert",
                  "icon": "arrow",
                  "action": "submit",
                  "submission": "email-preview"
                }
              ],
              "tokens": {
                "gap": ".85rem"
              }
            },
            {
              "type": "text",
              "id": "n9",
              "role": "fine_print",
              "text": "Preview opens November 26. Up to 40% off selected items.",
              "tokens": {
                "text-size": ".875rem"
              }
            }
          ],
          "tokens": {
            "pad": "1.75rem",
            "gap": ".9rem"
          },
          "narrow": {
            "pad": "1.4rem"
          }
        }
      },
      {
        "id": "received",
        "name": "Request received",
        "kind": "acknowledgement",
        "content": {
          "type": "panel",
          "children": [
            {
              "type": "heading",
              "id": "n10",
              "role": "success_headline",
              "text": "Request received"
            },
            {
              "type": "text",
              "id": "n11",
              "role": "success_body",
              "text": "Thanks for requesting the Black Friday preview."
            },
            {
              "type": "text",
              "id": "n12",
              "role": "fine_print",
              "text": "You can close this window and continue browsing."
            }
          ],
          "tokens": {
            "pad": "2rem",
            "gap": ".9rem"
          },
          "narrow": {
            "pad": "1.4rem"
          }
        }
      }
    ],
    "submissions": [
      {
        "id": "email-preview",
        "required": true,
        "fields": [
          "n6"
        ],
        "consents": [
          "n7"
        ]
      }
    ],
    "fonts": [
      {
        "family": "DM Sans",
        "faces": [
          {
            "weight": 400,
            "italic": false
          },
          {
            "weight": 700,
            "italic": false
          }
        ]
      },
      {
        "family": "Bebas Neue",
        "faces": [
          {
            "weight": 400,
            "italic": false
          }
        ]
      },
      {
        "family": "Cormorant Garamond",
        "faces": [
          {
            "weight": 400,
            "italic": false
          }
        ]
      }
    ]
  }
}
