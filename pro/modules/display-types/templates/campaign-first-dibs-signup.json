                          "id": "n5",
                          "name": "email",
                          "label": "Email address",
                          "placeholder": "you@example.com",
                          "required": true
                        },
                        {
                          "type": "button",
                          "id": "n7",
                          "role": "cta_label",
                          "label": "Get first dibs",
                          "icon": "arrow",
                          "action": "submit",
                          "submission": "email-preview"
                        }
                      ],
                      "tokens": {
                        "gap": "1rem"
                      }
                    },
                    {
                      "type": "consent",
                      "id": "n6",
                      "role": "consent_text",
                      "text": "Email me Black Friday offers. I can unsubscribe anytime.",
                      "hidden": true
                    }
                  ],
                  "tokens": {
                    "gap": ".85rem"
                  }
                },
                {
                  "type": "text",
                  "id": "n8",
                  "role": "fine_print",
                  "text": "Preview opens November 26. Up to 40% off selected items.",
                  "tokens": {
                    "text-size": ".875rem"
                  }
                }
              ],
              "tokens": {
                "pad": "1.75rem 3rem 1.75rem 1.75rem",
                "gap": ".9rem"
              },
              "narrow": {
                "pad": "1.4rem"
              }
