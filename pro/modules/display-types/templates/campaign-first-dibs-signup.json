                    "text-size": ".625rem",
                    "tracking": ".12em"
                  }
                }
              ],
              "tokens": {
                "pad": "1.75rem",
                "gap": ".9rem",
                "bg": "accent",
                "fg": "accent-fg",
                "muted": "accent-fg",
                "align": "center"
