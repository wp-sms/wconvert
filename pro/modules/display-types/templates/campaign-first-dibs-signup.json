          "tokens": {
            "pad": "2rem",
            "gap": ".9rem"
          },
          "narrow": {
            "pad": "1.4rem"
          }
        }
      }
    ],
    "submissions": [
      {
        "id": "email-preview",
        "required": true,
        "fields": [
          "n5"
        ],
        "consents": [
          "n6"
        ]
