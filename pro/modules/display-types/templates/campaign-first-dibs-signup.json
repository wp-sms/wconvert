            "italic": false
          },
          {
            "weight": 700,
            "italic": false
          }
        ]
      },
      {
        "family": "Bebas Neue",
        "faces": [
          {
            "weight": 400,
            "italic": false
          }
        ]
      },
      {
        "family": "Cormorant Garamond",
        "faces": [
          {
            "weight": 400,
            "italic": false
          }
        ]
      }
    ]
