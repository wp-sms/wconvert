{
  "id": "slide-in-benefits",
  "name": "Corner card with reasons",
  "display_type": "slide_in",
  "tier": "basic",
  "tokens": {
    "width": "24rem",
    "align": "start",
    "motion": "200ms",
    "bg": "#ffffff",
    "fg": "#134e4a",
    "muted": "#3f7c76",
    "accent": "#0d9488",
    "accent-fg": "#ffffff",
    "border": "#ccfbf1",
    "heading-size": "1.3125rem",
    "heading-weight": "700",
    "radius": "0.75rem",
    "pad": "1.5rem",
    "gap": "0.875rem",
    "shadow": "0 18px 50px -12px rgba(15, 23, 42, 0.35)",
    "tracking": "-0.015em"
  },
  "tree": {
    "steps": [
      {
        "type": "stack",
        "children": [
          {
            "type": "heading",
            "id": "n1",
            "role": "headline",
            "text": "Three good reasons"
          },
          {
            "type": "stack",
            "children": [
              {
                "type": "row",
                "children": [
                  {
                    "type": "icon",
                    "id": "n2",
                    "name": "truck"
                  },
                  {
                    "type": "text",
                    "id": "n3",
                    "role": "body",
                    "text": "Free delivery"
                  }
                ]
              },
              {
                "type": "row",
                "children": [
                  {
                    "type": "icon",
                    "id": "n4",
                    "name": "clock"
                  },
                  {
                    "type": "text",
                    "id": "n5",
                    "role": "body",
                    "text": "Same-day dispatch"
                  }
                ]
              },
              {
                "type": "row",
                "children": [
                  {
                    "type": "icon",
                    "id": "n6",
                    "name": "check"
                  },
                  {
                    "type": "text",
                    "id": "n7",
                    "role": "body",
                    "text": "30-day returns"
                  }
                ]
              }
            ]
          },
          {
            "type": "divider",
            "id": "n8"
          },
          {
            "type": "field",
            "id": "n9",
            "name": "email",
            "label": "Email address",
            "placeholder": "you@example.com",
            "required": true
          },
          {
            "type": "button",
            "id": "n10",
            "role": "cta_label",
            "label": "Keep me posted",
            "action": "submit"
          },
          {
            "type": "consent",
            "id": "n11",
            "role": "consent_text",
            "hidden": true,
            "text": "Email me offers and news. See our %s.",
            "link": {
              "label": "Privacy Policy"
            }
          }
        ]
      },
      {
        "type": "stack",
        "children": [
          {
            "type": "icon",
            "id": "n14",
            "name": "check"
          },
          {
            "type": "heading",
            "id": "n12",
            "role": "success_headline",
            "text": "Thank you"
          },
          {
            "type": "text",
            "id": "n13",
            "role": "success_body",
            "text": "We will only write when it matters."
          }
        ]
      }
    ]
  }
}
