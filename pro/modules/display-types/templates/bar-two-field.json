{
  "id": "bar-two-field",
  "name": "Bar that asks twice",
  "display_type": "floating_bar",
  "tier": "basic",
  "tokens": {
    "heading-size": "1.0625rem",
    "heading-weight": "600",
    "text-size": "0.9375rem",
    "leading": "1.3",
    "pad": "0.75rem 1.25rem",
    "gap": "0.75rem",
    "width": "100%",
    "align": "start",
    "motion": "200ms",
    "bg": "#052e16",
    "fg": "#f0fdf4",
    "muted": "#86efac",
    "accent": "#22c55e",
    "accent-fg": "#052e16",
    "border": "#14532d",
    "radius": "0.25rem",
    "shadow": "0 -18px 50px -12px rgba(15, 23, 42, 0.35)",
    "tracking": "-0.01em"
  },
  "tree": {
    "steps": [
      {
        "type": "row",
        "children": [
          {
            "type": "heading",
            "id": "n1",
            "role": "headline",
            "level": 2,
            "text": "First to know, every Friday"
          },
          {
            "type": "field",
            "id": "n2",
            "name": "name",
            "label": "First name",
            "placeholder": "Alex",
            "required": false
          },
          {
            "type": "field",
            "id": "n3",
            "name": "email",
            "label": "Email address",
            "placeholder": "you@example.com",
            "required": true
          },
          {
            "type": "button",
            "id": "n4",
            "role": "cta_label",
            "label": "Join",
            "action": "submit"
          },
          {
            "type": "consent",
            "id": "n5",
            "role": "consent_text",
            "hidden": true,
            "text": "Email me offers and news. See our %s.",
            "link": {
              "label": "Privacy Policy"
            }
          }
        ]
      },
      {
        "type": "row",
        "children": [
          {
            "type": "heading",
            "id": "n6",
            "role": "success_headline",
            "level": 2,
            "text": "You are on the list"
          },
          {
            "type": "text",
            "id": "n7",
            "role": "success_body",
            "text": "Friday is the next one."
          }
        ]
      }
    ]
  }
}
