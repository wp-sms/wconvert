{
  "id": "slide-in-photo",
  "name": "Corner card with a picture",
  "display_type": "slide_in",
  "tier": "basic",
  "tokens": {
    "bg": "#f4f0e9",
    "fg": "#343f40",
    "muted": "#343f40",
    "accent": "#35535a",
    "accent-fg": "#ffffff",
    "border": "#cec8bd",
    "input-bg": "#ffffff",
    "heading-font": "Georgia, serif",
    "heading-weight": "400",
    "heading-size": "2rem",
    "text-size": "1rem",
    "tracking": "-0.035em",
    "leading": "1.5",
    "pad": "1.75rem",
    "gap": "1rem",
    "radius": "0.75rem",
    "width": "25rem",
    "shadow": "0 24px 64px -20px rgba(20,30,25,.3)"
  },
  "tree": {
    "steps": [
      {
        "id": "s1",
        "name": "Details",
        "kind": "input",
        "content": {
          "type": "split",
          "ratio": 0.35,
          "start": [
            {
              "type": "image",
              "id": "n1",
              "src": "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20500%20480%22%3E%3Crect%20width%3D%22500%22%20height%3D%22480%22%20fill%3D%22%23e7e6da%22%2F%3E%3Cpath%20d%3D%22M65%20400V185a185%20185%200%200%201%20370%200v215%22%20fill%3D%22%23c3c9b3%22%2F%3E%3Cellipse%20cx%3D%22250%22%20cy%3D%22420%22%20rx%3D%22162%22%20ry%3D%2218%22%20fill%3D%22%23a6ad91%22%2F%3E%3Cpath%20d%3D%22M155%20280h160l-22%20125H177z%22%20fill%3D%22%23af6348%22%2F%3E%3Cpath%20d%3D%22M230%20289V94%22%20stroke%3D%22%23465c40%22%20stroke-width%3D%2210%22%2F%3E%3Cpath%20d%3D%22M230%20242C107%20258%20100%20137%20230%20208M231%20173C331%20167%20338%2063%20231%20143M229%20123C136%20113%20146%2038%20229%2096%22%20fill%3D%22%234b6844%22%2F%3E%3Cpath%20d%3D%22M337%20324h58l-8%2080h-42z%22%20fill%3D%22%23f7f1df%22%2F%3E%3Ccircle%20cx%3D%22366%22%20cy%3D%22305%22%20r%3D%2235%22%20fill%3D%22%23d0a259%22%2F%3E%3C%2Fsvg%3E",
              "alt": "Original illustration of a leafy plant in a terracotta pot",
              "fit": "cover"
            }
          ],
          "end": [
            {
              "type": "stack",
              "children": [
                {
                  "type": "badge",
                  "id": "n2",
                  "role": "badge",
                  "text": "Friday notes",
                  "tokens": {
                    "text-size": "1.0834rem"
                  }
                },
                {
                  "type": "heading",
                  "id": "n3",
                  "role": "headline",
                  "text": "What we are baking this week"
                },
                {
                  "type": "text",
                  "id": "n4",
                  "role": "body",
                  "text": "One short note, every Friday morning."
                },
                {
                  "type": "field",
                  "id": "n5",
                  "name": "email",
                  "label": "Email address",
                  "placeholder": "you@example.com",
                  "required": true
                },
                {
                  "type": "button",
                  "id": "n6",
                  "role": "cta_label",
                  "label": "Send me the bakery note",
                  "action": "submit",
                  "submission": "primary"
                },
                {
                  "type": "consent",
                  "id": "n7",
                  "role": "consent_text",
                  "hidden": true,
                  "text": "Email me offers and news. %s",
                  "link": {
                    "label": "Privacy Policy"
                  },
                  "tokens": {
                    "text-size": "1.125rem"
                  }
                }
              ]
            }
          ],
          "basis": "16rem"
        }
      },
      {
        "id": "s2",
        "name": "Received",
        "kind": "acknowledgement",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "icon",
              "id": "n10",
              "name": "check"
            },
            {
              "type": "heading",
              "id": "n8",
              "role": "success_headline",
              "text": "Lovely, thank you"
            },
            {
              "type": "text",
              "id": "n9",
              "role": "success_body",
              "text": "We have received your request for the next note."
            }
          ]
        }
      }
    ],
    "v": 2,
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n5"
        ],
        "consents": [
          "n7"
        ]
      }
    ]
  }
}
