{
  "id": "slide-in-photo",
  "name": "Corner card with a picture",
  "display_type": "slide_in",
  "tier": "basic",
  "tokens": {
    "bg": "#f4f0e9",
    "fg": "#343f40",
    "muted": "#343f40",
    "accent": "#35535a",
    "accent-fg": "#ffffff",
    "border": "#cec8bd",
    "input-bg": "#ffffff",
    "heading-font": "Georgia, serif",
    "heading-weight": "400",
    "heading-size": "1.625rem",
    "text-size": "1rem",
    "tracking": "-0.035em",
    "leading": "1.5",
    "pad": "1.25rem",
    "gap": ".875rem",
    "radius": "0.75rem",
    "width": "25rem",
    "shadow": "0 24px 64px -20px rgba(20,30,25,.3)"
  },
  "tree": {
    "steps": [
      {
        "id": "s1",
        "name": "Details",
        "kind": "input",
        "content": {
          "type": "split",
          "ratio": 0.35,
          "start": [
            {
              "type": "image",
              "id": "n1",
              "src": "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20320%20110%22%3E%3Crect%20width%3D%22320%22%20height%3D%22110%22%20rx%3D%2210%22%20fill%3D%22%23e4e7df%22%2F%3E%3Cpath%20d%3D%22M85%2038h150v54H85z%22%20fill%3D%22%23c9baa2%22%2F%3E%3Cpath%20d%3D%22M85%2038l75%2043%2075-43%22%20fill%3D%22%23e4d6bf%22%2F%3E%3Crect%20x%3D%22116%22%20y%3D%2214%22%20width%3D%2288%22%20height%3D%2253%22%20rx%3D%223%22%20fill%3D%22%23fffdf5%22%2F%3E%3Cpath%20d%3D%22M132%2030h54m-54%2013h40m-40%2012h47%22%20stroke%3D%22%236a7773%22%20stroke-width%3D%223%22%2F%3E%3C%2Fsvg%3E",
              "alt": "Original illustration of a short note and envelope",
              "fit": "cover"
            }
          ],
          "end": [
            {
              "type": "stack",
              "children": [
                {
                  "type": "badge",
                  "id": "n2",
                  "role": "badge",
                  "text": "Friday notes",
                  "tokens": {
                    "text-size": "1.0834rem"
                  }
                },
                {
                  "type": "heading",
                  "id": "n3",
                  "role": "headline",
                  "text": "What we are baking this week"
                },
                {
                  "type": "text",
                  "id": "n4",
                  "role": "body",
                  "text": "One short note, every Friday morning."
                },
                {
                  "type": "field",
                  "id": "n5",
                  "name": "email",
                  "label": "Email address",
                  "placeholder": "you@example.com",
                  "required": true,
                  "tokens": {
                    "border": "#91836b"
                  }
                },
                {
                  "type": "button",
                  "id": "n6",
                  "role": "cta_label",
                  "label": "Send me the bakery note",
                  "action": "submit",
                  "submission": "primary"
                },
                {
                  "type": "consent",
                  "id": "n7",
                  "role": "consent_text",
                  "hidden": true,
                  "text": "Email me the weekly bakery note. %s",
                  "link": {
                    "label": "Privacy Policy"
                  },
                  "tokens": {
                    "text-size": "1.125rem"
                  }
                }
              ]
            }
          ],
          "basis": "16rem"
        }
      },
      {
        "id": "s2",
        "name": "Received",
        "kind": "acknowledgement",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "icon",
              "id": "n10",
              "name": "check"
            },
            {
              "type": "heading",
              "id": "n8",
              "role": "success_headline",
              "text": "Lovely, thank you"
            },
            {
              "type": "text",
              "id": "n9",
              "role": "success_body",
              "text": "We have received your request for the next note."
            }
          ]
        }
      }
    ],
    "v": 2,
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n5"
        ],
        "consents": [
          "n7"
        ]
      }
    ]
  }
}
