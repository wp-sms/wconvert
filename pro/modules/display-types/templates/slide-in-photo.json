{
  "id": "slide-in-photo",
  "name": "Corner card with a picture",
  "display_type": "slide_in",
  "tier": "basic",
  "tokens": {
    "bg": "#fffbf5",
    "fg": "#1c1917",
    "muted": "#78716c",
    "accent": "#b45309",
    "accent-fg": "#ffffff",
    "border": "#e7e5e4",
    "heading-size": "1.3125rem",
    "heading-weight": "700",
    "tracking": "-0.02em",
    "text-size": "1rem",
    "leading": "1.5",
    "radius": "0.75rem",
    "pad": "1rem",
    "gap": "0.875rem",
    "width": "25rem",
    "align": "start",
    "shadow": "0 18px 50px -12px rgba(15, 23, 42, 0.35)",
    "motion": "300ms",
    "input-bg": "#ffffff"
  },
  "tree": {
    "steps": [
      {
        "id": "s1",
        "name": "Details",
        "kind": "input",
        "content": {
          "type": "split",
          "ratio": 0.35,
          "start": [
            {
              "type": "image",
              "id": "n1",
              "src": "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%203%201.5'%3E%3Cdefs%3E%3ClinearGradient%20id='g'%20x1='0'%20y1='0'%20x2='1'%20y2='1'%3E%3Cstop%20offset='0'%20stop-color='%237f1d1d'/%3E%3Cstop%20offset='.5'%20stop-color='%23c2410c'/%3E%3Cstop%20offset='1'%20stop-color='%23f59e0b'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width='3'%20height='4'%20fill='url%28%23g%29'/%3E%3Ccircle%20cx='2.1'%20cy='1.0'%20r='0.7'%20fill='%23fde68a'%20opacity='.55'/%3E%3Ccircle%20cx='0.7'%20cy='2.9'%20r='0.95'%20fill='%23fb923c'%20opacity='.6'/%3E%3C/svg%3E",
              "alt": "Image placeholder",
              "fit": "cover"
            }
          ],
          "end": [
            {
              "type": "stack",
              "children": [
                {
                  "type": "badge",
                  "id": "n2",
                  "role": "badge",
                  "text": "Friday notes",
                  "tokens": {
                    "text-size": "1.0834rem"
                  }
                },
                {
                  "type": "heading",
                  "id": "n3",
                  "role": "headline",
                  "text": "What we are baking this week"
                },
                {
                  "type": "text",
                  "id": "n4",
                  "role": "body",
                  "text": "One short note, every Friday morning."
                },
                {
                  "type": "field",
                  "id": "n5",
                  "name": "email",
                  "label": "Email address",
                  "placeholder": "you@example.com",
                  "required": true
                },
                {
                  "type": "button",
                  "id": "n6",
                  "role": "cta_label",
                  "label": "Send me the bakery note",
                  "action": "submit",
                  "submission": "primary"
                },
                {
                  "type": "consent",
                  "id": "n7",
                  "role": "consent_text",
                  "hidden": true,
                  "text": "Email me offers and news. %s",
                  "link": {
                    "label": "Privacy Policy"
                  },
                  "tokens": {
                    "text-size": "1.125rem"
                  }
                }
              ]
            }
          ],
          "basis": "16rem"
        }
      },
      {
        "id": "s2",
        "name": "Received",
        "kind": "acknowledgement",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "icon",
              "id": "n10",
              "name": "check"
            },
            {
              "type": "heading",
              "id": "n8",
              "role": "success_headline",
              "text": "Lovely, thank you"
            },
            {
              "type": "text",
              "id": "n9",
              "role": "success_body",
              "text": "We have received your request for the next note."
            }
          ]
        }
      }
    ],
    "v": 2,
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n5"
        ],
        "consents": [
          "n7"
        ]
      }
    ]
  }
}
