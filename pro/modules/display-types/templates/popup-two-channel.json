{
  "id": "popup-two-channel",
  "name": "Email and phone",
  "display_type": "popup",
  "tier": "basic",
  "tokens": {
    "bg": "#ffffff",
    "fg": "#18181b",
    "muted": "#71717a",
    "accent": "#7c3aed",
    "accent-fg": "#ffffff",
    "border": "#e4e4e7",
    "heading-size": "1.875rem",
    "heading-weight": "700",
    "radius": "0.875rem",
    "pad": "2.5rem",
    "gap": "0.875rem",
    "width": "29rem",
    "align": "start",
    "backdrop": "rgba(24, 24, 27, 0.6)",
    "shadow": "0 32px 80px -16px rgba(15, 23, 42, 0.5)",
    "tracking": "-0.025em"
  },
  "tree": {
    "steps": [
      {
        "type": "stack",
        "children": [
          {
            "type": "badge",
            "id": "n1",
            "role": "badge",
            "place": "corner",
            "text": "VIP"
          },
          {
            "type": "heading",
            "id": "n2",
            "role": "headline",
            "text": "First refusal, both ways"
          },
          {
            "type": "text",
            "id": "n3",
            "role": "body",
            "text": "We email the list on Monday and text it the morning a run goes live."
          },
          {
            "type": "field",
            "id": "n4",
            "name": "email",
            "label": "Email address",
            "placeholder": "you@example.com",
            "required": true
          },
          {
            "type": "field",
            "id": "n5",
            "name": "phone",
            "label": "Mobile number",
            "placeholder": "+44 7700 900000",
            "required": false
          },
          {
            "type": "button",
            "id": "n6",
            "role": "cta_label",
            "label": "Sign me up",
            "action": "submit"
          },
          {
            "type": "consent",
            "id": "n7",
            "role": "consent_text",
            "hidden": true,
            "text": "Email me offers and news. See our %s.",
            "link": {
              "label": "Privacy Policy"
            }
          },
          {
            "type": "text",
            "id": "n8",
            "role": "fine_print",
            "text": "The number is optional. Reply STOP to leave at any time."
          }
        ]
      },
      {
        "type": "stack",
        "children": [
          {
            "type": "icon",
            "id": "n11",
            "name": "check"
          },
          {
            "type": "heading",
            "id": "n9",
            "role": "success_headline",
            "text": "Thank you"
          },
          {
            "type": "text",
            "id": "n10",
            "role": "success_body",
            "text": "We have received your request for email and text updates."
          }
        ]
      }
    ]
  }
}
