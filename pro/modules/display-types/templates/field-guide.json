  "tier": "pro",
  "tokens": {
    "bg": "#e9e1c9",
    "fg": "#25301f",
    "muted": "#4e5a45",
    "accent": "#3f5c35",
    "accent-fg": "#f8f5ec",
    "border": "#7f8a72",
