  "tree": {
    "v": 2,
    "steps": [
      {
        "id": "s1",
        "name": "Details",
        "kind": "input",
        "content": {
          "type": "split",
          "ratio": 0.5,
          "basis": "16rem",
          "narrow": {
            "gap": "0.75rem"
          },
          "start": [
            {
              "type": "image",
              "id": "n1",
              "src": "artwork:faaa69ad2fe2c84b0c4695b23d85c0e68d62180c75aeb7722640021ce61c4eeb.webp",
              "alt": "Botanical watercolour of a foxglove with a seed head and a fern frond",
              "fit": "cover"
            }
          ],
          "end": [
            {
              "type": "panel",
              "tokens": {
                "bg": "input-bg",
                "pad": "2.75rem",
                "gap": "1.5rem"
              },
              "narrow": {
                "pad": "1.75rem 1.375rem",
                "heading-size": "2.125rem"
              },
              "children": [
                {
                  "type": "stack",
                  "tokens": {
                    "gap": "0.625rem",
                    "text-size": "1.1667rem"
                  },
                  "children": [
                    {
                      "type": "eyebrow",
                      "id": "n2",
                      "role": "eyebrow",
                      "text": "Monthly planting notes"
                    },
                    {
                      "type": "heading",
                      "id": "n3",
                      "level": 1,
                      "role": "headline",
                      "text": "What to sow\nthis month."
                    }
                  ]
                },
                {
                  "type": "divider",
                  "id": "n4"
                },
                {
                  "type": "text",
                  "id": "n5",
                  "role": "body",
                  "text": "One short letter at the start of each month: what to sow, what to cut back and what to leave alone."
                },
                {
                  "type": "stack",
                  "tokens": {
                    "gap": "0.625rem"
                  },
                  "children": [
                    {
                      "type": "field",
                      "id": "n6",
                      "name": "email",
                      "label": "Email address",
                      "placeholder": "you@example.com",
                      "required": true,
                      "tokens": {
                        "radius": "0.75rem"
                      }
                    },
                    {
                      "type": "button",
                      "id": "n7",
                      "role": "cta_label",
                      "label": "Send me the planting notes",
                      "action": "submit",
                      "submission": "primary",
                      "tokens": {
                        "radius": "999px"
                      }
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "n8",
                  "role": "fine_print",
                  "size": "s",
                  "text": "One letter a month. Unsubscribe whenever you like.",
                  "tokens": {
                    "fg": "muted"
                  }
                },
                {
                  "type": "consent",
                  "id": "n9",
                  "role": "consent_text",
                  "hidden": true,
                  "text": "Email me the monthly planting notes. %s",
                  "link": {
                    "label": "Privacy Policy"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "id": "s2",
        "name": "Received",
        "kind": "acknowledgement",
        "content": {
          "type": "split",
          "ratio": 0.5,
          "basis": "16rem",
          "narrow": {
            "gap": "0.75rem"
          },
          "start": [
            {
              "type": "image",
              "id": "n10",
              "src": "artwork:faaa69ad2fe2c84b0c4695b23d85c0e68d62180c75aeb7722640021ce61c4eeb.webp",
              "alt": "Botanical watercolour of a foxglove with a seed head and a fern frond",
              "fit": "cover"
            }
          ],
          "end": [
            {
              "type": "media",
              "tokens": {
                "bg": "input-bg",
                "pad": "2.75rem",
                "gap": "1.5rem"
              },
              "narrow": {
                "pad": "1.75rem 1.375rem",
                "heading-size": "2.125rem"
              },
              "children": [
                {
                  "type": "stack",
                  "tokens": {
                    "gap": "0.875rem"
                  },
                  "children": [
                    {
                      "type": "icon",
                      "id": "n11",
                      "name": "check"
                    },
                    {
                      "type": "heading",
                      "id": "n12",
                      "level": 1,
                      "role": "success_headline",
                      "text": "Request received."
                    }
                  ]
                },
                {
                  "type": "stack",
                  "tokens": {
                    "gap": "1.25rem"
                  },
                  "children": [
                    {
                      "type": "divider",
                      "id": "n13"
                    },
                    {
                      "type": "text",
                      "id": "n14",
                      "role": "success_body",
                      "text": "Thank you for asking for\nthe monthly planting notes."
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ],
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n6"
        ],
        "consents": [
          "n9"
        ]
      }
    ]
