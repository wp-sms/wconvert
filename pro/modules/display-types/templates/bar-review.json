{
  "id": "bar-review",
  "name": "Bar with the stars",
  "display_type": "floating_bar",
  "tier": "basic",
  "tokens": {
    "heading-size": "1rem",
    "heading-weight": "600",
    "text-size": "0.9375rem",
    "leading": "1.3",
    "pad": "0.75rem 1.25rem",
    "gap": "0.75rem",
    "width": "100%",
    "align": "start",
    "motion": "200ms",
    "bg": "#ffffff",
    "fg": "#0f172a",
    "muted": "#64748b",
    "accent": "#0f172a",
    "accent-fg": "#ffffff",
    "border": "#e2e8f0",
    "radius": "2rem",
    "shadow": "0 -6px 24px rgba(15, 23, 42, 0.12)"
  },
  "tree": {
    "steps": [
      {
        "type": "row",
        "children": [
          {
            "type": "rating",
            "id": "n1",
            "value": 5,
            "role": "rating_text",
            "text": "2,400 reviews"
          },
          {
            "type": "heading",
            "id": "n2",
            "role": "headline",
            "level": 2,
            "text": "Rated five stars by people who bought it"
          },
          {
            "type": "button",
            "id": "n3",
            "role": "cta_label",
            "label": "Read the reviews",
            "action": "link"
          }
        ]
      }
    ]
  }
}
