{
  "id": "slide-in-code",
  "name": "Corner card with a code",
  "display_type": "slide_in",
  "tier": "basic",
  "tokens": {
    "width": "24rem",
    "align": "start",
    "motion": "200ms",
    "bg": "#fffbeb",
    "fg": "#1c1917",
    "muted": "#78716c",
    "accent": "#b45309",
    "accent-fg": "#ffffff",
    "border": "#fde68a",
    "heading-size": "1.25rem",
    "heading-weight": "700",
    "radius": "1rem",
    "pad": "1.5rem",
    "gap": "0.75rem",
    "shadow": "0 24px 64px rgba(28, 25, 23, 0.25)"
  },
  "tree": {
    "steps": [
      {
        "type": "stack",
        "children": [
          {
            "type": "eyebrow",
            "id": "n1",
            "role": "eyebrow",
            "text": "While you are here"
          },
          {
            "type": "heading",
            "id": "n2",
            "role": "headline",
            "text": "Ten percent off"
          },
          {
            "type": "text",
            "id": "n3",
            "role": "body",
            "text": "Tell us where to send it."
          },
          {
            "type": "field",
            "id": "n4",
            "name": "email",
            "label": "Email address",
            "placeholder": "you@example.com",
            "required": true
          },
          {
            "type": "button",
            "id": "n5",
            "role": "cta_label",
            "label": "Send my code",
            "action": "submit"
          },
          {
            "type": "consent",
            "id": "n6",
            "role": "consent_text",
            "hidden": true,
            "text": "Email me offers and news. See our %s.",
            "link": {
              "label": "Privacy Policy"
            }
          }
        ]
      },
      {
        "type": "stack",
        "children": [
          {
            "type": "heading",
            "id": "n7",
            "role": "success_headline",
            "text": "All yours"
          },
          {
            "type": "code",
            "id": "n8",
            "role": "code_value",
            "text": "WELCOME10"
          },
          {
            "type": "text",
            "id": "n9",
            "role": "success_body",
            "text": "It is in your inbox too."
          }
        ]
      }
    ]
  }
}
