{
  "id": "bar-code",
  "name": "Bar that hands over a code",
  "display_type": "floating_bar",
  "tier": "basic",
  "tokens": {
    "heading-size": "1.0625rem",
    "heading-weight": "600",
    "text-size": "0.9375rem",
    "leading": "1.3",
    "pad": "0.75rem 1.25rem",
    "gap": "0.75rem",
    "width": "100%",
    "align": "start",
    "motion": "200ms",
    "bg": "#1e1b4b",
    "fg": "#eef2ff",
    "muted": "#a5b4fc",
    "accent": "#facc15",
    "accent-fg": "#1e1b4b",
    "border": "#4f4aa8",
    "radius": "0.375rem",
    "shadow": "0 -18px 50px -12px rgba(15, 23, 42, 0.35)",
    "tracking": "-0.01em"
  },
  "tree": {
    "steps": [
      {
        "type": "row",
        "children": [
          {
            "type": "icon",
            "id": "n1",
            "name": "gift"
          },
          {
            "type": "heading",
            "id": "n2",
            "role": "headline",
            "level": 2,
            "text": "Ten percent off your first order"
          },
          {
            "type": "field",
            "id": "n3",
            "name": "email",
            "label": "Email address",
            "placeholder": "you@example.com",
            "required": true
          },
          {
            "type": "button",
            "id": "n4",
            "role": "cta_label",
            "label": "Get my code",
            "action": "submit"
          },
          {
            "type": "consent",
            "id": "n5",
            "role": "consent_text",
            "hidden": true,
            "text": "Email me offers and news. See our %s.",
            "link": {
              "label": "Privacy Policy"
            }
          }
        ]
      },
      {
        "type": "row",
        "children": [
          {
            "type": "heading",
            "id": "n6",
            "role": "success_headline",
            "level": 2,
            "text": "Here is your code"
          },
          {
            "type": "code",
            "id": "n7",
            "role": "code_value",
            "text": "WELCOME10"
          },
          {
            "type": "text",
            "id": "n8",
            "role": "success_body",
            "text": "Use it at the checkout."
          }
        ]
      }
    ]
  }
}
