{
  "id": "bar-code",
  "name": "Bar that hands over a code",
  "display_type": "floating_bar",
  "tier": "basic",
  "tokens": {
    "heading-size": "1.0625rem",
    "heading-weight": "600",
    "text-size": "1rem",
    "leading": "1.3",
    "pad": "0.75rem 1.25rem",
    "gap": "0.75rem",
    "width": "100%",
    "align": "start",
    "motion": "200ms",
    "bg": "#1e1b4b",
    "fg": "#eef2ff",
    "muted": "#a5b4fc",
    "accent": "#facc15",
    "accent-fg": "#1e1b4b",
    "border": "#4f4aa8",
    "radius": "0.375rem",
    "shadow": "0 -18px 50px -12px rgba(15, 23, 42, 0.35)",
    "tracking": "-0.01em",
    "input-bg": "#fffef8"
  },
  "tree": {
    "steps": [
      {
        "type": "stack",
        "children": [
          {
            "type": "row",
            "children": [
              {
                "type": "icon",
                "id": "n1",
                "name": "gift"
              },
              {
                "type": "heading",
                "id": "n2",
                "role": "headline",
                "level": 2,
                "text": "Ten percent off your first order"
              },
              {
                "type": "field",
                "id": "n3",
                "name": "email",
                "label": "Email address",
                "placeholder": "you@example.com",
                "required": true,
                "tokens": {
                  "fg": "#1e1b4b",
                  "muted": "#eef2ff"
                }
              },
              {
                "type": "button",
                "id": "n4",
                "role": "cta_label",
                "label": "Get my code",
                "action": "submit"
              }
            ]
          },
          {
            "type": "consent",
            "id": "n5",
            "role": "consent_text",
            "hidden": true,
            "text": "Email me offers and news. %s",
            "link": {
              "label": "Privacy Policy"
            },
            "tokens": {
              "text-size": "1.125rem"
            }
          }
        ]
      },
      {
        "type": "row",
        "children": [
          {
            "type": "heading",
            "id": "n6",
            "role": "success_headline",
            "level": 2,
            "text": "Here is your code"
          },
          {
            "type": "code",
            "id": "n7",
            "role": "code_value",
            "text": "WELCOME10",
            "copy": true
          },
          {
            "type": "text",
            "id": "n8",
            "role": "success_body",
            "text": "Use it at the checkout."
          }
        ]
      }
    ]
  }
}
