{
  "id": "bar-email-capture",
  "name": "Bar with a field",
  "display_type": "floating_bar",
  "tier": "basic",
  "tokens": {
    "bg": "#ffffff",
    "fg": "#111827",
    "muted": "#4b5563",
    "accent": "#2563eb",
    "accent-fg": "#ffffff",
    "border": "#768195",
    "heading-size": "1.0625rem",
    "heading-weight": "600",
    "text-size": "1rem",
    "leading": "1.5",
    "radius": "0.375rem",
    "pad": "1rem 1.25rem",
    "gap": "0.625rem",
    "width": "100%",
    "align": "start",
    "shadow": "0 0 24px -12px rgba(15,23,42,.25)",
    "motion": "200ms",
    "tracking": "-0.01em"
  },
  "tree": {
    "steps": [
      {
        "id": "s1",
        "name": "Details",
        "kind": "input",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "split",
              "ratio": 0.35,
              "basis": "16rem",
              "start": [
                {
                  "type": "heading",
                  "id": "n2",
                  "level": 1,
                  "role": "headline",
                  "text": "Five good reads, every Friday",
                  "tokens": {
                    "heading-size": "1.125rem",
                    "leading": "1.5"
                  }
                }
              ],
              "end": [
                {
                  "type": "row",
                  "tokens": {
                    "gap": "0.5rem"
                  },
                  "children": [
                    {
                      "type": "field",
                      "id": "n3",
                      "name": "email",
                      "label": "Email address",
                      "placeholder": "you@example.com",
                      "required": true,
                      "tokens": {
                        "border": "#768195"
                      }
                    },
                    {
                      "type": "button",
                      "id": "n4",
                      "role": "cta_label",
                      "label": "Send me the reads",
                      "action": "submit",
                      "submission": "primary",
                      "tokens": {
                        "text-size": "0.9375rem"
                      }
                    }
                  ]
                }
              ],
              "tokens": {
                "gap": "1rem"
              }
            },
            {
              "type": "consent",
              "id": "n5",
              "role": "consent_text",
              "hidden": true,
              "text": "Email me offers and news. %s",
              "link": {
                "label": "Privacy Policy"
              },
              "tokens": {
                "text-size": "1.125rem",
                "leading": "1.5"
              }
            }
          ]
        }
      },
      {
        "id": "s2",
        "name": "Received",
        "kind": "acknowledgement",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "heading",
              "id": "n7",
              "level": 1,
              "role": "success_headline",
              "text": "Request received"
            },
            {
              "type": "text",
              "id": "n8",
              "role": "success_body",
              "text": "Thank you for requesting the Friday reads.",
              "tokens": {
                "text-size": "0.875rem",
                "fg": "#4b5563"
              }
            }
          ],
          "tokens": {
            "gap": "0.25rem"
          }
        }
      }
    ],
    "v": 2,
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n3"
        ],
        "consents": [
          "n5"
        ]
      }
    ]
  }
}
