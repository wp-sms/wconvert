{
  "id": "bar-email-capture",
  "name": "Bar with a field",
  "display_type": "floating_bar",
  "tier": "basic",
  "tokens": {
    "bg": "#ffffff",
    "fg": "#111827",
    "muted": "#6b7280",
    "accent": "#2563eb",
    "accent-fg": "#ffffff",
    "border": "#d1d5db",
    "heading-size": "1.0625rem",
    "heading-weight": "600",
    "text-size": "1rem",
    "leading": "1.3",
    "radius": "0.375rem",
    "pad": "0.75rem 1.25rem",
    "gap": "0.75rem",
    "width": "100%",
    "align": "start",
    "shadow": "0 0 36px -10px rgba(15, 23, 42, 0.35)",
    "motion": "200ms",
    "tracking": "-0.01em"
  },
  "tree": {
    "steps": [
      {
        "id": "s1",
        "name": "Details",
        "kind": "input",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "row",
              "children": [
                {
                  "type": "heading",
                  "id": "n2",
                  "level": 1,
                  "role": "headline",
                  "text": "Five good reads, every Friday"
                },
                {
                  "type": "field",
                  "id": "n3",
                  "name": "email",
                  "label": "Email address",
                  "placeholder": "you@example.com",
                  "required": true,
                  "tokens": {
                    "border": "#8690a0"
                  }
                },
                {
                  "type": "button",
                  "id": "n4",
                  "role": "cta_label",
                  "label": "Send me the reads",
                  "action": "submit",
                  "submission": "primary"
                }
              ]
            },
            {
              "type": "consent",
              "id": "n5",
              "role": "consent_text",
              "hidden": true,
              "text": "Email me offers and news. %s",
              "link": {
                "label": "Privacy Policy"
              },
              "tokens": {
                "text-size": "1.125rem"
              }
            }
          ]
        }
      },
      {
        "id": "s2",
        "name": "Received",
        "kind": "acknowledgement",
        "content": {
          "type": "row",
          "children": [
            {
              "type": "icon",
              "id": "n6",
              "name": "check"
            },
            {
              "type": "heading",
              "id": "n7",
              "level": 1,
              "role": "success_headline",
              "text": "Request received"
            },
            {
              "type": "text",
              "id": "n8",
              "role": "success_body",
              "text": "Thank you for requesting the Friday reads."
            }
          ]
        }
      }
    ],
    "v": 2,
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n3"
        ],
        "consents": [
          "n5"
        ]
      }
    ]
  }
}
