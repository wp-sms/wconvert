{
  "name": "veronalabs/wconvert",
  "description": "Lead capture for WordPress — popups and inline forms, created goal-first.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0+",
  "authors": [
    {
      "name": "VeronaLabs",
      "email": "dev@veronalabs.com",
      "homepage": "https://veronalabs.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "woocommerce/action-scheduler": "^4.1"
  },
  "require-dev": {
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpunit/phpunit": "^10.5",
    "szepeviktor/phpstan-wordpress": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "WConvert\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WConvert\\Tests\\Unit\\": "tests/unit/",
      "WConvert\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --testdox --colors=always",
    "phpstan": "phpstan analyse --memory-limit=1G",
    "verify:source": "bash bin/verify-source-contract.sh",
    "verify:templates": "php bin/verify-templates.php",
    "verify:artifact": "bash bin/verify-artifact-contract.sh"
  },
  "config": {
    "platform": {
      "php": "8.1"
    },
    "allow-plugins": {
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  }
}
