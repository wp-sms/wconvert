{
  "name": "wconvert",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build -c vite.config.admin.mjs --watch",
    "build": "npm run build:admin && npm run build:loader && npm run build:loader:pro",
    "build:admin": "vite build -c vite.config.admin.mjs",
    "build:loader": "vite build -c vite.config.loader.mjs",
    "build:loader:pro": "vite build -c vite.config.loader-pro.mjs",
    "check:loader": "npm run build:loader && npm run build:loader:pro && node bin/check-loader.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^7.53.0",
    "@wordpress/i18n": "^6.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "terser": "^5.50.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
