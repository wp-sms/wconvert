{
  "name": "wconvert",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build -c vite.config.admin.mjs --watch",
    "build": "npm run build:free && npm run build:pro",
    "build:free": "npm run build:admin && npm run build:block && npm run build:loader && npm run build:phone && npm run build:protection && npm run build:inspector",
    "build:pro": "npm run build:admin:pro && npm run build:block:pro && npm run build:loader:pro && npm run build:inspector:pro && npm run build:analytics && npm run build:commerce && npm run build:revenue",
    "build:protection": "vite build -c vite.config.protection.mjs",
    "build:phone": "vite build -c vite.config.phone.mjs",
    "build:admin": "vite build -c vite.config.admin.mjs",
    "build:admin:pro": "vite build -c vite.config.admin-pro.mjs",
    "build:block": "vite build -c vite.config.block.mjs",
    "build:block:pro": "vite build -c vite.config.block-pro.mjs",
    "build:loader": "vite build -c vite.config.loader.mjs",
    "build:loader:pro": "vite build -c vite.config.loader-pro.mjs",
    "build:inspector": "vite build -c vite.config.inspector.mjs",
    "build:inspector:pro": "vite build -c vite.config.inspector-pro.mjs",
    "check:admin": "npm run build:admin && npm run build:inspector && node bin/check-admin.mjs",
    "check:loader": "npm run build:loader && npm run build:loader:pro && npm run build:phone && node bin/check-loader.mjs && node bin/check-phone.mjs && npm run build:analytics && node bin/check-analytics.mjs && npm run build:commerce && node bin/check-commerce.mjs && npm run build:revenue && node bin/check-revenue.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "prototype:editor": "vite --config tools/design-system/editor-prototype/vite.config.mjs",
    "prototype:recommendations": "vite --config tools/design-system/editor-prototype/vite.config.mjs --open '/?prototype=recommendations&variant=B'",
    "prototype:flow": "vite --config tools/design-system/editor-prototype/vite.config.mjs --open '/?prototype=flow&variant=B&scenario=garden'",
    "prototype:journeys": "vite --config tools/design-system/editor-prototype/vite.config.mjs --open '/?prototype=journeys&variant=B&scenario=garden'",
    "visual:serve": "node tools/visual-tests/server.mjs",
    "test:visual": "playwright test -c tools/visual-tests/playwright.config.mjs",
    "test:visual:popup": "playwright test -c tools/visual-tests/popup.config.mjs",
    "test:visual:fullscreen": "playwright test -c tools/visual-tests/fullscreen.config.mjs",
    "test:visual:inline": "playwright test -c tools/visual-tests/inline.config.mjs",
    "test:visual:content-lock": "playwright test -c tools/visual-tests/content-lock.config.mjs",
    "test:visual:events": "playwright test -c tools/visual-tests/events.config.mjs",
    "test:visual:reopen": "playwright test -c tools/visual-tests/reopen.config.mjs",
    "templates:pilot": "bash tools/design-library/build.sh renderer pilot proof roadmap",
    "test:template-studio": "node --test tools/design-library/build/*.test.mjs",
    "templates:review": "npm run templates:pilot && node tools/design-library/build/import-review.mjs",
    "templates:gate": "npm run templates:pilot && node tools/design-library/build/review-gate.mjs",
    "templates:check-announcements": "node tools/visual-tests/announcement-composition.mjs",
    "templates:record": "node tools/design-library/build/record-design.mjs",
    "templates:collections": "npm run templates:pilot && node tools/design-library/build/collections.mjs && node tools/design-library/build/collection-studio.mjs && node tools/design-library/build/collection-audit.mjs",
    "templates:collections:publish": "node tools/design-library/build/collections.mjs --publish",
    "templates:collections:check": "npm run templates:pilot && node tools/design-library/build/collections.mjs --check",
    "templates:release:local": "node tools/design-library/build/publish-local.mjs",
    "templates:revisions": "node tools/design-library/build/catalogue-revisions.mjs",
    "templates:visual-diff": "npm run templates:pilot && node tools/design-library/build/visual-diff.mjs",
    "templates:revisions:check": "node tools/design-library/build/catalogue-revisions.mjs --check",
    "templates:releasable": "bash tools/design-library/build.sh renderer pilot && node tools/design-library/build/releasable.mjs",
    "build:analytics": "vite build -c vite.config.analytics.mjs",
    "test:visual:analytics": "playwright test -c tools/visual-tests/analytics.config.mjs",
    "test:visual:flow": "playwright test -c tools/visual-tests/flow.config.mjs",
    "build:commerce": "vite build -c vite.config.commerce.mjs",
    "test:visual:commerce": "playwright test -c tools/visual-tests/commerce.config.mjs",
    "build:revenue": "vite build -c vite.config.revenue.mjs",
    "templates:audit:library": "bash tools/design-library/build.sh renderer library-review pilot && node tools/visual-tests/library-polish.mjs audit && WCONVERT_REVIEW_LONG_COPY=1 node tools/visual-tests/library-polish.mjs audit && node tools/visual-tests/template-studio-refresh.mjs all tools/design-library/out/library-journeys.json",
    "templates:review:scope": "npm run templates:pilot && node tools/design-library/build/plan-review.mjs",
    "templates:controls:proof": "npm run templates:pilot && node tools/design-library/build/control-proof.mjs",
    "prototype:commerce": "vite --config tools/design-library/commerce-prototype/vite.config.mjs",
    "prototype:winter": "vite --config tools/design-library/winter-prototype/vite.config.mjs",
    "build:pot": "php -d error_reporting=E_ERROR -d memory_limit=2G $(which wp) i18n make-pot . dist/languages/wconvert.pot --slug=wconvert --domain=wconvert --exclude=pro,node_modules,vendor,packages,dist,tools,tests,docs,bin,phpstan-stubs,.claude,.agents",
    "build:pot:pro": "php -d error_reporting=E_ERROR -d memory_limit=2G $(which wp) i18n make-pot pro pro/resources/languages/wconvert-pro.pot --slug=wconvert-pro --domain=wconvert-pro --exclude=node_modules,vendor,packages,tests,bin",
    "check:pot": "node bin/pot-coverage.mjs",
    "templates:labels": "node bin/template-labels.mjs",
    "preflight": "node bin/preflight.mjs"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^3.0.0",
    "@dagrejs/dagre": "^3.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@wordpress/api-fetch": "^7.53.0",
    "@wordpress/i18n": "^6.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lite-phone-input": "0.6.0",
    "lucide-react": "^1.34.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@wordpress/eslint-plugin": "^23.0.0",
    "@wp-playground/cli": "3.1.54",
    "eslint": "^9.20.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "picomatch": "^4.0.7",
    "terser": "^5.50.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
