{
  "id": "campaign-first-access-pass",
  "name": "First-Access Pass",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#101211",
    "fg": "#f4f4eb",
    "muted": "#f4f4eb",
    "accent": "#d9f86b",
    "accent-fg": "#181a12",
    "border": "#f4f4eb",
    "input-bg": "#101211",
    "placeholder": "fg",
    "font": "\"DM Sans\", Arial, sans-serif",
    "heading-font": "\"Bebas Neue\", Impact, sans-serif",
    "heading-size": "3.6rem",
    "heading-weight": "400",
    "heading-leading": ".95",
    "text-size": "1rem",
    "leading": "1.5",
    "tracking": "0",
    "pad": "2.75rem 0 0",
    "gap": "0",
    "radius": ".25rem",
    "width": "45rem",
    "motion": "0ms",
    "close-bg": "#171a1d",
    "close-fg": "#ffffff",
    "close-border": "#ffffff",
    "close-inset": ".5rem",
    "error-fg": "#ffffff",
    "error-bg": "#8f2020"
  },
  "tree": {
    "v": 2,
    "steps": [
      {
        "id": "offer",
        "name": "Offer",
        "kind": "input",
        "content": {
          "type": "split",
          "ratio": 0.35,
          "basis": "16rem",
          "start": [
            {
              "type": "panel",
              "children": [
                {
                  "type": "eyebrow",
                  "id": "n1",
                  "role": "eyebrow",
                  "text": "BLACK FRIDAY",
                  "tokens": {
                    "text-size": ".625rem",
                    "tracking": ".12em"
                  }
                },
                {
                  "type": "text",
                  "id": "n2",
                  "role": "body",
                  "text": "%b",
                  "tokens": {
                    "text-size": "6rem",
                    "leading": ".95",
                    "font": "\"Bebas Neue\", Impact, sans-serif"
                  },
                  "emphasis": "26",
                  "narrow": {
                    "text-size": "4.5rem"
                  }
                },
                {
                  "type": "text",
                  "id": "n3",
                  "role": "body",
                  "text": "NOVEMBER\nONE DAY EARLY"
                },
                {
                  "type": "panel",
                  "children": [],
                  "tokens": {
                    "pad": "0",
                    "gap": "0"
                  },
                  "narrow": {
                    "pad": "0"
                  },
                  "min": "2.5rem",
                  "decorations": {
                    "label": "Decorative barcode",
                    "hidden": false,
                    "items": [
                      {
                        "kind": "barcode",
                        "motion": "none",
                        "x": 50,
                        "y": 50,
                        "size": 130,
                        "color": "fg"
                      }
                    ]
                  }
                }
              ],
              "tokens": {
                "pad": "2rem 1.5rem",
                "gap": ".9rem",
                "bg": "accent",
                "fg": "accent-fg",
                "muted": "accent-fg",
                "align": "center"
              },
              "narrow": {
                "pad": "1.4rem"
              }
            }
          ],
          "end": [
            {
              "type": "panel",
              "children": [
                {
                  "type": "badge",
                  "id": "n4",
                  "role": "badge",
                  "text": "UP TO 40% OFF"
                },
                {
                  "type": "heading",
                  "id": "n5",
                  "role": "headline",
                  "text": "YOUR PASS\nTO FIRST PICK.",
                  "narrow": {
                    "heading-size": "2.65rem"
                  }
                },
                {
                  "type": "text",
                  "id": "n6",
                  "role": "body",
                  "text": "Request entry to selected Black Friday offers before the public opening."
                },
                {
                  "type": "stack",
                  "children": [
                    {
                      "type": "field",
                      "id": "n7",
                      "name": "email",
                      "label": "Email address",
                      "placeholder": "you@example.com",
                      "required": true
                    },
                    {
                      "type": "consent",
                      "id": "n8",
                      "role": "consent_text",
                      "text": "Email me Black Friday offers. I can unsubscribe anytime.",
                      "hidden": true
                    },
                    {
                      "type": "button",
                      "id": "n9",
                      "role": "cta_label",
                      "label": "Get early access",
                      "icon": "arrow",
                      "action": "submit",
                      "submission": "email-preview"
                    }
                  ],
                  "tokens": {
                    "gap": ".85rem"
                  }
                },
                {
                  "type": "text",
                  "id": "n10",
                  "role": "fine_print",
                  "text": "Preview opens November 26. Selected offers.",
                  "tokens": {
                    "text-size": ".875rem"
                  }
                }
              ],
              "tokens": {
                "pad": "2rem",
                "gap": ".9rem"
              },
              "narrow": {
                "pad": "1.4rem"
              },
              "decorations": {
                "label": "Decorative halo",
                "hidden": false,
                "items": [
                  {
                    "kind": "halo",
                    "motion": "pulse",
                    "x": 90,
                    "y": 7,
                    "size": 60,
                    "color": "accent"
                  }
                ]
              }
            }
          ],
          "tokens": {
            "gap": "0"
          }
        }
      },
      {
        "id": "received",
        "name": "Request received",
        "kind": "acknowledgement",
        "content": {
          "type": "panel",
          "children": [
            {
              "type": "heading",
              "id": "n11",
              "role": "success_headline",
              "text": "Request received"
            },
            {
              "type": "text",
              "id": "n12",
              "role": "success_body",
              "text": "Thanks for requesting the Black Friday preview."
            },
            {
              "type": "text",
              "id": "n13",
              "role": "fine_print",
              "text": "You can close this window and continue browsing."
            }
          ],
          "tokens": {
            "pad": "2rem",
            "gap": ".9rem"
          },
          "narrow": {
            "pad": "1.4rem"
          }
        }
      }
    ],
    "submissions": [
      {
        "id": "email-preview",
        "required": true,
        "fields": [
          "n7"
        ],
        "consents": [
          "n8"
        ]
      }
    ],
    "fonts": [
      {
        "family": "DM Sans",
        "faces": [
          {
            "weight": 400,
            "italic": false
          },
          {
            "weight": 700,
            "italic": false
          }
        ]
      },
      {
        "family": "Bebas Neue",
        "faces": [
          {
            "weight": 400,
            "italic": false
          }
        ]
      },
      {
        "family": "Cormorant Garamond",
        "faces": [
          {
            "weight": 400,
            "italic": false
          }
        ]
      }
    ]
  }
}
