{
  "id": "campaign-private-preview",
  "name": "Private Preview",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#322332",
    "fg": "#f3e1bd",
    "muted": "#f3e1bd",
    "accent": "#ddc18a",
    "accent-fg": "#342335",
    "border": "#f3e1bd",
    "input-bg": "#322332",
    "placeholder": "fg",
    "font": "\"DM Sans\", Arial, sans-serif",
    "heading-font": "\"Cormorant Garamond\", Georgia, serif",
    "heading-size": "3.6rem",
    "heading-weight": "400",
    "heading-leading": ".95",
    "text-size": "1rem",
    "leading": "1.5",
    "tracking": "0",
    "pad": "2.75rem 0 0",
    "gap": "0",
    "radius": ".25rem",
    "width": "45rem",
    "motion": "0ms",
    "close-bg": "#171a1d",
    "close-fg": "#ffffff",
    "close-border": "#ffffff",
    "close-inset": ".5rem",
    "error-fg": "#ffffff",
    "error-bg": "#8f2020"
  },
  "tree": {
    "v": 2,
    "steps": [
      {
        "id": "offer",
        "name": "Offer",
        "kind": "input",
        "content": {
          "type": "split",
          "ratio": 0.5,
          "basis": "16rem",
          "start": [
            {
              "type": "panel",
              "children": [
                {
                  "type": "image",
                  "id": "n1",
                  "src": "data:image/webp;base64,",
                  "alt": "",
                  "fit": "contain",
                  "shape": "rect",
                  "tokens": {
                    "image-height": "26rem",
                    "image-position": "center",
                    "radius": "0"
                  },
                  "narrow": {
                    "image-height": "16rem"
                  }
                }
              ],
              "tokens": {
                "pad": "0",
                "gap": "0"
              },
              "narrow": {
                "pad": "1.4rem"
              },
              "decorations": {
                "label": "Decorative halo",
                "hidden": false,
                "items": [
                  {
                    "kind": "halo",
                    "motion": "pulse",
                    "x": 50,
                    "y": 30,
                    "size": 160,
                    "color": "accent"
                  }
                ]
              }
            }
          ],
          "end": [
            {
              "type": "panel",
              "children": [
                {
                  "type": "eyebrow",
                  "id": "n2",
                  "role": "eyebrow",
                  "text": "BLACK FRIDAY / EARLY-ACCESS SIGNUP",
                  "tokens": {
                    "text-size": ".625rem",
                    "tracking": ".12em"
                  }
                },
                {
                  "type": "heading",
                  "id": "n3",
                  "role": "headline",
                  "text": "FIRST ACCESS.\nUP TO 30% OFF.",
                  "narrow": {
                    "heading-size": "2.65rem"
                  }
                },
                {
                  "type": "text",
                  "id": "n4",
                  "role": "body",
                  "text": "Request access to selected Black Friday offers on November 26, one day before the public sale."
                },
                {
                  "type": "stack",
                  "children": [
                    {
                      "type": "field",
                      "id": "n5",
                      "name": "email",
                      "label": "Email address",
                      "placeholder": "you@example.com",
                      "required": true
                    },
                    {
                      "type": "consent",
                      "id": "n6",
                      "role": "consent_text",
                      "text": "Email me Black Friday offers. I can unsubscribe anytime.",
                      "hidden": true
                    },
                    {
                      "type": "button",
                      "id": "n7",
                      "role": "cta_label",
                      "label": "Request access",
                      "icon": "arrow",
                      "action": "submit",
                      "submission": "email-preview"
                    }
                  ],
                  "tokens": {
                    "gap": ".85rem"
                  }
                },
                {
                  "type": "text",
                  "id": "n8",
                  "role": "fine_print",
                  "text": "Access opens November 26. Selected items. No purchase required.",
                  "tokens": {
                    "text-size": ".875rem"
                  }
                }
              ],
              "tokens": {
                "pad": "2rem",
                "gap": ".9rem"
              },
              "narrow": {
                "pad": "1.4rem"
              }
            }
          ],
          "tokens": {
            "gap": "0"
          }
        }
      },
      {
        "id": "received",
        "name": "Request received",
        "kind": "acknowledgement",
        "content": {
          "type": "panel",
          "children": [
            {
              "type": "heading",
              "id": "n9",
              "role": "success_headline",
              "text": "Request received"
            },
            {
              "type": "text",
              "id": "n10",
              "role": "success_body",
              "text": "Thanks for requesting the Black Friday preview."
            },
            {
              "type": "text",
              "id": "n11",
              "role": "fine_print",
              "text": "You can close this window and continue browsing."
            }
          ],
          "tokens": {
            "pad": "2rem",
            "gap": ".9rem"
          },
          "narrow": {
            "pad": "1.4rem"
          }
        }
      }
    ],
    "submissions": [
      {
        "id": "email-preview",
        "required": true,
        "fields": [
          "n5"
        ],
        "consents": [
          "n6"
        ]
      }
    ],
    "fonts": [
      {
        "family": "DM Sans",
        "faces": [
          {
            "weight": 400,
            "italic": false
          },
          {
            "weight": 700,
            "italic": false
          }
        ]
      },
      {
        "family": "Bebas Neue",
        "faces": [
          {
            "weight": 400,
            "italic": false
          }
        ]
      },
      {
        "family": "Cormorant Garamond",
        "faces": [
          {
            "weight": 400,
            "italic": false
          }
        ]
      }
    ]
  }
}
