              "tokens": {
                "heading-size": "3rem",
                "heading-font": "\"Instrument Serif\", Georgia, serif",
                "heading-weight": "400"
              },
              "id": "n2"
            },
            {
              "type": "text",
              "text": "Join our December letters for gift ideas and a 15% welcome code.",
              "role": "body",
              "id": "n3"
            },
            {
              "type": "field",
              "name": "email",
              "label": "Email address",
              "placeholder": "",
              "required": true,
              "tokens": {
                "input-bg": "transparent",
                "text-size": "1rem",
                "radius": ".15rem",
                "border": "fg"
              },
              "id": "n4"
            },
            {
              "type": "button",
              "label": "Get winter letters + 15% off",
              "action": "submit",
              "submission": "primary",
              "role": "cta_label",
              "tokens": {
                "text-size": "1rem",
                "radius": ".15rem",
                "border": "fg",
                "tracking": "normal"
              },
              "id": "n5"
            },
            {
              "type": "consent",
              "hidden": true,
              "text": "I agree to receive marketing emails. Unsubscribe anytime.",
              "role": "consent_text",
              "tokens": {
                "text-size": ".875rem"
              },
              "id": "n6"
            },
            {
              "type": "text",
              "text": "Your code appears here after signup.",
              "role": "fine_print",
              "tokens": {
                "text-size": ".875rem",
                "tracking": "normal"
              },
              "id": "n7"
            },
            {
              "type": "text",
              "text": "With a little love,\nThe December edit",
              "role": "body",
              "id": "n8"
            }
          ],
          "tokens": {
            "pad": "3.5rem 2rem 2rem",
            "gap": "1rem",
            "radius": "0"
          },
          "narrow": {
            "pad": "3.5rem 1.5rem 1.5rem",
            "gap": ".85rem"
          },
          "edges": "block-start"
        }
      },
      {
        "id": "s2",
        "name": "Request received",
        "kind": "acknowledgement",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "image",
              "src": "data:image/webp;base64,",
              "alt": "Sealed winter letter",
              "fit": "contain",
              "tokens": {
                "radius": "0"
              },
              "id": "n9"
            },
            {
              "type": "panel",
              "children": [
                {
                  "type": "heading",
                  "text": "Thank you.\nRequest received.",
                  "role": "success_headline",
                  "tokens": {
                    "heading-size": "2.5rem"
