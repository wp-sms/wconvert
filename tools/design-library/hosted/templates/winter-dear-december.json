    "heading-size": "3rem",
    "heading-weight": "400",
    "text-size": "1rem",
    "leading": "1.55",
    "tracking": "-.02em",
    "pad": "0",
    "gap": "0",
    "radius": "0",
    "width": "30rem",
    "align": "start",
    "close-fg": "fg",
    "close-bg": "bg",
    "close-border": "border",
    "close-radius": "50%",
    "error-fg": "#991b1b",
    "error-bg": "#fff1f2"
