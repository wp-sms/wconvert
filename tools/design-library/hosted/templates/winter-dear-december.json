                },
                {
                  "type": "text",
                  "text": "Here is your welcome code. Enjoy finding something lovely.",
                  "role": "success_body",
                  "id": "n11"
                },
                {
                  "type": "code",
                  "copy": true,
                  "copy_label": "Copy code",
                  "copied_label": "Copied",
                  "copy_failed_label": "Select and copy this code",
                  "text": "MERRY15",
                  "role": "code_value",
                  "id": "n12"
                },
                {
                  "type": "button",
                  "label": "Continue browsing",
                  "action": "close",
                  "role": "close_label",
                  "tokens": {
                    "accent": "bg",
                    "accent-fg": "fg"
                  },
                  "id": "n13"
                }
              ],
              "tokens": {
                "pad": "2.25rem",
                "gap": "1rem",
                "radius": "0"
              },
              "narrow": {
                "pad": "1.5rem",
                "gap": ".85rem"
              }
            }
          ],
          "tokens": {
            "gap": "0"
          }
        }
      }
