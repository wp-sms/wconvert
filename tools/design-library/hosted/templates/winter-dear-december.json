    "fonts": [
      {
        "family": "DM Sans",
        "faces": [
          {
            "weight": 400,
            "italic": false
          },
          {
            "weight": 700,
            "italic": false
          }
        ]
      },
      {
        "family": "Instrument Serif",
        "faces": [
          {
            "weight": 400,
            "italic": false
          }
        ]
      }
    ]
