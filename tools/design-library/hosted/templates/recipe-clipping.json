{
  "id": "recipe-clipping",
  "name": "Recipe clipping",
  "display_type": "inline",
  "tier": "free",
  "tokens": {
    "bg": "#fffcf3",
    "fg": "#3d3420",
    "muted": "#665c45",
    "accent": "#546339",
    "accent-fg": "#ffffff",
    "border": "#706b57",
    "input-bg": "#ffffff",
    "heading-size": "2.25rem",
    "heading-weight": "400",
    "text-size": "1rem",
    "leading": "1.5",
    "tracking": "-0.025em",
    "pad": "1.25rem",
    "gap": "1rem",
    "radius": "0",
    "width": "42rem",
    "shadow": "0 20px 64px -24px rgba(20,30,25,.28)",
    "heading-font": "Georgia, serif"
  },
  "tree": {
    "v": 2,
    "steps": [
      {
        "id": "sample",
        "name": "Read a sample",
        "kind": "content",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "row",
              "children": [
                {
                  "type": "eyebrow",
                  "id": "n1",
                  "text": "THE SMALL KITCHEN",
                  "role": "eyebrow"
                },
                {
                  "type": "eyebrow",
                  "id": "n2",
                  "text": "RECIPE 01",
                  "role": "eyebrow"
                }
              ]
            },
            {
              "type": "heading",
              "id": "n3",
              "text": "Good things.\nOne tray.",
              "role": "headline",
              "tokens": {
                "heading-font": "Georgia, serif",
                "heading-weight": "400",
                "heading-size": "2.75rem"
              },
              "narrow": {
                "heading-size": "1.875rem"
              }
            },
            {
              "type": "text",
              "id": "n4",
              "text": "A sample from our weeknight recipe collection.",
              "role": "body"
            },
            {
              "type": "split",
              "start": [
                {
                  "type": "panel",
                  "children": [
                    {
                      "type": "eyebrow",
                      "id": "n5",
                      "text": "IN THE TRAY",
                      "role": "eyebrow"
                    },
                    {
                      "type": "text",
                      "id": "n6",
                      "text": "Chickpeas\nCherry tomatoes\nCourgette\nOlive oil & lemon",
                      "role": "body"
                    }
                  ],
                  "tokens": {
                    "bg": "#eadfc4",
                    "radius": "0",
                    "pad": "1.25rem"
                  }
                }
              ],
              "end": [
                {
                  "type": "stack",
                  "children": [
                    {
                      "type": "eyebrow",
                      "id": "n7",
                      "text": "THE IDEA",
                      "role": "eyebrow"
                    },
                    {
                      "type": "text",
                      "id": "n8",
                      "text": "Roast the vegetables and chickpeas until golden. Finish with lemon and serve with warm bread.",
                      "role": "body"
                    },
                    {
                      "type": "text",
                      "id": "n9",
                      "text": "The full guide includes quantities, timings and variations.",
                      "role": "body",
                      "tokens": {
                        "text-size": ".9375rem"
                      }
                    }
                  ]
                }
              ],
              "ratio": 0.35,
              "basis": "16rem"
            },
            {
              "type": "button",
              "id": "n10",
              "label": "Request the full recipe collection",
              "action": "next",
              "role": "next_label"
            }
          ]
        }
      },
      {
        "id": "details",
        "name": "Request the recipes",
        "kind": "input",
        "content": {
          "type": "panel",
          "children": [
            {
              "type": "eyebrow",
              "id": "n11",
              "text": "THE SMALL KITCHEN / YOUR COPY",
              "role": "eyebrow"
            },
            {
              "type": "heading",
              "id": "n12",
              "text": "Five dinners.\nA little less thinking.",
              "role": "headline"
            },
            {
              "type": "text",
              "id": "n13",
              "text": "Leave your email to request the recipe collection.",
              "role": "body"
            },
            {
              "type": "field",
              "id": "n14",
              "name": "email",
              "label": "Email address",
              "placeholder": "you@example.com",
              "required": true
            },
            {
              "type": "consent",
              "id": "n15",
              "role": "consent_text",
              "text": "Use my email to send the recipe collection.",
              "hidden": true
            },
            {
              "type": "button",
              "id": "n16",
              "label": "Request the recipes",
              "action": "submit",
              "role": "cta_label",
              "submission": "request"
            },
            {
              "type": "button",
              "id": "n17",
              "label": "Back to the sample",
              "action": "back",
              "role": "back_label",
              "tokens": {
                "accent": "transparent",
                "accent-fg": "fg"
              }
            },
            {
              "type": "text",
              "id": "n18",
              "text": "A one-off recipe request. No newsletter signup.",
              "role": "fine_print",
              "tokens": {
                "text-size": "1rem"
              },
              "size": "s"
            }
          ],
          "tokens": {
            "bg": "#eadfc4",
            "pad": "1rem",
            "radius": "0"
          }
        }
      },
      {
        "id": "received",
        "name": "Request received",
        "kind": "acknowledgement",
        "content": {
          "type": "panel",
          "children": [
            {
              "type": "eyebrow",
              "id": "n19",
              "text": "THE SMALL KITCHEN / REQUEST",
              "role": "eyebrow"
            },
            {
              "type": "heading",
              "id": "n20",
              "role": "success_headline",
              "text": "Recipe request received",
              "tokens": {
                "heading-size": "1.75rem"
              }
            },
            {
              "type": "divider",
              "id": "n21"
            },
            {
              "type": "text",
              "id": "n22",
              "role": "success_body",
              "text": "Thank you for requesting the collection. Your email has been recorded for this request."
            },
            {
              "type": "button",
              "id": "n23",
              "label": "Close",
              "action": "close",
              "role": "close_label",
              "tokens": {
                "accent": "transparent",
                "accent-fg": "fg"
              }
            }
          ],
          "tokens": {
            "pad": "1.75rem",
            "gap": "1rem",
            "bg": "#eadfc4",
            "radius": "0"
          }
        }
      }
    ],
    "submissions": [
      {
        "id": "request",
        "required": true,
        "fields": [
          "n14"
        ],
        "consents": [
          "n15"
        ]
      }
    ]
  }
}
