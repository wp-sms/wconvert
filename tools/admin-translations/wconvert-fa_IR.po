#: public/admin/chunk-CuNRFJ_G.js:45
msgid "More detail"
msgstr "جزئیات بیشتر"

#: public/admin/chunk-CuNRFJ_G.js:45
msgid "Submissions don’t include the page address, IP address or browser details."
msgstr "ثبت‌های فرم شامل آدرس صفحه، آدرس IP یا جزئیات مرورگر نیستند."

#. translators: %s: how long the fallback cookie lasts, e.g. “365 days”.
#: public/admin/chunk-CuNRFJ_G.js:47
#, js-format
msgid "If the browser blocks storage, a cookie keeps the display history for up to %s. Neither holds contact details or a visitor ID."
msgstr "اگر مرورگر فضای ذخیره‌سازی را مسدود کند، یک کوکی تاریخچه نمایش را تا %s نگه می‌دارد. هیچ‌کدام اطلاعات تماس یا ID بازدیدکننده را در خود ندارند."

#: public/admin/chunk-CuNRFJ_G.js:47
msgid "Per-session counts keep at most 128 campaigns, dropping the least recently shown first. Browsers may restore a tab’s session storage with the tab."
msgstr "شمارش‌های هر نشست حداکثر ۱۲۸ کمپین را نگه می‌دارند و کمپین‌هایی را که مدت بیشتری از نمایششان گذشته است زودتر کنار می‌گذارند. مرورگرها ممکن است فضای ذخیره‌سازی نشست یک زبانه را همراه با آن زبانه بازیابی کنند."

#: public/admin/chunk-CuNRFJ_G.js:47
msgid "Content locks remember at most 64 campaigns. When storage is blocked, an unlock lasts for that page only."
msgstr "قفل‌های محتوا حداکثر ۶۴ کمپین را به خاطر می‌سپارند. وقتی فضای ذخیره‌سازی مسدود باشد، باز شدن قفل فقط برای همان صفحه باقی می‌ماند."

#: public/admin/chunk-CuNRFJ_G.js:47
msgid "Cart rules read the existing WooCommerce session and keep matches in page memory for up to 30 seconds. Cart reads are rate-limited for one minute by a one-way IP code."
msgstr "قوانین سبد خرید نشست موجود WooCommerce را می‌خوانند و موارد منطبق را تا ۳۰ ثانیه در حافظه صفحه نگه می‌دارند. خواندن سبد خرید با یک کد یک‌طرفه IP برای یک دقیقه محدود می‌شود."

#: public/admin/chunk-CuNRFJ_G.js:47
msgid "Expired one-way codes are removed during scheduled maintenance."
msgstr "کدهای یک‌طرفه منقضی‌شده هنگام نگه‌داری زمان‌بندی‌شده حذف می‌شوند."

#: public/admin/chunk-CuNRFJ_G.js:47
msgid "Show templates from the WConvert library"
msgstr "نمایش قالب‌ها از کتابخانه WConvert"

#: public/admin/chunk-CuNRFJ_G.js:47
msgid "Templates, their thumbnails and their words for your site’s language come from templates.wconvert.io, run on Cloudflare. Thumbnails load in your browser, so Cloudflare sees its IP address. No site address, license or visitor data is sent. WConvert checks for new templates at most twice a day, and only while you have this library open."
msgstr "قالب‌ها، تصاویر کوچکشان و متن‌هایشان به زبان سایت شما از templates.wconvert.io می‌آیند که روی Cloudflare اجرا می‌شود. تصاویر کوچک در مرورگر شما بارگذاری می‌شوند، بنابراین Cloudflare آدرس IP آن را می‌بیند. هیچ آدرس سایت، لایسنس یا داده بازدیدکننده‌ای ارسال نمی‌شود. WConvert حداکثر دو بار در روز و فقط زمانی که این کتابخانه را باز کرده‌اید قالب‌های جدید را بررسی می‌کند."

