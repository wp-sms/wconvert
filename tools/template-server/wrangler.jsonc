{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wconvert-template-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "PUBLIC_TEMPLATES",
      "bucket_name": "wconvert-templates-public"
    },
    {
      "binding": "PRIVATE_TEMPLATES",
      "bucket_name": "wconvert-templates-private"
    }
  ],
  "vars": {
    "NEXUS_GRANT_URL": "",
    "NEXUS_KEYS_URL": "",
    "NEXUS_ISSUER": "",
    "NEXUS_AUDIENCE": "",
    "NEXUS_ENVIRONMENT": ""
  }
}
