{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wconvert-template-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "GRANT_RATE_LIMITER",
      "namespace_id": "202610211",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "GRANT_IP_RATE_LIMITER",
      "namespace_id": "202610212",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "DOWNLOAD_RATE_LIMITER",
      "namespace_id": "202610213",
      "simple": { "limit": 1000, "period": 60 }
    },
    {
      "name": "DOWNLOAD_IP_RATE_LIMITER",
      "namespace_id": "202610214",
      "simple": { "limit": 6000, "period": 60 }
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "DOWNLOADS",
      "dataset": "wconvert_design_downloads"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PUBLIC_TEMPLATES",
      "bucket_name": "wconvert-templates-public"
    },
    {
      "binding": "PRIVATE_TEMPLATES",
      "bucket_name": "wconvert-templates-private"
    }
  ],
  "vars": {
    "PREVIEW_EMBED_ORIGINS": "https://wconvert.io https://www.wconvert.io https://dev.wconvert-website.pages.dev",
    "NEXUS_GRANT_URL": "https://my.wconvert.io/api/v1/wconvert/entitlements/grant",
    "NEXUS_KEYS_URL": "https://my.wconvert.io/api/v1/wconvert/entitlements/keys",
    "NEXUS_ISSUER": "https://nexus.veronalabs.com",
    "NEXUS_AUDIENCE": "https://templates.wconvert.io",
    "NEXUS_ENVIRONMENT": "production"
  },
  "account_id": "c1a1ad8e669eb8c31ce039ea78aa6ab9",
  "routes": [
    {
      "pattern": "templates.wconvert.io",
      "custom_domain": true
    }
  ]
}
