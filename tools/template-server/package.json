{
  "name": "wconvert-template-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 9454",
    "types": "wrangler types",
    "check": "wrangler types && tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "npm run build && node --test test/*.test.mjs",
    "seed": "node scripts/seed-local.mjs",
    "verify": "node scripts/verify-local.mjs",
    "test:wordpress": "node scripts/verify-wordpress.mjs",
    "publish": "node scripts/publish-remote.mjs",
    "status": "node scripts/publish-remote.mjs --status",
    "backup": "node scripts/backup-remote.mjs",
    "rehearse:recovery": "npm run build && node scripts/rehearse-recovery.mjs",
    "verify:limits": "node scripts/verify-rate-limits.mjs",
    "verify:remote": "node scripts/verify-remote.mjs",
    "test:release": "npm run build && node scripts/verify-release.mjs",
    "verify:gallery": "npm run build && node scripts/verify-gallery.mjs",
    "preview:gallery": "npm run build && node scripts/preview-gallery.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "miniflare": "5.20261006.1-alpha",
    "typescript": "7.0.2",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=22"
  }
}
