{
  "id": "email-only",
  "name": "Email signup",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "width": "28rem",
    "pad": "1.5rem",
    "gap": "1rem",
    "align": "start"
  },
  "tree": {
    "v": 2,
    "submissions": [
      {
        "id": "email-signup",
        "required": true,
        "fields": [
          "n_email"
        ],
        "consents": [
          "n_email_consent"
        ]
      }
    ],
    "steps": [
      {
        "id": "email",
        "name": "Email signup",
        "kind": "input",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "heading",
              "id": "n_email_title",
              "role": "headline",
              "text": "Get our email updates"
            },
            {
              "type": "field",
              "id": "n_email",
              "name": "email",
              "label": "Email address",
              "required": true
            },
            {
              "type": "consent",
              "id": "n_email_consent",
              "role": "consent_text",
              "hidden": false,
              "text": "Email me news and offers."
            },
            {
              "type": "button",
              "id": "n_email_submit",
              "role": "cta_label",
              "label": "Sign up for email",
              "action": "submit",
              "submission": "email-signup"
            }
          ]
        }
      },
      {
        "id": "received",
        "name": "Acknowledgement",
        "kind": "acknowledgement",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "heading",
              "id": "n_received_title",
              "role": "success_headline",
              "text": "Details received"
            },
            {
              "type": "text",
              "id": "n_received_body",
              "role": "success_body",
              "text": "Thank you. We have received the details you submitted."
            }
          ]
        }
      }
    ]
  }
}
