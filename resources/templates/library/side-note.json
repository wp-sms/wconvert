{
  "id": "side-note",
  "name": "Picture on the side",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#ffffff",
    "fg": "#18181b",
    "muted": "#71717a",
    "accent": "#be123c",
    "accent-fg": "#ffffff",
    "border": "#e4e4e7",
    "heading-size": "1.625rem",
    "radius": "0.75rem",
    "pad": "1.5rem",
    "gap": "1.25rem",
    "width": "34rem",
    "align": "start",
    "backdrop": "rgba(24, 24, 27, 0.55)",
    "shadow": "0 18px 50px -12px rgba(15, 23, 42, 0.35)",
    "tracking": "-0.02em"
  },
  "tree": {
    "steps": [
      {
        "type": "split",
        "ratio": 0.35,
        "start": [
          {
            "type": "image",
            "id": "n1",
            "src": "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%203%204'%3E%3Cdefs%3E%3ClinearGradient%20id='g'%20x1='0'%20y1='0'%20x2='1'%20y2='1'%3E%3Cstop%20offset='0'%20stop-color='%231e293b'/%3E%3Cstop%20offset='.6'%20stop-color='%23334155'/%3E%3Cstop%20offset='1'%20stop-color='%2364748b'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width='3'%20height='4'%20fill='url%28%23g%29'/%3E%3Ccircle%20cx='1.5'%20cy='1.35'%20r='0.78'%20fill='%23cbd5e1'%20opacity='.55'/%3E%3Ccircle%20cx='2.4'%20cy='3.2'%20r='0.9'%20fill='%2394a3b8'%20opacity='.4'/%3E%3C/svg%3E",
            "alt": "A photograph of the product",
            "fit": "cover"
          }
        ],
        "end": [
          {
            "type": "stack",
            "children": [
              {
                "type": "badge",
                "id": "n2",
                "role": "badge",
                "text": "Back in stock"
              },
              {
                "type": "heading",
                "id": "n3",
                "role": "headline",
                "text": "It is here again"
              },
              {
                "type": "text",
                "id": "n4",
                "role": "body",
                "text": "We made more, and this is the last of them."
              },
              {
                "type": "field",
                "id": "n5",
                "name": "email",
                "label": "Email address",
                "placeholder": "you@example.com",
                "required": true
              },
              {
                "type": "button",
                "id": "n6",
                "role": "cta_label",
                "label": "Tell me when it ships",
                "action": "submit"
              },
              {
                "type": "consent",
                "id": "n7",
                "role": "consent_text",
                "hidden": true,
                "text": "Email me offers and news. See our %s.",
                "link": {
                  "label": "Privacy Policy"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "stack",
        "children": [
          {
            "type": "icon",
            "id": "n10",
            "name": "check"
          },
          {
            "type": "heading",
            "id": "n8",
            "role": "success_headline",
            "text": "We will let you know"
          },
          {
            "type": "text",
            "id": "n9",
            "role": "success_body",
            "text": "One email, the morning it ships."
          }
        ]
      }
    ]
  }
}
