{
  "id": "inline-tinted",
  "name": "Inline tinted",
  "display_type": "inline",
  "tier": "free",
  "tokens": {
    "bg": "#ffffff",
    "fg": "#0c4a6e",
    "muted": "#0369a1",
    "accent": "#0284c7",
    "accent-fg": "#ffffff",
    "border": "#bae6fd",
    "input-bg": "#ffffff",
    "heading-size": "1.375rem",
    "heading-weight": "700",
    "tracking": "-0.01em",
    "radius": "1rem",
    "pad": "0",
    "gap": "0",
    "width": "40rem",
    "align": "start",
    "shadow": "none"
  },
  "tree": {
    "steps": [
      {
        "type": "panel",
        "tokens": {
          "bg": "#f0f9ff",
          "bg-image": "linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%)",
          "pad": "1.75rem",
          "gap": "1rem"
        },
        "children": [
          {
            "type": "split",
            "ratio": 0.5,
            "start": [
              {
                "type": "stack",
                "tokens": { "gap": "0.375rem" },
                "children": [
                  { "type": "badge", "id": "n1", "role": "badge", "text": "New" },
                  {
                    "type": "heading",
                    "id": "n2",
                    "role": "headline",
                    "size": "xl",
                    "text": "The tide table, every Sunday"
                  },
                  {
                    "type": "text",
                    "id": "n3",
                    "role": "body",
                    "size": "s",
                    "text": "Times, swell and wind for the week ahead."
                  }
                ]
              }
            ],
            "end": [
              {
                "type": "panel",
                "tokens": { "bg": "#ffffff", "pad": "1rem", "gap": "0.625rem", "radius": "0.75rem" },
                "children": [
                  {
                    "type": "field",
                    "id": "n4",
                    "name": "email",
                    "label": "Email address",
                    "placeholder": "you@example.com",
                    "required": true
                  },
                  { "type": "button", "id": "n5", "role": "cta_label", "label": "Send it to me", "action": "submit" },
                  {
                    "type": "consent",
                    "id": "n6",
                    "role": "consent_text",
                    "hidden": true,
                    "text": "Email me offers and news. See our %s.",
                    "link": { "label": "Privacy Policy" }
                  },
                  {
                    "type": "text",
                    "id": "n7",
                    "role": "fine_print",
                    "size": "xs",
                    "text": "One email a week. Unsubscribe at any time."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "panel",
        "tokens": {
          "bg": "#f0f9ff",
          "bg-image": "linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%)",
          "pad": "1.75rem",
          "gap": "0.5rem"
        },
        "children": [
          { "type": "heading", "id": "n8", "role": "success_headline", "size": "xl", "text": "Thank you" },
          {
            "type": "text",
            "id": "n9",
            "role": "success_body",
            "text": "We have received your request for a place at the Sunday table."
          }
        ]
      }
    ]
  }
}
