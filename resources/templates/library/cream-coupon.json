{
  "id": "cream-coupon",
  "name": "Cream coupon",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#fffaf2",
    "fg": "#331e17",
    "muted": "#8a6d5c",
    "accent": "#f45a31",
    "accent-fg": "#fff8f2",
    "border": "#e6cfb9",
    "input-bg": "#ffffff",
    "font": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "heading-font": "Georgia, 'Times New Roman', Times, serif",
    "heading-size": "1.5rem",
    "heading-weight": "700",
    "tracking": "-0.02em",
    "leading": "1.5",
    "radius": "0.25rem",
    "pad": "0",
    "gap": "0",
    "width": "25rem",
    "align": "center",
    "shadow": "0 24px 64px rgba(51, 30, 23, 0.28)",
    "backdrop": "rgba(51, 30, 23, 0.5)"
  },
  "tree": {
    "steps": [
      {
        "type": "stack",
        "children": [
          {
            "type": "panel",
            "tokens": { "pad": "2.5rem 2rem 2rem", "gap": "0.5rem" },
            "children": [
              { "type": "eyebrow", "id": "n1", "role": "eyebrow", "text": "First order only" },
              { "type": "heading", "id": "n2", "role": "headline", "size": "3xl", "text": "15%" },
              {
                "type": "text",
                "id": "n3",
                "role": "body",
                "size": "xl",
                "text": "off everything in the shop, for your first order."
              }
            ]
          },
          {
            "type": "panel",
            "edges": "block-start",
            "tokens": {
              "bg": "#fff4df",
              "border": "#f45a31",
              "pad": "1.5rem 2rem 2rem",
              "gap": "0.75rem"
            },
            "children": [
              {
                "type": "field",
                "id": "n4",
                "name": "email",
                "label": "Email address",
                "placeholder": "you@example.com",
                "required": true
              },
              { "type": "button", "id": "n5", "role": "cta_label", "label": "Send my 15%", "action": "submit" },
              {
                "type": "consent",
                "id": "n6",
                "role": "consent_text",
                "hidden": true,
                "text": "Email me offers and news. See our %s.",
                "link": { "label": "Privacy Policy" }
              },
              {
                "type": "text",
                "id": "n7",
                "role": "fine_print",
                "size": "s",
                "text": "One code per customer. Unsubscribe whenever you like."
              }
            ]
          }
        ]
      },
      {
        "type": "stack",
        "children": [
          {
            "type": "panel",
            "tokens": { "pad": "2.5rem 2rem 1.5rem", "gap": "0.5rem" },
            "children": [
              { "type": "heading", "id": "n8", "role": "success_headline", "size": "xl", "text": "Here is your code" },
              {
                "type": "text",
                "id": "n9",
                "role": "success_body",
                "text": "Type it in at the checkout. We have emailed it to you as well."
              }
            ]
          },
          {
            "type": "panel",
            "edges": "block-start",
            "tokens": {
              "bg": "#fff4df",
              "border": "#f45a31",
              "pad": "1.5rem 2rem 2rem"
            },
            "children": [
              { "type": "code", "id": "n10", "role": "code_value", "text": "WELCOME15" }
            ]
          }
        ]
      }
    ]
  }
}
