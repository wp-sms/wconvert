{
  "id": "inline-rule",
  "name": "Inline rule",
  "display_type": "inline",
  "tier": "free",
  "tokens": {
    "bg": "#ffffff",
    "fg": "#18181b",
    "muted": "#71717a",
    "accent": "#7c2d12",
    "accent-fg": "#ffffff",
    "border": "#e4e4e7",
    "input-bg": "#ffffff",
    "heading-font": "Georgia, 'Times New Roman', Times, serif",
