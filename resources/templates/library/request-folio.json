{
  "id": "request-folio",
  "name": "Request folio",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#f6f1e8",
    "fg": "#322b26",
    "muted": "#665b51",
    "accent": "#843d2b",
    "border": "#cfbfae",
    "accent-fg": "#ffffff",
    "input-bg": "#ffffff",
    "heading-font": "system-ui, sans-serif",
    "heading-size": "1.875rem",
    "heading-weight": "600",
    "tracking": "-0.035em",
    "text-size": "1rem",
    "leading": "1.5",
    "radius": "0.5rem",
    "pad": "0",
    "gap": "1rem",
    "width": "34rem",
    "shadow": "0 20px 56px -20px rgba(28,42,31,.3)"
  },
  "tree": {
    "v": 2,
    "steps": [
      {
        "id": "request",
        "name": "Your request",
        "kind": "input",
        "content": {
          "type": "panel",
          "children": [
            {
              "type": "row",
              "children": [
                {
                  "type": "eyebrow",
                  "id": "n1",
                  "role": "eyebrow",
                  "text": "1 / Your request"
                },
                {
                  "type": "text",
                  "id": "n2",
                  "text": "Two short steps",
                  "role": "fine_print",
                  "size": "s",
                  "tokens": {
                    "text-size": "1.167rem"
                  }
                }
              ],
              "tokens": {
                "gap": "1rem"
              }
            },
            {
              "type": "heading",
              "id": "n3",
              "text": "Could it be repaired?",
              "role": "headline"
            },
            {
              "type": "panel",
              "children": [
                {
                  "type": "field",
                  "id": "n4",
                  "name": "interest",
                  "label": "What needs attention? (optional)",
                  "placeholder": "Choose an item",
                  "required": false,
                  "options": [
                    {
                      "value": "chair",
                      "label": "A chair"
                    },
                    {
                      "value": "table",
                      "label": "A table"
                    },
                    {
                      "value": "other",
                      "label": "Another piece"
                    }
                  ],
                  "tokens": {
                    "border": "#a6896a"
                  }
                },
                {
                  "type": "row",
                  "children": [
                    {
                      "type": "button",
                      "id": "n5",
                      "label": "Continue to email",
                      "action": "next",
                      "role": "next_label"
                    }
                  ],
                  "tokens": {
                    "align": "end"
                  }
                }
              ],
              "tokens": {
                "pad": "1.5rem",
                "gap": "1rem",
                "bg": "#fffdf9",
                "border": "#cfbfae",
                "radius": "0.5rem"
              },
              "narrow": {
                "pad": "1.25rem"
              },
              "edges": "all"
            },
            {
              "type": "text",
              "id": "n6",
              "text": "No photos or measurements needed to start.",
              "role": "body"
            }
          ],
          "tokens": {
            "pad": "2rem",
            "gap": "1.25rem"
          },
          "narrow": {
            "pad": "1.25rem"
          }
        }
      },
      {
        "id": "details",
        "name": "Reply address",
        "kind": "input",
        "content": {
          "type": "panel",
          "children": [
            {
              "type": "row",
              "children": [
                {
                  "type": "eyebrow",
                  "id": "n11",
                  "role": "eyebrow",
                  "text": "2 / Reply address"
                },
                {
                  "type": "text",
                  "id": "n12",
                  "text": "Two short steps",
                  "role": "fine_print",
                  "size": "s",
                  "tokens": {
                    "text-size": "1.167rem"
                  }
                }
              ],
              "tokens": {
                "gap": "1rem"
              }
            },
            {
              "type": "heading",
              "id": "n13",
              "text": "Where can we reply?",
              "role": "headline"
            },
            {
              "type": "panel",
              "children": [
                {
                  "type": "field",
                  "id": "n14",
                  "name": "email",
                  "label": "Email address",
                  "placeholder": "you@example.com",
                  "required": true,
                  "tokens": {
                    "border": "#a6896a"
                  }
                },
                {
                  "type": "row",
                  "children": [
                    {
                      "type": "button",
                      "id": "n16",
                      "label": "Back",
                      "action": "back",
                      "role": "back_label",
                      "tokens": {
                        "accent": "transparent",
                        "accent-fg": "fg"
                      }
                    },
                    {
                      "type": "button",
                      "id": "n15",
                      "label": "Send request",
                      "action": "submit",
                      "role": "cta_label",
                      "submission": "primary"
                    }
                  ],
                  "tokens": {
                    "gap": "0.5rem",
                    "align": "end"
                  }
                }
              ],
              "tokens": {
                "pad": "1.5rem",
                "gap": "1rem",
                "bg": "#fffdf9",
                "border": "#cfbfae",
                "radius": "0.5rem"
              },
              "narrow": {
                "pad": "1.25rem"
              },
              "edges": "all"
            },
            {
              "type": "text",
              "id": "n17",
              "text": "We use your email to discuss this request. This is not a booking.",
              "role": "body"
            }
          ],
          "tokens": {
            "pad": "2rem",
            "gap": "1.25rem"
          },
          "narrow": {
            "pad": "1.25rem"
          }
        }
      },
      {
        "id": "received",
        "name": "Request received",
        "kind": "acknowledgement",
        "content": {
          "type": "panel",
          "children": [
            {
              "type": "icon",
              "id": "n90",
              "name": "check"
            },
            {
              "type": "heading",
              "id": "n91",
              "text": "Request received",
              "role": "success_headline"
            },
            {
              "type": "text",
              "id": "n92",
              "text": "Thank you. We have received your request.",
              "role": "success_body"
            }
          ],
          "tokens": {
            "pad": "2rem",
            "gap": "0.875rem"
          },
          "narrow": {
            "pad": "1.25rem"
          }
        }
      }
    ],
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n4",
          "n14"
        ],
        "consents": []
      }
    ]
  }
}
