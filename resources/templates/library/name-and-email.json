{
  "id": "name-and-email",
  "name": "Name and email",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#fffbeb",
    "fg": "#1c1917",
    "muted": "#78716c",
    "accent": "#b45309",
    "accent-fg": "#ffffff",
    "border": "#fde68a",
    "heading-size": "1.75rem",
    "radius": "0.875rem",
    "pad": "clamp(1.25rem, 5%, 2rem)",
    "gap": "0.875rem",
    "width": "26rem",
    "align": "start",
    "backdrop": "rgba(28, 25, 23, 0.55)",
    "shadow": "0 18px 50px -12px rgba(15, 23, 42, 0.35)",
    "tracking": "-0.02em",
    "text-size": "1rem",
    "input-bg": "#ffffff"
  },
  "tree": {
    "steps": [
      {
        "type": "stack",
        "children": [
          {
            "type": "heading",
            "id": "n1",
            "role": "headline",
            "text": "A practical guide to getting started"
          },
          {
            "type": "text",
            "id": "n2",
            "role": "body",
            "text": "Request the guide. Add your first name if you would like a personal reply."
          },
          {
            "type": "field",
            "id": "n3",
            "name": "name",
            "label": "First name (optional)",
            "placeholder": "Your name",
            "required": false
          },
          {
            "type": "field",
            "id": "n4",
            "name": "email",
            "label": "Email address",
            "placeholder": "you@example.com",
            "required": true
          },
          {
            "type": "button",
            "id": "n5",
            "role": "cta_label",
            "label": "Request my guide",
            "action": "submit"
          },
          {
            "type": "consent",
            "id": "n6",
            "role": "consent_text",
            "hidden": true,
            "text": "Email me offers and news. %s",
            "link": {
              "label": "Privacy Policy"
            },
            "tokens": {
              "text-size": "1.125rem"
            }
          },
          {
            "type": "text",
            "id": "n7",
            "role": "fine_print",
            "text": "No spam, and you can unsubscribe at any time.",
            "size": "s",
            "tokens": {
              "text-size": "1.167rem"
            }
          }
        ]
      },
      {
        "type": "stack",
        "children": [
          {
            "type": "icon",
            "id": "n10",
            "name": "check"
          },
          {
            "type": "heading",
            "id": "n8",
            "role": "success_headline",
            "text": "Request received"
          },
          {
            "type": "text",
            "id": "n9",
            "role": "success_body",
            "text": "Thank you for requesting the guide. We have received your details."
          }
        ]
      }
    ]
  }
}
