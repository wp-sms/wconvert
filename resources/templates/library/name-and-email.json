{
  "id": "name-and-email",
  "name": "Name and email",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#faf7ef",
    "fg": "#1c1917",
    "muted": "#57534e",
    "accent": "#93420c",
    "accent-fg": "#ffffff",
    "border": "#8b8173",
    "heading-size": "1.875rem",
    "radius": "0.75rem",
    "pad": "3.25rem clamp(1.25rem, 5%, 1.75rem) 1.5rem",
    "gap": "1.25rem",
    "width": "30rem",
    "align": "start",
    "backdrop": "rgba(28, 25, 23, 0.55)",
    "shadow": "0 18px 45px -20px rgba(55, 40, 24, 0.3)",
    "tracking": "-0.02em",
    "text-size": "1rem",
    "input-bg": "#ffffff",
    "leading": "1.55",
    "heading-font": "Georgia, serif",
    "heading-weight": "500"
  },
  "tree": {
    "steps": [
      {
        "id": "s1",
        "name": "Details",
        "kind": "input",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "stack",
              "tokens": {
                "gap": "0.75rem"
              },
              "children": [
                {
                  "type": "heading",
                  "id": "n1",
                  "role": "headline",
                  "text": "A practical guide to getting started"
                },
                {
                  "type": "text",
                  "id": "n2",
                  "role": "body",
                  "text": "A clear set of steps for your next project. Request a copy by email."
                }
              ]
            },
            {
              "type": "divider",
              "id": "n11"
            },
            {
              "type": "stack",
              "tokens": {
                "gap": "0.875rem"
              },
              "children": [
                {
                  "type": "field",
                  "id": "n3",
                  "name": "name",
                  "label": "First name (optional)",
                  "placeholder": "Your name",
                  "required": false,
                  "tokens": {
                    "radius": "0.375rem"
                  }
                },
                {
                  "type": "field",
                  "id": "n4",
                  "name": "email",
                  "label": "Email address",
                  "placeholder": "you@example.com",
                  "required": true,
                  "tokens": {
                    "radius": "0.375rem"
                  }
                },
                {
                  "type": "consent",
                  "id": "n6",
                  "role": "consent_text",
                  "hidden": true,
                  "text": "We use your details for this guide request. %s",
                  "link": {
                    "label": "Privacy Policy"
                  },
                  "tokens": {
                    "text-size": "1.125rem"
                  }
                },
                {
                  "type": "button",
                  "id": "n5",
                  "role": "cta_label",
                  "label": "Request my guide",
                  "action": "submit",
                  "submission": "primary",
                  "tokens": {
                    "radius": "0.375rem"
                  }
                },
                {
                  "type": "text",
                  "id": "n7",
                  "role": "fine_print",
                  "text": "Your details are used for this guide request.",
                  "size": "s",
                  "tokens": {
                    "text-size": "1.167rem"
                  }
                }
              ]
            }
          ],
          "narrow": {
            "heading-size": "1.625rem"
          }
        }
      },
      {
        "id": "s2",
        "name": "Received",
        "kind": "acknowledgement",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "icon",
              "id": "n10",
              "name": "check"
            },
            {
              "type": "heading",
              "id": "n8",
              "role": "success_headline",
              "text": "Request received",
              "tokens": {
                "heading-size": "1.5rem"
              }
            },
            {
              "type": "text",
              "id": "n9",
              "role": "success_body",
              "text": "Thank you for requesting the guide. We have received your details."
            }
          ],
          "tokens": {
            "gap": "1rem"
          }
        }
      }
    ],
    "v": 2,
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n3",
          "n4"
        ],
        "consents": [
          "n6"
        ]
      }
    ]
  }
}
