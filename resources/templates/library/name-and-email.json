{
  "id": "name-and-email",
  "name": "Name and email",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#faf7ef",
    "fg": "#1c1917",
    "muted": "#57534e",
    "accent": "#93420c",
    "accent-fg": "#ffffff",
    "border": "#8b8173",
    "heading-size": "1.625rem",
    "radius": "0.875rem",
    "pad": "clamp(1.25rem, 5%, 2rem)",
    "gap": "1rem",
    "width": "28rem",
    "align": "start",
    "backdrop": "rgba(28, 25, 23, 0.55)",
    "shadow": "0 18px 50px -12px rgba(15, 23, 42, 0.35)",
    "tracking": "-0.02em",
    "text-size": "1rem",
    "input-bg": "#ffffff",
    "leading": "1.55"
  },
  "tree": {
    "steps": [
      {
        "id": "s1",
        "name": "Details",
        "kind": "input",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "heading",
              "id": "n1",
              "role": "headline",
              "text": "A practical guide to getting started"
            },
            {
              "type": "text",
              "id": "n2",
              "role": "body",
              "text": "A clear set of steps for your next project. Request a copy by email."
            },
            {
              "type": "field",
              "id": "n3",
              "name": "name",
              "label": "First name (optional)",
              "placeholder": "Your name",
              "required": false,
              "tokens": {
                "radius": "0.375rem"
              }
            },
            {
              "type": "field",
              "id": "n4",
              "name": "email",
              "label": "Email address",
              "placeholder": "you@example.com",
              "required": true,
              "tokens": {
                "radius": "0.375rem"
              }
            },
            {
              "type": "button",
              "id": "n5",
              "role": "cta_label",
              "label": "Request my guide",
              "action": "submit",
              "submission": "primary",
              "tokens": {
                "radius": "0.375rem"
              }
            },
            {
              "type": "consent",
              "id": "n6",
              "role": "consent_text",
              "hidden": true,
              "text": "We use your details for this guide request. %s",
              "link": {
                "label": "Privacy Policy"
              },
              "tokens": {
                "text-size": "1.125rem"
              }
            },
            {
              "type": "text",
              "id": "n7",
              "role": "fine_print",
              "text": "Your details are used for this guide request.",
              "size": "s",
              "tokens": {
                "text-size": "1.167rem"
              }
            }
          ]
        }
      },
      {
        "id": "s2",
        "name": "Received",
        "kind": "acknowledgement",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "icon",
              "id": "n10",
              "name": "check"
            },
            {
              "type": "heading",
              "id": "n8",
              "role": "success_headline",
              "text": "Request received",
              "tokens": {
                "heading-size": "1.5rem"
              }
            },
            {
              "type": "text",
              "id": "n9",
              "role": "success_body",
              "text": "Thank you for requesting the guide. We have received your details."
            }
          ]
        }
      }
    ],
    "v": 2,
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n3",
          "n4"
        ],
        "consents": [
          "n6"
        ]
      }
    ]
  }
}
