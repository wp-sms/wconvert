{
  "id": "one-line-signup",
  "name": "One-line signup",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#ffffff",
    "fg": "#111827",
    "muted": "#6b7280",
    "accent": "#2563eb",
    "accent-fg": "#ffffff",
    "border": "#e5e7eb",
    "heading-size": "1.25rem",
    "radius": "999px",
    "pad": "1.5rem",
    "gap": "0.75rem",
    "width": "30rem",
    "align": "center",
    "backdrop": "rgba(15, 23, 42, 0.45)"
  },
  "tree": {
    "steps": [
      {
        "type": "row",
        "children": [
          {
            "type": "heading",
            "id": "n1",
            "role": "headline",
            "text": "One email a week. That is all."
          },
          {
            "type": "field",
            "id": "n2",
            "name": "email",
            "label": "Email address",
            "placeholder": "you@example.com",
            "required": true
          },
          {
            "type": "button",
            "id": "n3",
            "role": "cta_label",
            "label": "Subscribe",
            "action": "submit"
          },
          {
            "type": "consent",
            "id": "n4",
            "role": "consent_text",
            "hidden": true,
            "text": "Email me offers and news. See our %s.",
            "link": {
              "label": "Privacy Policy"
            }
          }
        ]
      },
      {
        "type": "stack",
        "children": [
          {
            "type": "heading",
            "id": "n5",
            "role": "success_headline",
            "text": "Subscribed"
          },
          {
            "type": "text",
            "id": "n6",
            "role": "success_body",
            "text": "The next issue will be with you on Friday."
          }
        ]
      }
    ]
  }
}
