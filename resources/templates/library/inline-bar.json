{
  "id": "inline-bar",
  "name": "Inline bar",
  "display_type": "inline",
  "tier": "free",
  "tokens": {
    "bg": "#ecfeff",
    "fg": "#083344",
    "muted": "#0e7490",
    "accent": "#0891b2",
    "accent-fg": "#ffffff",
    "border": "#a5f3fc",
    "heading-size": "1.25rem",
    "radius": "0.5rem",
    "pad": "1.25rem",
    "gap": "0.75rem",
    "width": "44rem",
    "align": "start",
    "shadow": "none",
    "tracking": "-0.015em"
  },
  "tree": {
    "steps": [
      {
        "type": "row",
        "children": [
          {
            "type": "stack",
            "children": [
              {
                "type": "heading",
                "id": "n1",
                "role": "headline",
                "text": "Get the weekly round-up"
              },
              {
                "type": "text",
                "id": "n2",
                "role": "body",
                "text": "Five links, every Thursday."
              }
            ]
          },
          {
            "type": "field",
            "id": "n3",
            "name": "email",
            "label": "Email address",
            "placeholder": "you@example.com",
            "required": true
          },
          {
            "type": "button",
            "id": "n4",
            "role": "cta_label",
            "label": "Sign up",
            "action": "submit"
          },
          {
            "type": "consent",
            "id": "n5",
            "role": "consent_text",
            "hidden": true,
            "text": "Email me offers and news. See our %s.",
            "link": {
              "label": "Privacy Policy"
            }
          }
        ]
      },
      {
        "type": "stack",
        "children": [
          {
            "type": "icon",
            "id": "n8",
            "name": "check"
          },
          {
            "type": "heading",
            "id": "n6",
            "role": "success_headline",
            "text": "Thank you"
          },
          {
            "type": "text",
            "id": "n7",
            "role": "success_body",
            "text": "We have received your request for the weekly round-up."
          }
        ]
      }
    ]
  }
}
