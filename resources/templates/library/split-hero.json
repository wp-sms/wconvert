{
  "id": "split-hero",
  "name": "Split hero",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#ffffff",
    "fg": "#0f172a",
    "muted": "#64748b",
    "accent": "#0f172a",
    "accent-fg": "#ffffff",
    "border": "#e2e8f0",
    "heading-size": "1.75rem",
    "radius": "0.875rem",
    "pad": "1.75rem",
    "gap": "1rem",
    "width": "38rem",
    "align": "start",
    "backdrop": "rgba(15, 23, 42, 0.55)",
    "shadow": "0 32px 80px -16px rgba(15, 23, 42, 0.5)",
    "tracking": "-0.02em"
  },
  "tree": {
    "steps": [
      {
        "type": "split",
        "ratio": 0.5,
        "start": [
          {
            "type": "image",
            "id": "n1",
            "src": "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%203%204'%3E%3Cdefs%3E%3ClinearGradient%20id='g'%20x1='0'%20y1='0'%20x2='1'%20y2='1'%3E%3Cstop%20offset='0'%20stop-color='%232f4858'/%3E%3Cstop%20offset='.55'%20stop-color='%2333658a'/%3E%3Cstop%20offset='1'%20stop-color='%2386bbd8'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width='3'%20height='4'%20fill='url%28%23g%29'/%3E%3Ccircle%20cx='0.9'%20cy='1.0'%20r='0.62'%20fill='%23ffd9a8'%20opacity='.9'/%3E%3Ccircle%20cx='2.05'%20cy='2.5'%20r='0.85'%20fill='%23f2a65a'%20opacity='.85'/%3E%3C/svg%3E",
            "alt": "A photograph of the product",
            "fit": "cover"
          }
        ],
        "end": [
          {
            "type": "stack",
            "children": [
              {
                "type": "heading",
                "id": "n2",
                "role": "headline",
                "text": "Ten percent off, on us"
              },
              {
                "type": "text",
                "id": "n3",
                "role": "body",
                "text": "Join the list and the code lands before you finish reading this."
              },
              {
                "type": "field",
                "id": "n4",
                "name": "email",
                "label": "Email address",
                "placeholder": "you@example.com",
                "required": true
              },
              {
                "type": "button",
                "id": "n5",
                "role": "cta_label",
                "label": "Send my code",
                "action": "submit"
              },
              {
                "type": "consent",
                "id": "n6",
                "role": "consent_text",
                "hidden": true,
                "text": "Email me offers and news. See our %s.",
                "link": {
                  "label": "Privacy Policy"
                }
              },
              {
                "type": "text",
                "id": "n7",
                "role": "fine_print",
                "text": "No spam, and you can unsubscribe at any time."
              }
            ]
          }
        ]
      },
      {
        "type": "stack",
        "children": [
          {
            "type": "icon",
            "id": "n10",
            "name": "check"
          },
          {
            "type": "heading",
            "id": "n8",
            "role": "success_headline",
            "text": "Thank you"
          },
          {
            "type": "text",
            "id": "n9",
            "role": "success_body",
            "text": "We have received your request for the welcome offer."
          }
        ]
      }
    ]
  }
}
