{
  "id": "service-process-strip",
  "name": "Service process strip",
  "display_type": "inline",
  "tier": "free",
  "tokens": {
    "bg": "#ffffff",
    "fg": "#27364b",
    "muted": "#536278",
    "accent": "#344f73",
    "accent-fg": "#ffffff",
    "border": "#738398",
    "input-bg": "#ffffff",
    "heading-size": "1.75rem",
    "heading-weight": "600",
    "text-size": "1rem",
    "leading": "1.5",
    "pad": "1.5rem",
    "gap": "1rem",
    "radius": "0.75rem",
    "width": "54rem",
    "shadow": "none"
  },
  "tree": {
    "v": 2,
    "steps": [
      {
        "id": "details",
        "name": "Your request",
        "kind": "input",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "heading",
              "id": "n1",
              "text": "Start with the piece you want to keep.",
              "role": "headline"
            },
            {
              "type": "text",
              "id": "n2",
              "text": "An enquiry is the first step towards a restoration plan.",
              "role": "body"
            },
            {
              "type": "split",
              "ratio": 0.5,
              "basis": "20rem",
              "tokens": {
                "gap": "2rem"
              },
              "start": [
                {
                  "type": "stack",
                  "tokens": {
                    "gap": "1.25rem"
                  },
                  "children": [
                    {
                      "type": "stack",
                      "tokens": {
                        "gap": "0.25rem"
                      },
                      "children": [
                        {
                          "type": "row",
                          "tokens": {
                            "gap": "0.75rem"
                          },
                          "children": [
                            {
                              "type": "eyebrow",
                              "id": "n3",
                              "text": "01",
                              "role": "eyebrow"
                            },
                            {
                              "type": "heading",
                              "id": "n4",
                              "text": "Tell us",
                              "tokens": {
                                "heading-size": "1.125rem"
                              },
                              "role": "headline"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "n5",
                          "text": "Leave your email so we can discuss the piece.",
                          "role": "body"
                        }
                      ]
                    },
                    {
                      "type": "stack",
                      "tokens": {
                        "gap": "0.25rem"
                      },
                      "children": [
                        {
                          "type": "row",
                          "tokens": {
                            "gap": "0.75rem"
                          },
                          "children": [
                            {
                              "type": "eyebrow",
                              "id": "n6",
                              "text": "02",
                              "role": "eyebrow"
                            },
                            {
                              "type": "heading",
                              "id": "n7",
                              "text": "Assess together",
                              "tokens": {
                                "heading-size": "1.125rem"
                              },
                              "role": "headline"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "n8",
                          "text": "Share photos and agree what needs attention.",
                          "role": "body"
                        }
                      ]
                    },
                    {
                      "type": "stack",
                      "tokens": {
                        "gap": "0.25rem"
                      },
                      "children": [
                        {
                          "type": "row",
                          "tokens": {
                            "gap": "0.75rem"
                          },
                          "children": [
                            {
                              "type": "eyebrow",
                              "id": "n9",
                              "text": "03",
                              "role": "eyebrow"
                            },
                            {
                              "type": "heading",
                              "id": "n10",
                              "text": "Decide on the work",
                              "tokens": {
                                "heading-size": "1.125rem"
                              },
                              "role": "headline"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "id": "n11",
                          "text": "Review the scope and price before committing.",
                          "role": "body"
                        }
                      ]
                    }
                  ]
                }
              ],
              "end": [
                {
                  "type": "panel",
                  "tokens": {
                    "bg": "#edf1f6",
                    "pad": "1.25rem",
                    "gap": "0.75rem",
                    "radius": "0.5rem"
                  },
                  "children": [
                    {
                      "type": "field",
                      "id": "n12",
                      "name": "email",
                      "label": "Email address",
                      "placeholder": "you@example.com",
                      "required": true
                    },
                    {
                      "type": "consent",
                      "id": "n13",
                      "text": "Use my email to discuss this restoration request.",
                      "hidden": true,
                      "tokens": {
                        "text-size": "1.125rem"
                      },
                      "role": "consent_text"
                    },
                    {
                      "type": "button",
                      "id": "n14",
                      "label": "Ask about restoration",
                      "action": "submit",
                      "submission": "primary",
                      "role": "cta_label"
                    },
                    {
                      "type": "text",
                      "id": "n15",
                      "text": "We use your email to reply. No work is booked by this form.",
                      "size": "s",
                      "tokens": {
                        "text-size": "1.167rem"
                      },
                      "role": "fine_print"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "id": "received",
        "name": "Request received",
        "kind": "acknowledgement",
        "content": {
          "type": "panel",
          "children": [
            {
              "type": "eyebrow",
              "id": "n90",
              "text": "Request received",
              "role": "eyebrow"
            },
            {
              "type": "heading",
              "id": "n91",
              "text": "Restoration enquiry received",
              "role": "success_headline"
            },
            {
              "type": "text",
              "id": "n92",
              "text": "Thank you. The next conversation can cover the piece, photographs and a possible assessment. No work is booked.",
              "role": "success_body"
            }
          ],
          "tokens": {
            "pad": "0rem",
            "gap": "1rem",
            "bg": "#fff"
          }
        }
      }
    ],
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n12"
        ],
        "consents": [
          "n13"
        ]
      }
    ]
  }
}
