{
  "id": "code-reveal",
  "name": "Code on success",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#fffbeb",
    "fg": "#1c1917",
    "muted": "#78716c",
    "accent": "#b45309",
    "accent-fg": "#ffffff",
    "border": "#fde68a",
    "heading-size": "2rem",
    "heading-weight": "800",
    "radius": "1rem",
    "pad": "clamp(1.25rem, 5%, 2rem)",
    "gap": "0.875rem",
    "width": "27rem",
    "align": "center",
    "backdrop": "rgba(28, 25, 23, 0.6)",
    "shadow": "0 32px 80px -16px rgba(15, 23, 42, 0.5)",
    "tracking": "-0.025em",
    "text-size": "1rem",
    "input-bg": "#ffffff"
  },
  "tree": {
    "steps": [
      {
        "type": "stack",
        "children": [
          {
            "type": "eyebrow",
            "id": "n1",
            "role": "eyebrow",
            "text": "New customers",
            "tokens": {
              "text-size": "1.0834rem"
            }
          },
          {
            "type": "heading",
            "id": "n2",
            "role": "headline",
            "text": "Your first order, 10% less."
          },
          {
            "type": "text",
            "id": "n3",
            "role": "body",
            "text": "Leave your email to reveal your first-order code here."
          },
          {
            "type": "field",
            "id": "n4",
            "name": "email",
            "label": "Email address",
            "placeholder": "you@example.com",
            "required": true
          },
          {
            "type": "button",
            "id": "n5",
            "role": "cta_label",
            "label": "Reveal my code",
            "action": "submit"
          },
          {
            "type": "consent",
            "id": "n6",
            "role": "consent_text",
            "hidden": true,
            "text": "Email me offers and news. %s",
            "link": {
              "label": "Privacy Policy"
            },
            "tokens": {
              "text-size": "1.125rem"
            }
          },
          {
            "type": "text",
            "id": "n7",
            "role": "fine_print",
            "text": "One use per customer. Not with other offers.",
            "size": "s",
            "tokens": {
              "text-size": "1.167rem"
            }
          }
        ]
      },
      {
        "type": "stack",
        "children": [
          {
            "type": "heading",
            "id": "n8",
            "role": "success_headline",
            "text": "Here it is"
          },
          {
            "type": "code",
            "id": "n9",
            "role": "code_value",
            "text": "WELCOME10",
            "copy": true
          },
          {
            "type": "text",
            "id": "n10",
            "role": "success_body",
            "text": "We have received your details. Enter this code at checkout."
          }
        ]
      }
    ]
  }
}
