{
  "id": "stacked-signup",
  "name": "Stacked signup",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#f8fdff",
    "fg": "#0f172a",
    "muted": "#64748b",
    "accent": "#08638a",
    "accent-fg": "#ffffff",
    "border": "#cfeaf7",
    "heading-size": "1.75rem",
    "radius": "0.875rem",
    "pad": "2.25rem",
    "gap": "0.875rem",
    "width": "24rem",
    "align": "start",
    "backdrop": "rgba(15, 23, 42, 0.45)",
    "shadow": "0 18px 50px -12px rgba(15, 23, 42, 0.35)",
    "tracking": "-0.02em",
    "text-size": "1rem",
    "input-bg": "#ffffff"
  },
  "tree": {
    "steps": [
      {
        "id": "s1",
        "name": "Details",
        "kind": "input",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "heading",
              "id": "n1",
              "role": "headline",
              "text": "Text me the drops"
            },
            {
              "type": "text",
              "id": "n2",
              "role": "body",
              "text": "One message when something new lands. Nothing else."
            },
            {
              "type": "field",
              "id": "n3",
              "name": "phone",
              "label": "Mobile number",
              "placeholder": "+44 7700 900000",
              "required": true
            },
            {
              "type": "button",
              "id": "n4",
              "role": "cta_label",
              "label": "Request text updates",
              "action": "submit",
              "submission": "primary"
            },
            {
              "type": "consent",
              "id": "n5",
              "role": "consent_text",
              "hidden": true,
              "text": "Send me text updates about new releases. %s",
              "link": {
                "label": "Privacy Policy"
              },
              "tokens": {
                "text-size": "1.125rem"
              }
            },
            {
              "type": "text",
              "id": "n6",
              "role": "fine_print",
              "text": "Occasional text updates. Message rates may apply. You can opt out.",
              "size": "s",
              "tokens": {
                "text-size": "1.167rem"
              }
            }
          ]
        }
      },
      {
        "id": "s2",
        "name": "Received",
        "kind": "acknowledgement",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "icon",
              "id": "n9",
              "name": "check"
            },
            {
              "type": "heading",
              "id": "n7",
              "role": "success_headline",
              "text": "Request received"
            },
            {
              "type": "text",
              "id": "n8",
              "role": "success_body",
              "text": "Thank you for asking to hear about the next drop."
            }
          ]
        }
      }
    ],
    "v": 2,
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n3"
        ],
        "consents": [
          "n5"
        ]
      }
    ]
  }
}
