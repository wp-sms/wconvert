{
  "id": "stacked-signup",
  "name": "Stacked signup",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#f8fdff",
    "fg": "#0f172a",
    "muted": "#64748b",
    "accent": "#0284c7",
    "accent-fg": "#ffffff",
    "border": "#cfeaf7",
    "heading-size": "1.75rem",
    "radius": "0.875rem",
    "pad": "2.25rem",
    "gap": "0.875rem",
    "width": "24rem",
    "align": "start",
    "backdrop": "rgba(15, 23, 42, 0.45)",
    "shadow": "0 18px 50px -12px rgba(15, 23, 42, 0.35)",
    "tracking": "-0.02em"
  },
  "tree": {
    "steps": [
      {
        "type": "stack",
        "children": [
          {
            "type": "heading",
            "id": "n1",
            "role": "headline",
            "text": "Text me the drops"
          },
          {
            "type": "text",
            "id": "n2",
            "role": "body",
            "text": "One message when something new lands. Nothing else."
          },
          {
            "type": "field",
            "id": "n3",
            "name": "phone",
            "label": "Mobile number",
            "placeholder": "+44 7700 900000",
            "required": true
          },
          {
            "type": "button",
            "id": "n4",
            "role": "cta_label",
            "label": "Sign me up",
            "action": "submit"
          },
          {
            "type": "consent",
            "id": "n5",
            "role": "consent_text",
            "hidden": true,
            "text": "Email me offers and news. See our %s.",
            "link": {
              "label": "Privacy Policy"
            }
          },
          {
            "type": "text",
            "id": "n6",
            "role": "fine_print",
            "text": "Message rates may apply. Stop at any time."
          }
        ]
      },
      {
        "type": "stack",
        "children": [
          {
            "type": "icon",
            "id": "n9",
            "name": "check"
          },
          {
            "type": "heading",
            "id": "n7",
            "role": "success_headline",
            "text": "You are signed up"
          },
          {
            "type": "text",
            "id": "n8",
            "role": "success_body",
            "text": "Watch out for a message when the next drop lands."
          }
        ]
      }
    ]
  }
}
