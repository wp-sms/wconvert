{
  "id": "inline-one-line",
  "name": "One line in the page",
  "display_type": "inline",
  "tier": "free",
  "tokens": {
    "bg": "#f8fafc",
    "fg": "#1e293b",
    "muted": "#5a6b80",
    "accent": "#1d4ed8",
    "accent-fg": "#ffffff",
    "border": "#dbe3ec",
    "heading-size": "1.375rem",
    "radius": "0.625rem",
    "pad": "1.5rem 1.75rem",
    "gap": "0.875rem",
    "width": "100%",
    "align": "start",
    "shadow": "none",
    "tracking": "-0.02em"
  },
  "tree": {
    "steps": [
      {
        "type": "stack",
        "children": [
          {
            "type": "heading",
            "id": "n1",
            "role": "headline",
            "level": 2,
            "text": "Get the round-up"
          },
          {
            "type": "row",
            "children": [
              {
                "type": "field",
                "id": "n2",
                "name": "name",
                "label": "First name",
                "placeholder": "Alex",
                "required": false
              },
              {
                "type": "field",
                "id": "n3",
                "name": "email",
                "label": "Email address",
                "placeholder": "you@example.com",
                "required": true
              },
              {
                "type": "button",
                "id": "n4",
                "role": "cta_label",
                "label": "Join",
                "action": "submit"
              }
            ]
          },
          {
            "type": "consent",
            "id": "n5",
            "role": "consent_text",
            "hidden": true,
            "text": "Email me offers and news. See our %s.",
            "link": {
              "label": "Privacy Policy"
            }
          }
        ]
      },
      {
        "type": "stack",
        "children": [
          {
            "type": "icon",
            "id": "n8",
            "name": "check"
          },
          {
            "type": "heading",
            "id": "n6",
            "role": "success_headline",
            "level": 2,
            "text": "Thank you"
          },
          {
            "type": "text",
            "id": "n7",
            "role": "success_body",
            "text": "We have received your request for the next issue."
          }
        ]
      }
    ]
  }
}
