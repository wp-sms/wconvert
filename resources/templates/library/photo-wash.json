{
  "id": "photo-wash",
  "name": "Over a picture",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#1e293b",
    "fg": "#ffffff",
    "muted": "#e2e8f0",
    "accent": "#ffffff",
    "accent-fg": "#0f172a",
    "border": "rgba(255, 255, 255, 0.35)",
    "heading-size": "2.25rem",
    "heading-weight": "800",
    "leading": "1.3",
    "radius": "0.75rem",
    "pad": "clamp(1.25rem, 5%, 2rem)",
    "gap": "1rem",
    "width": "29rem",
    "align": "center",
    "bg-image": "linear-gradient(160deg, #0ea5e9 0%, #6366f1 60%, #a21caf 100%)",
    "overlay": "rgba(7,20,39,.65)",
    "shadow": "0 32px 80px -16px rgba(15, 23, 42, 0.5)",
    "backdrop": "rgba(2, 6, 23, 0.65)",
    "tracking": "-0.03em",
    "text-size": "1rem",
    "input-bg": "#ffffff"
  },
  "tree": {
    "steps": [
      {
        "id": "s1",
        "name": "Details",
        "kind": "input",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "heading",
              "id": "n1",
              "role": "headline",
              "text": "The new season has landed"
            },
            {
              "type": "text",
              "id": "n2",
              "role": "body",
              "text": "Join the list and see it before it goes anywhere else."
            },
            {
              "type": "field",
              "id": "n3",
              "name": "email",
              "label": "Email address",
              "placeholder": "you@example.com",
              "required": true,
              "tokens": {
                "fg": "#14283b",
                "muted": "#f3f6fc"
              }
            },
            {
              "type": "button",
              "id": "n4",
              "role": "cta_label",
              "label": "Show me first",
              "action": "submit",
              "submission": "primary"
            },
            {
              "type": "consent",
              "id": "n5",
              "role": "consent_text",
              "hidden": true,
              "text": "Email me offers and news. %s",
              "link": {
                "label": "Privacy Policy"
              },
              "tokens": {
                "text-size": "1.125rem"
              }
            },
            {
              "type": "text",
              "id": "n6",
              "role": "fine_print",
              "text": "Occasional collection notes. Unsubscribe any time.",
              "size": "s",
              "tokens": {
                "text-size": "1.167rem"
              }
            }
          ]
        }
      },
      {
        "id": "s2",
        "name": "Received",
        "kind": "acknowledgement",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "icon",
              "id": "n9",
              "name": "check"
            },
            {
              "type": "heading",
              "id": "n7",
              "role": "success_headline",
              "text": "Thanks for the interest"
            },
            {
              "type": "text",
              "id": "n8",
              "role": "success_body",
              "text": "We have received your request for first access."
            }
          ]
        }
      }
    ],
    "v": 2,
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n3"
        ],
        "consents": [
          "n5"
        ]
      }
    ]
  }
}
