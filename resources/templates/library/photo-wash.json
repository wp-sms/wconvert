{
  "id": "photo-wash",
  "name": "Over a picture",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#1e293b",
    "fg": "#ffffff",
    "muted": "#e2e8f0",
    "accent": "#ffffff",
    "accent-fg": "#0f172a",
    "border": "rgba(255, 255, 255, 0.35)",
    "heading-size": "2rem",
    "heading-weight": "800",
    "leading": "1.3",
    "radius": "0.75rem",
    "pad": "3rem 2.25rem",
    "gap": "1rem",
    "width": "29rem",
    "align": "center",
    "bg-image": "linear-gradient(160deg, #0ea5e9 0%, #6366f1 60%, #a21caf 100%)",
    "overlay": "rgba(2, 6, 23, 0.5)",
    "shadow": "0 24px 64px rgba(0, 0, 0, 0.3)",
    "backdrop": "rgba(2, 6, 23, 0.65)"
  },
  "tree": {
    "steps": [
      {
        "type": "stack",
        "children": [
          {
            "type": "heading",
            "id": "n1",
            "role": "headline",
            "text": "The new season has landed"
          },
          {
            "type": "text",
            "id": "n2",
            "role": "body",
            "text": "Join the list and see it before it goes anywhere else."
          },
          {
            "type": "field",
            "id": "n3",
            "name": "email",
            "label": "Email address",
            "placeholder": "you@example.com",
            "required": true
          },
          {
            "type": "button",
            "id": "n4",
            "role": "cta_label",
            "label": "Show me first",
            "action": "submit"
          },
          {
            "type": "consent",
            "id": "n5",
            "role": "consent_text",
            "hidden": true,
            "text": "Email me offers and news. See our %s.",
            "link": {
              "label": "Privacy Policy"
            }
          },
          {
            "type": "text",
            "id": "n6",
            "role": "fine_print",
            "text": "Swap the picture for your own on the Design tab."
          }
        ]
      },
      {
        "type": "stack",
        "children": [
          {
            "type": "heading",
            "id": "n7",
            "role": "success_headline",
            "text": "You are on the list"
          },
          {
            "type": "text",
            "id": "n8",
            "role": "success_body",
            "text": "You will see it before anyone else does."
          }
        ]
      }
    ]
  }
}
