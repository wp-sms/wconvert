{
  "id": "inline-cta",
  "name": "Inline call to action",
  "display_type": "inline",
  "tier": "free",
  "tokens": {
    "bg": "#fef2f2",
    "fg": "#450a0a",
    "muted": "#b91c1c",
    "accent": "#dc2626",
    "accent-fg": "#ffffff",
    "border": "#fecaca",
    "heading-size": "1.375rem",
    "radius": "0.5rem",
    "pad": "1.5rem",
    "gap": "0.875rem",
    "width": "34rem",
    "align": "center"
  },
  "tree": {
    "steps": [
      {
        "type": "stack",
        "children": [
          {
            "type": "heading",
            "role": "headline",
            "text": "The sale ends on Sunday"
          },
          {
            "type": "text",
            "role": "body",
            "text": "Everything reduced, while it lasts."
          },
          {
            "type": "button",
            "role": "cta_label",
            "label": "Shop the sale",
            "action": "link"
          },
          {
            "type": "text",
            "role": "fine_print",
            "text": "Discount applied at the checkout."
          }
        ]
      }
    ]
  }
}
