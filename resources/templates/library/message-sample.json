{
  "id": "message-sample",
  "name": "Message sample",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#ffffff",
    "fg": "#302641",
    "muted": "#635570",
    "accent": "#594176",
    "accent-fg": "#ffffff",
    "border": "#897696",
    "input-bg": "#ffffff",
    "heading-size": "1.875rem",
    "heading-weight": "600",
    "text-size": "1rem",
    "leading": "1.5",
    "pad": "0",
    "gap": "0",
    "radius": "0.75rem",
    "width": "48rem",
    "shadow": "none"
  },
  "tree": {
    "v": 2,
    "steps": [
      {
        "id": "details",
        "name": "Your details",
        "kind": "input",
        "content": {
          "type": "split",
          "ratio": 0.5,
          "basis": "16rem",
          "tokens": {
            "gap": "0"
          },
          "start": [
            {
              "type": "panel",
              "tokens": {
                "bg": "#eee8fa",
                "pad": "1.75rem",
                "gap": "1rem",
                "radius": "0"
              },
              "children": [
                {
                  "type": "eyebrow",
                  "id": "n1",
                  "role": "eyebrow",
                  "text": "A preview, before you decide"
                },
                {
                  "type": "heading",
                  "id": "n2",
                  "role": "headline",
                  "text": "A little news.\nBy text."
                },
                {
                  "type": "text",
                  "id": "n3",
                  "role": "body",
                  "text": "Collection news, up to twice a month."
                },
                {
                  "type": "panel",
                  "tokens": {
                    "bg": "#ffffff",
                    "pad": "1.25rem",
                    "gap": "0.75rem",
                    "radius": "0.75rem 0.75rem 0.75rem 0"
                  },
                  "children": [
                    {
                      "type": "eyebrow",
                      "id": "n4",
                      "role": "eyebrow",
                      "text": "Example message"
                    },
                    {
                      "type": "text",
                      "id": "n5",
                      "role": "body",
                      "text": "The new ceramic collection is here. Take a look when you have a moment."
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "n6",
                  "role": "fine_print",
                  "text": "An illustrative message, not a text we have sent.",
                  "size": "s",
                  "tokens": {
                    "text-size": "1.167rem"
                  }
                }
              ]
            }
          ],
          "end": [
            {
              "type": "panel",
              "tokens": {
                "bg": "#ffffff",
                "pad": "1.75rem",
                "gap": "1rem",
                "radius": "0"
              },
              "children": [
                {
                  "type": "heading",
                  "id": "n9",
                  "role": "headline",
                  "text": "Choose your updates.",
                  "tokens": {
                    "heading-size": "1.5rem"
                  }
                },
                {
                  "type": "field",
                  "id": "n7",
                  "name": "phone",
                  "label": "Mobile number",
                  "placeholder": "+44 7700 900000",
                  "required": true
                },
                {
                  "type": "consent",
                  "id": "n8",
                  "role": "consent_text",
                  "text": "Send me collection news by text, up to twice a month. I can opt out.",
                  "hidden": false,
                  "tokens": {
                    "text-size": "1.125rem"
                  }
                },
                {
                  "type": "button",
                  "id": "n10",
                  "role": "cta_label",
                  "label": "Request collection texts",
                  "action": "submit",
                  "submission": "primary"
                },
                {
                  "type": "text",
                  "id": "n11",
                  "role": "fine_print",
                  "text": "Message rates may apply. You can opt out of future texts.",
                  "size": "s",
                  "tokens": {
                    "text-size": "1.167rem"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "id": "received",
        "name": "Request received",
        "kind": "acknowledgement",
        "content": {
          "type": "panel",
          "tokens": {
            "bg": "#eee8fa",
            "pad": "1.75rem",
            "gap": "1rem",
            "radius": "0"
          },
          "children": [
            {
              "type": "eyebrow",
              "id": "n12",
              "role": "eyebrow",
              "text": "Request received"
            },
            {
              "type": "heading",
              "id": "n13",
              "role": "success_headline",
              "text": "Your text request is received."
            },
            {
              "type": "text",
              "id": "n14",
              "role": "success_body",
              "text": "Thank you. We have received your request for collection texts."
            }
          ]
        }
      }
    ],
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n7"
        ],
        "consents": [
          "n8"
        ]
      }
    ]
  }
}
