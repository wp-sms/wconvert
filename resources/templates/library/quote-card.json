{
  "id": "quote-card",
  "name": "A customer says",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#ffffff",
    "fg": "#111827",
    "muted": "#6b7280",
    "accent": "#1d4ed8",
    "accent-fg": "#ffffff",
    "border": "#e5e7eb",
    "font": "Georgia, 'Times New Roman', Times, serif",
    "heading-size": "1.5rem",
    "heading-weight": "400",
    "leading": "1.7",
    "radius": "0.75rem",
    "pad": "2.25rem",
    "gap": "1rem",
    "width": "30rem",
    "align": "start",
    "backdrop": "rgba(17, 24, 39, 0.55)",
    "shadow": "0 18px 50px -12px rgba(15, 23, 42, 0.35)"
  },
  "tree": {
    "steps": [
      {
        "type": "stack",
        "children": [
          {
            "type": "rating",
            "id": "n1",
            "value": 5,
            "role": "rating_text",
            "text": "1,400 reviews"
          },
          {
            "type": "heading",
            "id": "n2",
            "role": "headline",
            "text": "It arrived in two days and it is the only one I use now."
          },
          {
            "type": "row",
            "children": [
              {
                "type": "image",
                "id": "n3",
                "src": "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%201%201'%3E%3Cdefs%3E%3ClinearGradient%20id='g'%20x1='0'%20y1='0'%20x2='1'%20y2='1'%3E%3Cstop%20offset='0'%20stop-color='%230f766e'/%3E%3Cstop%20offset='1'%20stop-color='%235eead4'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width='1'%20height='1'%20fill='url%28%23g%29'/%3E%3Ccircle%20cx='0.5'%20cy='0.38'%20r='0.19'%20fill='%23f0fdfa'%20opacity='.95'/%3E%3Ccircle%20cx='0.5'%20cy='1.05'%20r='0.38'%20fill='%23f0fdfa'%20opacity='.95'/%3E%3C/svg%3E",
                "alt": "A photograph of a customer",
                "fit": "cover",
                "shape": "circle"
              },
              {
                "type": "text",
                "id": "n4",
                "role": "body",
                "text": "Priya, Manchester"
              }
            ]
          },
          {
            "type": "divider",
            "id": "n5"
          },
          {
            "type": "field",
            "id": "n6",
            "name": "email",
            "label": "Email address",
            "placeholder": "you@example.com",
            "required": true
          },
          {
            "type": "button",
            "id": "n7",
            "role": "cta_label",
            "label": "Send me the offer",
            "action": "submit"
          },
          {
            "type": "consent",
            "id": "n8",
            "role": "consent_text",
            "hidden": true,
            "text": "Email me offers and news. See our %s.",
            "link": {
              "label": "Privacy Policy"
            }
          },
          {
            "type": "text",
            "id": "n9",
            "role": "fine_print",
            "text": "No spam, and you can unsubscribe at any time."
          }
        ]
      },
      {
        "type": "stack",
        "children": [
          {
            "type": "icon",
            "id": "n12",
            "name": "check"
          },
          {
            "type": "heading",
            "id": "n10",
            "role": "success_headline",
            "text": "Request received"
          },
          {
            "type": "text",
            "id": "n11",
            "role": "success_body",
            "text": "Thank you. We have received your interest in the offer."
          }
        ]
      }
    ]
  }
}
