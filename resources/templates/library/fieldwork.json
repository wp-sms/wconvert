              {
                "type": "text",
                "id": "n8",
                "role": "fine_print",
                "size": "s",
                "text": "We will email your code \u2014 no newsletter unless you choose it.\nFirst order only. Excludes gift cards."
              }
            ]
          }
        ]
      },
      {
        "type": "split",
        "ratio": 0.35,
        "start": [
          {
            "type": "media",
