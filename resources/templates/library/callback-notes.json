{
  "id": "callback-notes",
  "name": "Callback notes",
  "display_type": "inline",
  "tier": "free",
  "tokens": {
    "bg": "#faf8f2",
    "fg": "#223c42",
    "muted": "#58696b",
    "accent": "#244d54",
    "accent-fg": "#ffffff",
    "border": "#a2b2b0",
    "input-bg": "#ffffff",
    "font": "system-ui, -apple-system, sans-serif",
    "heading-font": "Georgia, 'Times New Roman', serif",
    "heading-size": "2.25rem",
    "heading-weight": "400",
    "tracking": "-0.03em",
    "text-size": "1rem",
    "leading": "1.55",
    "radius": "0.375rem",
    "pad": "0",
    "gap": "0",
    "width": "48rem",
    "align": "start",
    "shadow": "none"
  },
  "tree": {
    "steps": [
      {
        "id": "s1",
        "name": "Details",
        "kind": "input",
        "content": {
          "type": "split",
          "ratio": 0.5,
          "start": [
            {
              "type": "panel",
              "tokens": {
                "bg": "accent",
                "fg": "accent-fg",
                "muted": "accent-fg",
                "pad": "2.25rem",
                "gap": "1.25rem",
                "radius": "0"
              },
              "narrow": {
                "pad": "1.5rem 1.25rem",
                "heading-size": "1.75rem",
                "gap": "0.875rem"
              },
              "children": [
                {
                  "type": "eyebrow",
                  "id": "n1",
                  "role": "eyebrow",
                  "text": "A conversation, to begin",
                  "tokens": {
                    "text-size": "1.0834rem"
                  }
                },
                {
                  "type": "heading",
                  "id": "n2",
                  "role": "headline",
                  "text": "Request a callback\nabout your project."
                },
                {
                  "type": "text",
                  "id": "n3",
                  "role": "body",
                  "text": "Leave your number to discuss your project and how we can help."
                }
              ]
            }
          ],
          "end": [
            {
              "type": "panel",
              "tokens": {
                "pad": "2rem",
                "gap": "0.875rem",
                "radius": "0"
              },
              "narrow": {
                "pad": "1.5rem 1.25rem"
              },
              "children": [
                {
                  "type": "field",
                  "id": "n6",
                  "name": "name",
                  "label": "Your name (optional)",
                  "placeholder": "Alex Morgan",
                  "required": false
                },
                {
                  "type": "field",
                  "id": "n7",
                  "name": "phone",
                  "label": "Phone number",
                  "placeholder": "+44 7700 900123",
                  "required": true
                },
                {
                  "type": "field",
                  "id": "n8",
                  "name": "interest",
                  "label": "What can we help with? (optional)",
                  "placeholder": "Choose a topic",
                  "required": false,
                  "options": [
                    {
                      "value": "new_project",
                      "label": "A new project"
                    },
                    {
                      "value": "improvement",
                      "label": "Improving something existing"
                    },
                    {
                      "value": "advice",
                      "label": "Help choosing the next step"
                    }
                  ]
                },
                {
                  "type": "consent",
                  "id": "n9",
                  "role": "consent_text",
                  "hidden": true,
                  "text": "I agree to a call about my request. %s",
                  "link": {
                    "label": "Privacy Policy"
                  },
                  "tokens": {
                    "text-size": "1.125rem"
                  }
                },
                {
                  "type": "text",
                  "id": "n10",
                  "role": "fine_print",
                  "size": "s",
                  "text": "We use your number to respond to this request. %s",
                  "link": {
                    "label": "Privacy Policy"
                  },
                  "tokens": {
                    "text-size": "1.167rem"
                  }
                },
                {
                  "type": "button",
                  "id": "n11",
                  "role": "cta_label",
                  "label": "Request my callback",
                  "action": "submit",
                  "submission": "primary"
                }
              ]
            }
          ],
          "basis": "16rem"
        }
      },
      {
        "id": "s2",
        "name": "Received",
        "kind": "acknowledgement",
        "content": {
          "type": "split",
          "ratio": 0.5,
          "start": [
            {
              "type": "panel",
              "tokens": {
                "bg": "accent",
                "fg": "accent-fg",
                "muted": "accent-fg",
                "pad": "2.25rem",
                "gap": "1.25rem",
                "radius": "0"
              },
              "narrow": {
                "pad": "1.5rem 1.25rem",
                "heading-size": "1.75rem",
                "gap": "0.875rem"
              },
              "children": [
                {
                  "type": "eyebrow",
                  "id": "n12",
                  "role": "eyebrow",
                  "text": "A conversation, to begin",
                  "tokens": {
                    "text-size": "1.0834rem"
                  }
                },
                {
                  "type": "heading",
                  "id": "n13",
                  "role": "success_headline",
                  "text": "Your request\nhas a place here."
                },
                {
                  "type": "text",
                  "id": "n14",
                  "role": "success_body",
                  "text": "Thank you for getting in touch about your project."
                }
              ]
            }
          ],
          "end": [
            {
              "type": "panel",
              "tokens": {
                "pad": "2rem",
                "gap": "1.125rem",
                "radius": "0"
              },
              "narrow": {
                "pad": "1.5rem 1.25rem"
              },
              "children": [
                {
                  "type": "icon",
                  "id": "n15",
                  "name": "check"
                },
                {
                  "type": "heading",
                  "id": "n16",
                  "role": "success_headline",
                  "level": 2,
                  "size": "s",
                  "text": "Callback request received"
                },
                {
                  "type": "text",
                  "id": "n17",
                  "role": "success_body",
                  "text": "We have received your details and your request for a call. This is not an appointment confirmation."
                },
                {
                  "type": "divider",
                  "id": "n18"
                },
                {
                  "type": "text",
                  "id": "n19",
                  "role": "fine_print",
                  "size": "s",
                  "text": "Your number is for responding to this enquiry.",
                  "tokens": {
                    "text-size": "1.167rem"
                  }
                }
              ]
            }
          ],
          "basis": "16rem"
        }
      }
    ],
    "v": 2,
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n6",
          "n7",
          "n8"
        ],
        "consents": [
          "n9"
        ]
      }
    ]
  }
}
