                  "role": "fine_print",
                  "size": "s",
                  "tokens": {
                    "text-size": "1.167rem"
                  }
                }
              ],
              "tokens": {
                "pad": "1.5rem 2rem",
                "bg": "#eef3f7",
                "gap": "1rem",
                "radius": "0"
