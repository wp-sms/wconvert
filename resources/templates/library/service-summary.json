                      ]
                    },
                    {
                      "type": "stack",
                      "children": [
                        {
                          "type": "eyebrow",
                          "id": "n6",
                          "text": "02 / Usability",
                          "role": "eyebrow"
                        },
                        {
                          "type": "text",
                          "id": "n7",
                          "text": "Can they take the next step?",
                          "role": "body"
                        }
                      ]
                    }
                  ],
                  "tokens": {
                    "gap": "1.25rem"
                  }
                }
              ],
              "tokens": {
                "pad": "2rem",
                "gap": "1.25rem"
              },
              "narrow": {
                "pad": "1.25rem"
              }
