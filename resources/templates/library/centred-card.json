{
  "id": "centred-card",
  "name": "Centred card",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#ffffff",
    "fg": "#111827",
    "muted": "#6b7280",
    "accent": "#111827",
    "accent-fg": "#ffffff",
    "border": "#e5e7eb",
    "heading-size": "1.75rem",
    "radius": "0.875rem",
    "pad": "clamp(1.25rem, 5%, 2rem)",
    "gap": "1rem",
    "width": "26rem",
    "align": "center",
    "backdrop": "rgba(15, 23, 42, 0.55)",
    "shadow": "0 18px 50px -12px rgba(15, 23, 42, 0.35)",
    "tracking": "-0.02em",
    "text-size": "1rem"
  },
  "tree": {
    "steps": [
      {
        "id": "s1",
        "name": "Details",
        "kind": "input",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "heading",
              "id": "n1",
              "role": "headline",
              "text": "Five good reads. Every Friday."
            },
            {
              "type": "text",
              "id": "n2",
              "role": "body",
              "text": "A short selection of stories worth your time. Free, once a week."
            },
            {
              "type": "stack",
              "children": [
                {
                  "type": "field",
                  "id": "n3",
                  "name": "email",
                  "label": "Email address",
                  "placeholder": "you@example.com",
                  "required": true,
                  "tokens": {
                    "border": "#8790a3"
                  }
                },
                {
                  "type": "button",
                  "id": "n4",
                  "role": "cta_label",
                  "label": "Send me the Friday reads",
                  "action": "submit",
                  "submission": "primary"
                }
              ]
            },
            {
              "type": "consent",
              "id": "n5",
              "role": "consent_text",
              "hidden": true,
              "text": "Send me the Friday reads. %s",
              "link": {
                "label": "Privacy Policy"
              },
              "tokens": {
                "text-size": "1.125rem"
              }
            },
            {
              "type": "text",
              "id": "n6",
              "role": "fine_print",
              "text": "One email each Friday. Unsubscribe any time.",
              "size": "s",
              "tokens": {
                "text-size": "1.167rem"
              }
            }
          ]
        }
      },
      {
        "id": "s2",
        "name": "Received",
        "kind": "acknowledgement",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "icon",
              "id": "n9",
              "name": "check"
            },
            {
              "type": "heading",
              "id": "n7",
              "role": "success_headline",
              "text": "Thank you"
            },
            {
              "type": "text",
              "id": "n8",
              "role": "success_body",
              "text": "We have received your request for the Friday reads."
            }
          ]
        }
      }
    ],
    "v": 2,
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n3"
        ],
        "consents": [
          "n5"
        ]
      }
    ]
  }
}
