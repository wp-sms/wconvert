{
  "id": "bold-ask",
  "name": "Bold ask",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#fafaf9",
    "fg": "#0c0a09",
    "muted": "#57534e",
    "accent": "#0c0a09",
    "accent-fg": "#fafaf9",
    "border": "#0c0a09",
    "heading-size": "3.25rem",
    "heading-weight": "800",
    "tracking": "-0.045em",
    "leading": "1.3",
    "radius": "0rem",
    "pad": "clamp(1.25rem, 5%, 2rem)",
    "gap": "1.5rem",
    "width": "30rem",
    "align": "start",
    "shadow": "0 4px 12px -2px rgba(15, 23, 42, 0.12), 0 12px 32px -8px rgba(15, 23, 42, 0.18)",
    "backdrop": "rgba(12, 10, 9, 0.6)",
    "text-size": "1rem",
    "input-bg": "#ffffff"
  },
  "tree": {
    "steps": [
      {
        "id": "s1",
        "name": "Details",
        "kind": "input",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "heading",
              "id": "n1",
              "role": "headline",
              "text": "One good idea. Every week.",
              "tokens": {
                "heading-size": "clamp(2.25rem, 10cqi, 3.25rem)"
              }
            },
            {
              "type": "field",
              "id": "n2",
              "name": "email",
              "label": "Email address",
              "placeholder": "you@example.com",
              "required": true
            },
            {
              "type": "button",
              "id": "n3",
              "role": "cta_label",
              "label": "Send me the weekly idea",
              "action": "submit",
              "submission": "primary"
            },
            {
              "type": "consent",
              "id": "n4",
              "role": "consent_text",
              "hidden": true,
              "text": "Email me offers and news. %s",
              "link": {
                "label": "Privacy Policy"
              },
              "tokens": {
                "text-size": "1.125rem"
              }
            },
            {
              "type": "text",
              "id": "n8",
              "role": "fine_print",
              "text": "Weekly emails. %s",
              "size": "s",
              "link": {
                "label": "Privacy Policy"
              }
            }
          ]
        }
      },
      {
        "id": "s2",
        "name": "Received",
        "kind": "acknowledgement",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "icon",
              "id": "n7",
              "name": "check"
            },
            {
              "type": "heading",
              "id": "n5",
              "role": "success_headline",
              "text": "Request received.",
              "tokens": {
                "heading-size": "clamp(2.25rem, 10cqi, 3.25rem)"
              }
            },
            {
              "type": "text",
              "id": "n6",
              "role": "success_body",
              "text": "Thank you for asking for the next weekly idea."
            }
          ]
        }
      }
    ],
    "v": 2,
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n2"
        ],
        "consents": [
          "n4"
        ]
      }
    ]
  }
}
