{
  "id": "bold-ask",
  "name": "Bold ask",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#fafaf9",
    "fg": "#0c0a09",
    "muted": "#57534e",
    "accent": "#0c0a09",
    "accent-fg": "#fafaf9",
    "border": "#0c0a09",
    "heading-size": "2.75rem",
    "heading-weight": "800",
    "tracking": "-0.02em",
    "leading": "1.3",
    "radius": "0rem",
    "pad": "2.75rem",
    "gap": "1.5rem",
    "width": "30rem",
    "align": "start",
    "shadow": "none",
    "backdrop": "rgba(12, 10, 9, 0.6)"
  },
  "tree": {
    "steps": [
      {
        "type": "stack",
        "children": [
          {
            "type": "heading",
            "id": "n1",
            "role": "headline",
            "text": "Read this weekly."
          },
          {
            "type": "field",
            "id": "n2",
            "name": "email",
            "label": "Email address",
            "placeholder": "you@example.com",
            "required": true
          },
          {
            "type": "button",
            "id": "n3",
            "role": "cta_label",
            "label": "Subscribe",
            "action": "submit"
          },
          {
            "type": "consent",
            "id": "n4",
            "role": "consent_text",
            "hidden": true,
            "text": "Email me offers and news. See our %s.",
            "link": {
              "label": "Privacy Policy"
            }
          }
        ]
      },
      {
        "type": "stack",
        "children": [
          {
            "type": "heading",
            "id": "n5",
            "role": "success_headline",
            "text": "Done."
          },
          {
            "type": "text",
            "id": "n6",
            "role": "success_body",
            "text": "Friday is the next one."
          }
        ]
      }
    ]
  }
}
