{
  "id": "offer-panel",
  "name": "Offer panel",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#0f172a",
    "fg": "#f8fafc",
    "muted": "#94a3b8",
    "accent": "#f59e0b",
    "accent-fg": "#1c1917",
    "border": "#1e293b",
    "heading-size": "1.875rem",
    "radius": "1rem",
    "pad": "2.5rem",
    "gap": "1rem",
    "width": "30rem",
    "align": "center",
    "backdrop": "rgba(2, 6, 23, 0.7)"
  },
  "tree": {
    "steps": [
      {
        "type": "stack",
        "children": [
          { "type": "heading", "role": "headline", "text": "Midseason sale" },
          { "type": "text", "role": "body", "text": "Everything reduced for the next three days." },
          { "type": "button", "role": "cta_label", "label": "Shop the sale", "action": "link" },
          { "type": "text", "role": "fine_print", "text": "Discount applied at the checkout." }
        ]
      }
    ]
  }
}
