{
  "id": "offer-panel",
  "name": "Offer panel",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#0b1220",
    "fg": "#f8fafc",
    "muted": "#93a4c4",
    "accent": "#fbbf24",
    "accent-fg": "#1c1204",
    "border": "#2b3b5c",
    "heading-size": "2.125rem",
    "radius": "1rem",
    "pad": "clamp(1.25rem, 5%, 2rem)",
    "gap": "1rem",
    "width": "30rem",
    "align": "center",
    "backdrop": "rgba(2, 6, 23, 0.7)",
    "shadow": "0 32px 80px -16px rgba(15, 23, 42, 0.5)",
    "tracking": "-0.025em",
    "bg-image": "linear-gradient(160deg, #0b1220 0%, #16233d 60%, #1e3a5f 100%)",
    "text-size": "1rem"
  },
  "tree": {
    "steps": [
      {
        "type": "stack",
        "children": [
          {
            "type": "heading",
            "id": "n1",
            "role": "headline",
            "text": "Midseason sale"
          },
          {
            "type": "text",
            "id": "n2",
            "role": "body",
            "text": "Selected favourites from the collection, for less."
          },
          {
            "type": "button",
            "id": "n3",
            "role": "cta_label",
            "label": "Shop the sale",
            "action": "link"
          },
          {
            "type": "text",
            "id": "n4",
            "role": "fine_print",
            "text": "Selected items only. Prices as marked.",
            "size": "s",
            "tokens": {
              "text-size": "1.167rem"
            }
          }
        ]
      }
    ]
  }
}
