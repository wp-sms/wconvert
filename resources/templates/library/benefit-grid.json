{
  "id": "benefit-grid",
  "name": "Three reasons",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#ffffff",
    "fg": "#0f172a",
    "muted": "#475569",
    "accent": "#0f766e",
    "accent-fg": "#ffffff",
    "border": "#788b96",
    "heading-size": "1.75rem",
    "radius": "0.75rem",
    "pad": "clamp(1.25rem, 5%, 2rem)",
    "gap": "1.125rem",
    "width": "32rem",
    "align": "start",
    "backdrop": "rgba(15, 23, 42, 0.6)",
    "shadow": "0 18px 50px -12px rgba(15, 23, 42, 0.35)",
    "tracking": "-0.025em",
    "text-size": "1rem"
  },
  "tree": {
    "steps": [
      {
        "id": "s1",
        "name": "Details",
        "kind": "input",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "heading",
              "id": "n1",
              "role": "headline",
              "text": "Three good things. Every Thursday."
            },
            {
              "type": "text",
              "id": "n2",
              "role": "body",
              "text": "A short weekly note to make something of your next idea."
            },
            {
              "type": "panel",
              "tokens": {
                "bg": "#f0f6f4",
                "pad": "1rem 1.125rem",
                "gap": "0.625rem",
                "radius": "0.5rem"
              },
              "children": [
                {
                  "type": "text",
                  "id": "n4",
                  "role": "body",
                  "text": "One great read"
                },
                {
                  "type": "text",
                  "id": "n6",
                  "role": "body",
                  "text": "One usable idea"
                },
                {
                  "type": "text",
                  "id": "n8",
                  "role": "body",
                  "text": "One practical resource"
                }
              ]
            },
            {
              "type": "field",
              "id": "n9",
              "name": "email",
              "label": "Email address",
              "placeholder": "you@example.com",
              "required": true,
              "tokens": {
                "radius": "0.375rem"
              }
            },
            {
              "type": "button",
              "id": "n10",
              "role": "cta_label",
              "label": "Send me the weekly note",
              "action": "submit",
              "submission": "primary",
              "tokens": {
                "radius": "0.375rem"
              }
            },
            {
              "type": "consent",
              "id": "n11",
              "role": "consent_text",
              "hidden": true,
              "text": "Email me offers and news. %s",
              "link": {
                "label": "Privacy Policy"
              },
              "tokens": {
                "text-size": "1.125rem"
              }
            },
            {
              "type": "text",
              "id": "n12",
              "role": "fine_print",
              "text": "Unsubscribe in one click, any time.",
              "size": "s",
              "tokens": {
                "text-size": "1.167rem"
              }
            }
          ]
        }
      },
      {
        "id": "s2",
        "name": "Received",
        "kind": "acknowledgement",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "icon",
              "id": "n15",
              "name": "check"
            },
            {
              "type": "heading",
              "id": "n13",
              "role": "success_headline",
              "text": "Request received"
            },
            {
              "type": "text",
              "id": "n14",
              "role": "success_body",
              "text": "We have received your request for the weekly round-up."
            }
          ]
        }
      }
    ],
    "v": 2,
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n9"
        ],
        "consents": [
          "n11"
        ]
      }
    ]
  }
}
