{
  "id": "journey-offer-first",
  "name": "An invitation before signup",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#ffffff",
    "fg": "#252c26",
    "muted": "#596158",
    "accent": "#244b38",
    "border": "#c5cbc1",
    "accent-fg": "#ffffff",
    "input-bg": "#ffffff",
    "heading-font": "Georgia, serif",
    "heading-size": "2rem",
    "heading-weight": "400",
    "tracking": "-0.035em",
    "text-size": "1rem",
    "leading": "1.5",
    "radius": "0.875rem",
    "pad": "1.75rem",
    "gap": "1rem",
    "width": "29rem",
    "shadow": "0 20px 56px -20px rgba(28,42,31,.3)"
  },
  "tree": {
    "v": 2,
    "submissions": [
      {
        "id": "email-signup",
        "required": true,
        "fields": [
          "n6"
        ],
        "consents": [
          "n7"
        ]
      }
    ],
    "steps": [
      {
        "id": "offer",
        "name": "Invitation",
        "kind": "content",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "eyebrow",
              "id": "n11",
              "role": "eyebrow",
              "text": "Behind the making"
            },
            {
              "type": "heading",
              "id": "n1",
              "role": "headline",
              "text": "A closer look at how it is made."
            },
            {
              "type": "text",
              "id": "n2",
              "role": "body",
              "text": "Occasional email invitations to maker demonstrations, with details when announced."
            },
            {
              "type": "row",
              "children": [
                {
                  "type": "button",
                  "id": "n3",
                  "role": "next_label",
                  "label": "Tell me more",
                  "action": "next"
                },
                {
                  "type": "button",
                  "id": "n4",
                  "role": "close_label",
                  "label": "Maybe later",
                  "action": "close",
                  "tokens": {
                    "accent": "transparent",
                    "accent-fg": "muted"
                  }
                }
              ],
              "tokens": {
                "gap": "0.5rem"
              }
            }
          ],
          "narrow": {
            "pad": "1.25rem",
            "heading-size": "1.875rem"
          }
        }
      },
      {
        "id": "email",
        "name": "Email signup",
        "kind": "input",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "eyebrow",
              "id": "n12",
              "role": "eyebrow",
              "text": "A little closer to the craft"
            },
            {
              "type": "heading",
              "id": "n5",
              "role": "headline",
              "text": "Get maker-session news."
            },
            {
              "type": "field",
              "id": "n6",
              "name": "email",
              "label": "Email address",
              "required": true,
              "placeholder": "you@example.com",
              "tokens": {
                "border": "#87937f"
              }
            },
            {
              "type": "consent",
              "id": "n7",
              "role": "consent_text",
              "hidden": false,
              "text": "Email me maker-session announcements. I can unsubscribe anytime.",
              "tokens": {
                "text-size": "1.125rem"
              }
            },
            {
              "type": "button",
              "id": "n8",
              "role": "cta_label",
              "label": "Request session news",
              "action": "submit",
              "submission": "email-signup"
            }
          ]
        }
      },
      {
        "id": "received",
        "name": "Acknowledgement",
        "kind": "acknowledgement",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "icon",
              "id": "n13",
              "name": "check"
            },
            {
              "type": "heading",
              "id": "n9",
              "role": "success_headline",
              "text": "Details received"
            },
            {
              "type": "text",
              "id": "n10",
              "role": "success_body",
              "text": "Thank you. We have received the details you submitted."
            }
          ]
        }
      }
    ]
  }
}
