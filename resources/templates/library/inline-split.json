{
  "id": "inline-split",
  "name": "Inline split",
  "display_type": "inline",
  "tier": "free",
  "tokens": {
    "bg": "#ffffff",
    "fg": "#1f2937",
    "muted": "#6b7280",
    "accent": "#4f46e5",
    "accent-fg": "#ffffff",
    "border": "#e5e7eb",
    "heading-size": "1.5rem",
    "radius": "0.75rem",
    "pad": "1.5rem",
    "gap": "1.25rem",
    "width": "44rem",
    "align": "start",
    "shadow": "none",
    "tracking": "-0.02em",
    "text-size": "1rem"
  },
  "tree": {
    "steps": [
      {
        "id": "s1",
        "name": "Details",
        "kind": "input",
        "content": {
          "type": "split",
          "ratio": 0.35,
          "start": [
            {
              "type": "image",
              "id": "n1",
              "src": "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20320%20140%22%3E%3Crect%20width%3D%22320%22%20height%3D%22140%22%20rx%3D%2212%22%20fill%3D%22%23e9ede4%22%2F%3E%3Crect%20x%3D%22104%22%20y%3D%2214%22%20width%3D%22112%22%20height%3D%22112%22%20rx%3D%225%22%20fill%3D%22%23fffdf6%22%2F%3E%3Cpath%20d%3D%22M126%2042h62M126%2058h44M146%2082h42M146%20100h32%22%20stroke%3D%22%2372806a%22%20stroke-width%3D%225%22%20stroke-linecap%3D%22round%22%2F%3E%3Cpath%20d%3D%22m125%2081%204%204%207-9m-11%2024%204%204%207-9%22%20fill%3D%22none%22%20stroke%3D%22%233c634b%22%20stroke-width%3D%223%22%2F%3E%3C%2Fsvg%3E",
              "alt": "Original illustration of a guide with a short checklist",
              "fit": "cover"
            }
          ],
          "end": [
            {
              "type": "stack",
              "children": [
                {
                  "type": "heading",
                  "id": "n2",
                  "role": "headline",
                  "text": "A clearer start. One useful guide."
                },
                {
                  "type": "text",
                  "id": "n3",
                  "role": "body",
                  "text": "Practical steps and a printable checklist for your next project."
                },
                {
                  "type": "field",
                  "id": "n4",
                  "name": "email",
                  "label": "Email address",
                  "placeholder": "you@example.com",
                  "required": true,
                  "tokens": {
                    "border": "#8790a3"
                  }
                },
                {
                  "type": "button",
                  "id": "n5",
                  "role": "cta_label",
                  "label": "Request the guide",
                  "action": "submit",
                  "submission": "primary"
                },
                {
                  "type": "consent",
                  "id": "n6",
                  "role": "consent_text",
                  "hidden": true,
                  "text": "Use my email for this guide request. %s",
                  "link": {
                    "label": "Privacy Policy"
                  },
                  "tokens": {
                    "text-size": "1.125rem"
                  }
                },
                {
                  "type": "text",
                  "id": "n10",
                  "role": "fine_print",
                  "text": "One guide request. No newsletter signup. %s",
                  "size": "s",
                  "link": {
                    "label": "Privacy Policy"
                  }
                }
              ]
            }
          ],
          "basis": "16rem"
        }
      },
      {
        "id": "s2",
        "name": "Received",
        "kind": "acknowledgement",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "icon",
              "id": "n9",
              "name": "check"
            },
            {
              "type": "heading",
              "id": "n7",
              "role": "success_headline",
              "text": "Request received"
            },
            {
              "type": "text",
              "id": "n8",
              "role": "success_body",
              "text": "Thank you. We have received your request for the guide."
            }
          ]
        }
      }
    ],
    "v": 2,
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n4"
        ],
        "consents": [
          "n6"
        ]
      }
    ]
  }
}
