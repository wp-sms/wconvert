{
  "id": "inline-split",
  "name": "Inline split",
  "display_type": "inline",
  "tier": "free",
  "tokens": {
    "bg": "#ffffff",
    "fg": "#1f2937",
    "muted": "#6b7280",
    "accent": "#4f46e5",
    "accent-fg": "#ffffff",
    "border": "#e5e7eb",
    "heading-size": "1.5rem",
    "radius": "0.75rem",
    "pad": "1.5rem",
    "gap": "1.25rem",
    "width": "44rem",
    "align": "start",
    "shadow": "none",
    "tracking": "-0.02em",
    "text-size": "1rem"
  },
  "tree": {
    "steps": [
      {
        "type": "split",
        "ratio": 0.35,
        "start": [
          {
            "type": "image",
            "id": "n1",
            "src": "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%203%201.5'%3E%3Cdefs%3E%3ClinearGradient%20id='g'%20x1='0'%20y1='0'%20x2='1'%20y2='1'%3E%3Cstop%20offset='0'%20stop-color='%2314532d'/%3E%3Cstop%20offset='.55'%20stop-color='%2315803d'/%3E%3Cstop%20offset='1'%20stop-color='%2386efac'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width='3'%20height='4'%20fill='url%28%23g%29'/%3E%3Ccircle%20cx='0.85'%20cy='1.1'%20r='0.6'%20fill='%23dcfce7'%20opacity='.55'/%3E%3Ccircle%20cx='2.2'%20cy='2.8'%20r='0.9'%20fill='%234ade80'%20opacity='.5'/%3E%3C/svg%3E",
            "alt": "Image placeholder",
            "fit": "cover"
          }
        ],
        "end": [
          {
            "type": "stack",
            "children": [
              {
                "type": "heading",
                "id": "n2",
                "role": "headline",
                "text": "A clearer start. One useful guide."
              },
              {
                "type": "text",
                "id": "n3",
                "role": "body",
                "text": "Practical steps and a printable checklist for your next project."
              },
              {
                "type": "field",
                "id": "n4",
                "name": "email",
                "label": "Email address",
                "placeholder": "you@example.com",
                "required": true
              },
              {
                "type": "button",
                "id": "n5",
                "role": "cta_label",
                "label": "Request the guide",
                "action": "submit"
              },
              {
                "type": "consent",
                "id": "n6",
                "role": "consent_text",
                "hidden": true,
                "text": "Email me offers and news. %s",
                "link": {
                  "label": "Privacy Policy"
                },
                "tokens": {
                  "text-size": "1.125rem"
                }
              }
            ]
          }
        ],
        "basis": "16rem"
      },
      {
        "type": "stack",
        "children": [
          {
            "type": "icon",
            "id": "n9",
            "name": "check"
          },
          {
            "type": "heading",
            "id": "n7",
            "role": "success_headline",
            "text": "Request received"
          },
          {
            "type": "text",
            "id": "n8",
            "role": "success_body",
            "text": "Thank you. We have received your request for the guide."
          }
        ]
      }
    ]
  }
}
