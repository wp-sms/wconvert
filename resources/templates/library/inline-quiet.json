{
  "id": "inline-quiet",
  "name": "Quiet, in the flow",
  "display_type": "inline",
  "tier": "free",
  "tokens": {
    "bg": "#fdfdfc",
    "fg": "#111827",
    "muted": "#6b7280",
    "accent": "#111827",
    "accent-fg": "#ffffff",
    "border": "#e7e5e4",
    "font": "Georgia, 'Times New Roman', Times, serif",
    "heading-size": "1.5rem",
    "heading-weight": "600",
    "leading": "1.7",
    "radius": "0.5rem",
    "pad": "1.75rem",
    "gap": "0.875rem",
    "width": "100%",
    "align": "start",
    "shadow": "none",
    "tracking": "-0.02em",
    "text-size": "1rem"
  },
  "tree": {
    "steps": [
      {
        "id": "s1",
        "name": "Details",
        "kind": "input",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "divider",
              "id": "n1"
            },
            {
              "type": "heading",
              "id": "n2",
              "role": "headline",
              "level": 2,
              "text": "A good read, once a week."
            },
            {
              "type": "text",
              "id": "n3",
              "role": "body",
              "text": "One thoughtful story to carry into the weekend."
            },
            {
              "type": "row",
              "children": [
                {
                  "type": "field",
                  "id": "n4",
                  "name": "email",
                  "label": "Email address",
                  "placeholder": "you@example.com",
                  "required": true,
                  "tokens": {
                    "border": "#958c87"
                  }
                },
                {
                  "type": "button",
                  "id": "n5",
                  "role": "cta_label",
                  "label": "Send me the weekly story",
                  "action": "submit",
                  "submission": "primary"
                }
              ]
            },
            {
              "type": "consent",
              "id": "n6",
              "role": "consent_text",
              "hidden": true,
              "text": "Email me offers and news. %s",
              "link": {
                "label": "Privacy Policy"
              },
              "tokens": {
                "text-size": "1.125rem"
              }
            },
            {
              "type": "divider",
              "id": "n7"
            }
          ]
        }
      },
      {
        "id": "s2",
        "name": "Received",
        "kind": "acknowledgement",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "divider",
              "id": "n8"
            },
            {
              "type": "heading",
              "id": "n9",
              "role": "success_headline",
              "level": 2,
              "text": "Thank you"
            },
            {
              "type": "text",
              "id": "n10",
              "role": "success_body",
              "text": "We have received your request. Enjoy the rest of your reading."
            },
            {
              "type": "divider",
              "id": "n11"
            }
          ]
        }
      }
    ],
    "v": 2,
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n4"
        ],
        "consents": [
          "n6"
        ]
      }
    ]
  }
}
