{
  "id": "wide-banner",
  "name": "Wide banner",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#f8fafc",
    "fg": "#0f172a",
    "muted": "#475569",
    "accent": "#0f172a",
    "accent-fg": "#ffffff",
    "border": "#cbd5e1",
    "heading-size": "1.75rem",
    "heading-weight": "700",
    "radius": "0.25rem",
    "pad": "clamp(1.25rem, 5%, 2rem)",
    "gap": "0.875rem",
    "width": "40rem",
    "align": "start",
    "shadow": "0 4px 12px -2px rgba(15, 23, 42, 0.12), 0 12px 32px -8px rgba(15, 23, 42, 0.18)",
    "backdrop": "rgba(15, 23, 42, 0.45)",
    "tracking": "-0.02em",
    "text-size": "1rem",
    "input-bg": "#ffffff"
  },
  "tree": {
    "steps": [
      {
        "id": "s1",
        "name": "Details",
        "kind": "input",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "heading",
              "id": "n1",
              "role": "headline",
              "text": "The weekly round-up"
            },
            {
              "type": "text",
              "id": "n2",
              "role": "body",
              "text": "Five worthwhile links, every Thursday."
            },
            {
              "type": "row",
              "children": [
                {
                  "type": "field",
                  "id": "n3",
                  "name": "email",
                  "label": "Email address",
                  "placeholder": "you@example.com",
                  "required": true,
                  "tokens": {
                    "border": "#738eaf"
                  }
                },
                {
                  "type": "button",
                  "id": "n4",
                  "role": "cta_label",
                  "label": "Send me the round-up",
                  "action": "submit",
                  "submission": "primary"
                }
              ]
            },
            {
              "type": "consent",
              "id": "n5",
              "role": "consent_text",
              "hidden": true,
              "text": "Email me offers and news. %s",
              "link": {
                "label": "Privacy Policy"
              },
              "tokens": {
                "text-size": "1.125rem"
              }
            },
            {
              "type": "text",
              "id": "n6",
              "role": "fine_print",
              "text": "Unsubscribe in one click, any time.",
              "size": "s",
              "tokens": {
                "text-size": "1.167rem"
              }
            }
          ]
        }
      },
      {
        "id": "s2",
        "name": "Received",
        "kind": "acknowledgement",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "icon",
              "id": "n9",
              "name": "check"
            },
            {
              "type": "heading",
              "id": "n7",
              "role": "success_headline",
              "text": "Thank you"
            },
            {
              "type": "text",
              "id": "n8",
              "role": "success_body",
              "text": "We have received your request for the weekly round-up."
            }
          ]
        }
      }
    ],
    "v": 2,
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n3"
        ],
        "consents": [
          "n5"
        ]
      }
    ]
  }
}
