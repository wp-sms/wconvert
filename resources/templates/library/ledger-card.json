{
  "id": "ledger-card",
  "name": "Ledger card",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#f7f5f0",
    "fg": "#1c1a17",
    "muted": "#5e594f",
    "accent": "#1c1a17",
    "accent-fg": "#f7f5f0",
    "border": "#827a6c",
    "input-bg": "#ffffff",
    "font": "'Helvetica Neue', Helvetica, Arial, sans-serif",
    "heading-font": "Georgia, 'Times New Roman', Times, serif",
    "heading-size": "1.375rem",
    "heading-weight": "400",
    "tracking": "-0.025em",
    "text-size": "1rem",
    "leading": "1.5",
    "radius": "0",
    "pad": "clamp(1.25rem, 5%, 2rem)",
    "gap": "1rem",
    "width": "30rem",
    "align": "start",
    "shadow": "0 1px 2px rgba(28, 26, 23, 0.08)",
    "backdrop": "rgba(28, 26, 23, 0.45)"
  },
  "tree": {
    "steps": [
      {
        "id": "s1",
        "name": "Details",
        "kind": "input",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "eyebrow",
              "id": "n1",
              "role": "wordmark",
              "text": "The Friday letter",
              "tokens": {
                "text-size": "1.0834rem"
              }
            },
            {
              "type": "heading",
              "id": "n2",
              "role": "headline",
              "size": "xl",
              "text": "One long read, every Friday",
              "narrow": {
                "heading-size": "1.125rem"
              }
            },
            {
              "type": "stack",
              "tokens": {
                "gap": "0.5rem"
              },
              "children": [
                {
                  "type": "text",
                  "id": "n4",
                  "role": "body",
                  "text": "Eight minutes, no more.",
                  "tokens": {
                    "text-size": "1rem"
                  }
                },
                {
                  "type": "text",
                  "id": "n6",
                  "role": "body",
                  "text": "One idea to try.",
                  "tokens": {
                    "text-size": "1rem"
                  }
                },
                {
                  "type": "text",
                  "id": "n8",
                  "role": "body",
                  "text": "One click to leave.",
                  "tokens": {
                    "text-size": "1rem"
                  }
                }
              ]
            },
            {
              "type": "divider",
              "id": "n9",
              "tokens": {
                "border": "#d8d1c5"
              }
            },
            {
              "type": "stack",
              "children": [
                {
                  "type": "field",
                  "id": "n10",
                  "name": "email",
                  "label": "Email address",
                  "placeholder": "you@example.com",
                  "required": true,
                  "tokens": {
                    "radius": "0.375rem"
                  }
                },
                {
                  "type": "button",
                  "id": "n11",
                  "role": "cta_label",
                  "label": "Send me the Friday letter",
                  "action": "submit",
                  "submission": "primary",
                  "tokens": {
                    "radius": "0.375rem"
                  }
                }
              ]
            },
            {
              "type": "consent",
              "id": "n12",
              "role": "consent_text",
              "hidden": true,
              "text": "Email me offers and news. %s",
              "link": {
                "label": "Privacy Policy"
              },
              "tokens": {
                "text-size": "1.125rem"
              }
            },
            {
              "type": "text",
              "id": "n13",
              "role": "fine_print",
              "size": "s",
              "text": "No spam, and you can unsubscribe at any time.",
              "tokens": {
                "text-size": "1.167rem"
              }
            }
          ]
        }
      },
      {
        "id": "s2",
        "name": "Received",
        "kind": "acknowledgement",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "heading",
              "id": "n14",
              "role": "success_headline",
              "size": "xl",
              "text": "Request received"
            },
            {
              "type": "text",
              "id": "n15",
              "role": "success_body",
              "text": "Thank you for asking to receive the letter."
            }
          ]
        }
      }
    ],
    "v": 2,
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n10"
        ],
        "consents": [
          "n12"
        ]
      }
    ]
  }
}
