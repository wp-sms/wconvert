{
  "id": "trail-window",
  "name": "Trail window",
  "display_type": "popup",
  "tier": "free",
  "tokens": {
    "bg": "#fffbed",
    "fg": "#263c2f",
    "muted": "#4d6254",
    "accent": "#bd4121",
    "accent-fg": "#ffffff",
    "border": "#75856d",
    "input-bg": "#ffffff",
    "heading-size": "2.25rem",
    "heading-weight": "400",
    "text-size": "1rem",
    "leading": "1.5",
    "tracking": "-0.025em",
    "pad": "1.5rem",
    "gap": "1rem",
    "radius": "2rem",
    "width": "33rem",
    "shadow": "0 20px 64px -24px rgba(20,30,25,.28)",
    "align": "center",
    "heading-font": "Georgia, serif"
  },
  "tree": {
    "v": 2,
    "steps": [
      {
        "id": "invitation",
        "name": "A little more outside",
        "kind": "content",
        "content": {
          "type": "stack",
          "children": [
            {
              "type": "image",
              "id": "n1",
              "src": "artwork:81955bc85c420cc2c9a6ab479679367d9f3914752a2d3d02c3f3d00781e45df0.webp",
              "alt": "Fictional mountain landscape with a winding walking path.",
              "fit": "contain",
              "tokens": {
                "radius": "50% 50% .5rem .5rem"
              }
            },
            {
              "type": "heading",
              "id": "n2",
              "text": "Take the\nscenic route.",
              "role": "headline",
              "tokens": {
                "heading-font": "Georgia, serif",
                "heading-size": "3rem",
                "heading-weight": "400",
                "leading": "1.05"
              },
              "narrow": {
                "heading-size": "2.5rem"
              }
            },
            {
              "type": "text",
              "id": "n3",
              "text": "A small guide to planning a slower day outdoors: what to bring, what to notice and how to leave less behind.",
              "role": "body"
            },
            {
              "type": "button",
              "id": "n4",
              "label": "I would like the guide",
              "action": "next",
              "role": "next_label",
              "tokens": {
                "radius": ".75rem"
              }
            }
          ],
          "tokens": {
            "gap": "1rem"
          }
        }
      },
      {
        "id": "details",
        "name": "Request the outdoor guide",
        "kind": "input",
        "content": {
          "type": "panel",
          "children": [
            {
              "type": "eyebrow",
              "id": "n5",
              "text": "A LITTLE MORE OUTSIDE",
              "role": "eyebrow"
            },
            {
              "type": "heading",
              "id": "n6",
              "text": "Make space\nfor a slower day.",
              "role": "headline",
              "tokens": {
                "heading-font": "Georgia, serif",
                "heading-weight": "400",
                "heading-size": "2.25rem"
              }
            },
            {
              "type": "text",
              "id": "n7",
              "text": "Where should we send your guide request?",
              "role": "body"
            },
            {
              "type": "field",
              "id": "n8",
              "name": "email",
              "label": "Email address",
              "placeholder": "you@example.com",
              "required": true,
              "tokens": {
                "radius": ".75rem"
              }
            },
            {
              "type": "button",
              "id": "n9",
              "label": "Request the outdoor guide",
              "action": "submit",
              "role": "cta_label",
              "submission": "request",
              "tokens": {
                "radius": ".75rem"
              }
            },
            {
              "type": "button",
              "id": "n10",
              "label": "Back to the invitation",
              "action": "back",
              "role": "back_label",
              "tokens": {
                "accent": "transparent",
                "accent-fg": "fg",
                "radius": ".75rem"
              }
            },
            {
              "type": "text",
              "id": "n11",
              "text": "One guide request. No newsletter signup.",
              "role": "fine_print",
              "tokens": {
                "text-size": "1rem"
              },
              "size": "s"
            }
          ],
          "tokens": {
            "bg": "#e5edce",
            "pad": "1.25rem",
            "radius": "3rem 3rem .5rem .5rem"
          }
        }
      },
      {
        "id": "received",
        "name": "Request received",
        "kind": "acknowledgement",
        "content": {
          "type": "panel",
          "children": [
            {
              "type": "eyebrow",
              "id": "n12",
              "text": "REQUEST RECEIVED",
              "role": "eyebrow"
            },
            {
              "type": "heading",
              "id": "n13",
              "role": "success_headline",
              "text": "Your next chapter: outside.",
              "tokens": {
                "heading-size": "1.75rem"
              }
            },
            {
              "type": "divider",
              "id": "n14"
            },
            {
              "type": "text",
              "id": "n15",
              "role": "success_body",
              "text": "Your email has been recorded for the outdoor guide request."
            },
            {
              "type": "button",
              "id": "n16",
              "label": "Close",
              "action": "close",
              "role": "close_label",
              "tokens": {
                "accent": "transparent",
                "accent-fg": "fg",
                "radius": ".75rem"
              }
            }
          ],
          "tokens": {
            "pad": "1.75rem",
            "gap": "1rem",
            "bg": "#e5edce",
            "radius": "3rem 3rem .5rem .5rem"
          }
        }
      }
    ],
    "submissions": [
      {
        "id": "request",
        "required": true,
        "fields": [
          "n8"
        ],
        "consents": []
      }
    ]
  }
}
