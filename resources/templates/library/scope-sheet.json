{
  "id": "scope-sheet",
  "name": "Scope sheet",
  "display_type": "inline",
  "tier": "free",
  "tokens": {
    "bg": "#ffffff",
    "fg": "#25352e",
    "muted": "#53635a",
    "accent": "#2f5944",
    "accent-fg": "#ffffff",
    "border": "#7c8c82",
    "input-bg": "#ffffff",
    "heading-size": "1.875rem",
    "heading-weight": "600",
    "text-size": "1rem",
    "leading": "1.5",
    "pad": "1.5rem",
    "gap": "1rem",
    "radius": "0.75rem",
    "width": "54rem",
    "shadow": "none"
  },
  "tree": {
    "v": 2,
    "steps": [
      {
        "id": "details",
        "name": "Your details",
        "kind": "input",
        "content": {
          "type": "stack",
          "tokens": {
            "gap": "1rem"
          },
          "children": [
            {
              "type": "eyebrow",
              "id": "n12",
              "role": "eyebrow",
              "text": "A website review"
            },
            {
              "type": "heading",
              "id": "n13",
              "role": "headline",
              "text": "Know what you are asking for."
            },
            {
              "type": "split",
              "ratio": 0.5,
              "basis": "20rem",
              "tokens": {
                "gap": "2rem"
              },
              "start": [
                {
                  "type": "stack",
                  "tokens": {
                    "gap": "0.75rem"
                  },
                  "children": [
                    {
                      "type": "panel",
                      "tokens": {
                        "bg": "#edf2ef",
                        "pad": "1.25rem",
                        "gap": "0.5rem",
                        "radius": "0.375rem"
                      },
                      "children": [
                        {
                          "type": "eyebrow",
                          "id": "n1",
                          "role": "eyebrow",
                          "text": "What we review"
                        },
                        {
                          "type": "heading",
                          "id": "n2",
                          "role": "headline",
                          "text": "Clarity. Navigation. Next steps.",
                          "tokens": {
                            "heading-size": "1.125rem"
                          }
                        },
                        {
                          "type": "text",
                          "id": "n3",
                          "role": "body",
                          "text": "A focused look at the pages your customers use, with a written list of observations."
                        }
                      ]
                    },
                    {
                      "type": "panel",
                      "tokens": {
                        "bg": "#f5f2eb",
                        "pad": "1.25rem",
                        "gap": "0.5rem",
                        "radius": "0.375rem"
                      },
                      "children": [
                        {
                          "type": "eyebrow",
                          "id": "n4",
                          "role": "eyebrow",
                          "text": "Agreed separately"
                        },
                        {
                          "type": "heading",
                          "id": "n5",
                          "role": "headline",
                          "text": "Changes to the website.",
                          "tokens": {
                            "heading-size": "1.125rem"
                          }
                        },
                        {
                          "type": "text",
                          "id": "n6",
                          "role": "body",
                          "text": "Design, development and ongoing support are separate work, with their own scope and price."
                        }
                      ]
                    }
                  ]
                }
              ],
              "end": [
                {
                  "type": "stack",
                  "tokens": {
                    "gap": "1rem"
                  },
                  "children": [
                    {
                      "type": "heading",
                      "id": "n9",
                      "role": "headline",
                      "text": "Start with a conversation.",
                      "tokens": {
                        "heading-size": "1.375rem"
                      }
                    },
                    {
                      "type": "field",
                      "id": "n7",
                      "name": "email",
                      "label": "Email address",
                      "placeholder": "you@example.com",
                      "required": true
                    },
                    {
                      "type": "consent",
                      "id": "n8",
                      "role": "consent_text",
                      "text": "Use my email to discuss this website review.",
                      "hidden": true,
                      "tokens": {
                        "text-size": "1.125rem"
                      }
                    },
                    {
                      "type": "button",
                      "id": "n10",
                      "role": "cta_label",
                      "label": "Ask about the review",
                      "action": "submit",
                      "submission": "primary"
                    },
                    {
                      "type": "text",
                      "id": "n11",
                      "role": "fine_print",
                      "text": "We use your email to reply. Scope, price and timing are agreed before any work.",
                      "size": "s",
                      "tokens": {
                        "text-size": "1.167rem"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "id": "received",
        "name": "Request received",
        "kind": "acknowledgement",
        "content": {
          "type": "stack",
          "tokens": {
            "gap": "1rem"
          },
          "children": [
            {
              "type": "eyebrow",
              "id": "n14",
              "role": "eyebrow",
              "text": "Request received"
            },
            {
              "type": "heading",
              "id": "n15",
              "role": "success_headline",
              "text": "Your enquiry is received."
            },
            {
              "type": "text",
              "id": "n16",
              "role": "success_body",
              "text": "Thank you. The next conversation can confirm which pages to review, the price and timing. No work is booked."
            }
          ]
        }
      }
    ],
    "submissions": [
      {
        "id": "primary",
        "required": true,
        "fields": [
          "n7"
        ],
        "consents": [
          "n8"
        ]
      }
    ]
  }
}
