  "supports": {
    "html": false,
    "align": false,
    "color": false,
    "spacing": false,
    "typography": false,
    "customClassName": false,
    "anchor": false
  },
  "editorScript": "wconvert-inline-optin",
  "editorStyle": "wconvert-inline-optin"
}
